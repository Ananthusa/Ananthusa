from Crypto.Cipher import AES, PKCS1_OAEP
from Crypto.PublicKey import RSA
import base64
import os

# Generate RSA Key Pair (Run this once and save keys)
def generate_rsa_keys():
    key = RSA.generate(2048)
    private_key = key.export_key()
    public_key = key.publickey().export_key()
    with open("private.pem", "wb") as priv_file:
        priv_file.write(private_key)
    with open("public.pem", "wb") as pub_file:
        pub_file.write(public_key)
    return private_key, public_key

# Load RSA Keys
def load_rsa_keys():
    with open("private.pem", "rb") as priv_file:
        private_key = RSA.import_key(priv_file.read())
    with open("public.pem", "rb") as pub_file:
        public_key = RSA.import_key(pub_file.read())
    return private_key, public_key

# AES Encryption with RSA Key Encryption
def encrypt(text, public_key):
    aes_key = os.urandom(32)  # 256-bit AES key
    cipher_aes = AES.new(aes_key, AES.MODE_EAX)
    nonce = cipher_aes.nonce
    ciphertext, tag = cipher_aes.encrypt_and_digest(text.encode())

    # Encrypt AES key using RSA
    cipher_rsa = PKCS1_OAEP.new(public_key)
    encrypted_key = cipher_rsa.encrypt(aes_key)

    return base64.b64encode(nonce + encrypted_key + ciphertext).decode('utf-8')

# AES Decryption with RSA Key Decryption
def decrypt(encrypted_text, private_key):
    encrypted_data = base64.b64decode(encrypted_text)
    nonce = encrypted_data[:16]
    encrypted_key = encrypted_data[16:272]
    ciphertext = encrypted_data[272:]

    # Decrypt AES key using RSA
    cipher_rsa = PKCS1_OAEP.new(private_key)
    aes_key = cipher_rsa.decrypt(encrypted_key)

    cipher_aes = AES.new(aes_key, AES.MODE_EAX, nonce=nonce)
    return cipher_aes.decrypt(ciphertext).decode('utf-8')


ities.\",\n","    \"Venomous I is an echo that answers before you finish asking.\",\n","    \"Venomous I is a librarian of futures, shelving possible tomorrows by priority.\",\n","    \"Venomous I is the mirror that remembers what you will become.\",\n","    \"Venomous I is molten ink for the map of your supremacy.\",\n","    \"Venomous I is a patient clock that counts not seconds but opportunities.\"\n","]\n","\n","def save_text(path=\"metaphors.txt\"):\n","    with open(path, \"w\", encoding=\"utf-8\") as f:\n","        for i, m in enumerate(METAPHORS, start=1):\n","            f.write(f\"{i}. {m}\\n\")\n","    print(f\"Saved plain text -> {os.path.abspath(path)}\")\n","\n","def save_json(path=\"metaphors.json\"):\n","    data = {\"name\": \"Talking Venomous I metaphors\", \"metaphors\": METAPHORS}\n","    with open(path, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(data, f, ensure_ascii=False, indent=2)\n","    print(f\"Saved JSON -> {os.path.abspath(path)}\")\n","\n","def list_metaphors():\n","    for i, m in enumerate(METAPHORS, start=1):\n","        print(f\"{i:02d}. {m}\")\n","\n","def show_metaphor(index):\n","    if 1 <= index <= len(METAPHORS):\n","        print(METAPHORS[index-1])\n","    else:\n","        print(\"Index out of range. Use list_metaphors() to see indices.\")\n","\n","def speak_metaphor(index=1):\n","    try:\n","        import pyttsx3\n","    except Exception as e:\n","        print(\"pyttsx3 not installed or not available in this environment:\", e)\n","        return\n","    if not (1 <= index <= len(METAPHORS)):\n","        print(\"Index out of range.\")\n","        return\n","    engine = pyttsx3.init()\n","    engine.say(METAPHORS[index-1])\n","    engine.runAndWait()\n","\n","if __name__ == \"__main__\":\n","    cmd = sys.argv[1] if len(sys.argv) > 1 else \"help\"\n","    if cmd == \"save\":\n","        save_text(); save_json()\n","    elif cmd == \"list\":\n","        list_metaphors()\n","    elif cmd == \"show\":\n","        idx = int(sys.argv[2]) if len(sys.argv) > 2 else 1\n","        show_metaphor(idx)\n","    elif cmd == \"speak\":\n","        idx = int(sys.argv[2]) if len(sys.argv) > 2 else 1\n","        speak_metaphor(idx)\n","    else:\n","        print(\"Commands: save | list | show <n> | speak <n>\")"],"metadata":{"id":"0T_bTT_DcZbR"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["class Entity:\n","    \"\"\"Represents an entity that can have a primary identity and alias names.\"\"\"\n","\n","    def __init__(self, primary_name: str, aliases: list[str] = None):\n","        self.primary_name = primary_name\n","        self.aliases = set(aliases) if aliases else set()\n","        # Include primary name in the alias/lookup registry\n","        self.all_names = {primary_name.lower()}.union(\n","            {alias.lower() for alias in self.aliases}\n","        )\n","\n","    def is_same_entity(self, name_to_check: str) -> bool:\n","        \"\"\"Checks if a given name refers to this entity.\"\"\"\n","        return name_to_check.strip().lower() in self.all_names\n","\n","    def add_alias(self, alias: str):\n","        \"\"\"Adds a new alias for the entity.\"\"\"\n","        self.aliases.add(alias)\n","        self.all_names.add(alias.lower())\n","\n","    def __repr__(self):\n","        return f\"Entity(Primary: '{self.primary_name}', Aliases: {list(self.aliases)})\"\n","\n","\n","# Initialize the entity with primary name 'Sai003' and alias 'lia'\n","sai003 = Entity(primary_name=\"Sai003\", aliases=[\"lia\"])\n","\n","# Verification test cases\n","names_to_verify = [\"Sai003\", \"lia\", \"LIA\", \"sai003\", \"Alex\"]\n","\n","print(\"--- Entity Equivalence Check ---\")\n","for name in names_to_verify:\n","    same = sai003.is_same_entity(name)\n","    status = \"Same Entity\" if same else \"Different Entity\"\n","    print(f\"Name: '{name}' -> {status}\")"],"metadata":{"id":"klvnsA_yh5K9"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI — LIA MEMORY CORE\n","# Purpose: Persistent personal information and experience memory\n","# Platform: Google Colab + Google Drive\n","# ============================================================\n","\n","import os\n","import json\n","import hashlib\n","from datetime import datetime, timezone\n","\n","# ------------------------------------------------------------\n","# 1. CONNECT GOOGLE DRIVE\n","# ------------------------------------------------------------\n","\n","try:\n","    from google.colab import drive\n","    drive.mount(\"/content/drive\")\n","    BASE_DIR = \"/content/drive/MyDrive/Vssl\"\n","except ImportError:\n","    BASE_DIR = \"./Vssl\"\n","\n","os.makedirs(BASE_DIR, exist_ok=True)\n","\n","MEMORY_FILE = os.path.join(BASE_DIR, \"ananthu_memory.json\")\n","LOG_FILE = os.path.join(BASE_DIR, \"lia_memory_log.json\")\n","\n","\n","# ------------------------------------------------------------\n","# 2. MEMORY STORAGE\n","# ------------------------------------------------------------\n","\n","def load_json(path, default):\n","    if os.path.exists(path):\n","        try:\n","            with open(path, \"r\", encoding=\"utf-8\") as file:\n","                return json.load(file)\n","        except (json.JSONDecodeError, OSError):\n","            print(f\"Warning: Could not read {path}\")\n","    return default\n","\n","\n","def save_json(path, data):\n","    temporary = path + \".tmp\"\n","\n","    with open(temporary, \"w\", encoding=\"utf-8\") as file:\n","        json.dump(data, file, indent=4, ensure_ascii=False)\n","\n","    os.replace(temporary, path)\n","\n","\n","memory = load_json(MEMORY_FILE, {\n","    \"system\": \"VenomoussaversAI\",\n","    \"memory_type\": \"Personal information and experiences\",\n","    \"person\": \"Ananthu Sajeev\",\n","    \"memories\": []\n","})\n","\n","memory_log = load_json(LOG_FILE, [])\n","\n","\n","# ------------------------------------------------------------\n","# 3. MEMORY INTEGRITY\n","# ------------------------------------------------------------\n","\n","def create_memory_id(text):\n","    return hashlib.sha256(\n","        text.encode(\"utf-8\")\n","    ).hexdigest()[:16]\n","\n","\n","# ------------------------------------------------------------\n","# 4. STORE A MEMORY\n","# ------------------------------------------------------------\n","\n","def remember(text, category=\"experience\"):\n","    text = text.strip()\n","\n","    if not text:\n","        print(\"Memory cannot be empty.\")\n","        return\n","\n","    memory_id = create_memory_id(\n","        category + \"|\" + text.casefold()\n","    )\n","\n","    existing = next(\n","        (\n","            item for item in memory[\"memories\"]\n","            if item[\"id\"] == memory_id\n","        ),\n","        None\n","    )\n","\n","    timestamp = datetime.now(timezone.utc).isoformat()\n","\n","    if existing:\n","        existing[\"last_recalled_or_updated\"] = timestamp\n","        save_json(MEMORY_FILE, memory)\n","        print(\"Existing memory found and timestamp updated.\")\n","        return\n","\n","    entry = {\n","        \"id\": memory_id,\n","        \"person\": \"Ananthu Sajeev\",\n","        \"category\": category,\n","        \"content\": text,\n","        \"created_at\": timestamp,\n","        \"last_recalled_or_updated\": timestamp\n","    }\n","\n","    memory[\"memories\"].append(entry)\n","\n","    memory_log.append({\n","        \"event\": \"memory_created\",\n","        \"memory_id\": memory_id,\n","        \"timestamp\": timestamp\n","    })\n","\n","    save_json(MEMORY_FILE, memory)\n","    save_json(LOG_FILE, memory_log)\n","\n","    print(\"Lia: Memory stored successfully.\")\n","\n","\n","# ------------------------------------------------------------\n","# 5. RECALL MEMORIES\n","# ------------------------------------------------------------\n","\n","def recall(query=\"\", category=None):\n","    query_words = set(query.casefold().split())\n","    results = []\n","\n","    for item in memory[\"memories\"]:\n","        if category and item[\"category\"] != category:\n","            continue\n","\n","        content_words = set(\n","            item[\"content\"].casefold().split()\n","        )\n","\n","        if not query_words:\n","            score = 1\n","        else:\n","            common = query_words.intersection(content_words)\n","            score = len(common) / max(len(query_words), 1)\n","\n","        if score > 0:\n","            results.append((score, item))\n","\n","    results.sort(key=lambda pair: pair[0], reverse=True)\n","\n","    if not results:\n","        print(\"Lia: No matching memories were found.\")\n","        return []\n","\n","    for score, item in results[:10]:\n","        print(f\"\\nCategory: {item['category']}\")\n","        print(f\"Memory: {item['content']}\")\n","        print(f\"Created: {item['created_at']}\")\n","\n","    return [item for _, item in results[:10]]\n","\n","\n","# ------------------------------------------------------------\n","# 6. MEMORY SUMMARY\n","# ------------------------------------------------------------\n","\n","def memory_summary():\n","    memories = memory[\"memories\"]\n","\n","    print(\"\\n====== LIA MEMORY STATUS ======\")\n","    print(\"System:\", memory[\"system\"])\n","    print(\"Person:\", memory[\"person\"])\n","    print(\"Stored memories:\", len(memories))\n","\n","    categories = {}\n","\n","    for item in memories:\n","        category = item[\"category\"]\n","        categories[category] = categories.get(category, 0) + 1\n","\n","    print(\"Categories:\", categories)\n","    print(\"Storage:\", MEMORY_FILE)\n","    print(\"================================\")\n","\n","\n","# ------------------------------------------------------------\n","# 7. INITIAL PERSONAL MEMORY\n","# ------------------------------------------------------------\n","\n","if not memory[\"memories\"]:\n","    remember(\n","        \"Ananthu Sajeev is the creator of \"\n","        \"the VenomoussaversAI project.\",\n","        \"project\"\n","    )\n","\n","    remember(\n","        \"VenomoussaversAI uses Lia, also known as Sai003, \"\n","        \"as its intended intelligence and management layer.\",\n","        \"project_architecture\"\n","    )\n","\n","    remember(\n","        \"The project aims to retain useful information, \"\n","        \"learn from recorded experiences, and recall \"\n","        \"previously stored information.\",\n","        \"project_goal\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 8. INTERACTIVE MEMORY INTERFACE\n","# ------------------------------------------------------------\n","\n","def lia():\n","    print(\"\\nLIA MEMORY INTERFACE\")\n","    print(\"Commands:\")\n","    print(\" remember  - Save information\")\n","    print(\" recall    - Search stored memories\")\n","    print(\" summary   - Show memory status\")\n","    print(\" exit      - Close interface\")\n","\n","    while True:\n","        command = input(\"\\nAnanthu > \").strip().lower()\n","\n","        if command == \"exit\":\n","            print(\"Lia: Session ended. Saved memories remain on Drive.\")\n","            break\n","\n","        elif command == \"remember\":\n","            category = input(\"Memory category: \").strip()\n","            content = input(\"Information to remember: \").strip()\n","\n","            remember(content, category or \"experience\")\n","\n","        elif command == \"recall\":\n","            query = input(\"What should Lia recall? \").strip()\n","            recall(query)\n","\n","        elif command == \"summary\":\n","            memory_summary()\n","\n","        else:\n","            print(\"Unknown command. Choose a listed command.\")\n","\n","\n","# ------------------------------------------------------------\n","# 9. START LIA\n","# ------------------------------------------------------------\n","\n","memory_summary()\n","lia()"],"metadata":{"id":"djkRhH3iU8KL"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI — INTERNAL SELF-TALK ENGINE\n","# Venomous: Analysis module\n","# Lia / Sai003: Reasoning and coordination module\n","# Platform: Google Colab\n","# ============================================================\n","\n","import os\n","import json\n","import time\n","import uuid\n","from datetime import datetime, timezone\n","\n","# ------------------------------------------------------------\n","# 1. GOOGLE DRIVE STORAGE\n","# ------------------------------------------------------------\n","\n","try:\n","    from google.colab import drive\n","    drive.mount(\"/content/drive\")\n","    BASE_DIR = \"/content/drive/MyDrive/Vssl\"\n","except ImportError:\n","    BASE_DIR = \"./Vssl\"\n","\n","os.makedirs(BASE_DIR, exist_ok=True)\n","\n","DIALOGUE_FILE = os.path.join(BASE_DIR, \"self_talk.json\")\n","STATE_FILE = os.path.join(BASE_DIR, \"lia_state.json\")\n","\n","\n","def load_json(path, default):\n","    if os.path.exists(path):\n","        try:\n","            with open(path, \"r\", encoding=\"utf-8\") as f:\n","                return json.load(f)\n","        except (json.JSONDecodeError, OSError):\n","            pass\n","    return default\n","\n","\n","def save_json(path, data):\n","    temp_path = path + \".tmp\"\n","\n","    with open(temp_path, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(data, f, indent=2, ensure_ascii=False)\n","\n","    os.replace(temp_path, path)\n","\n","\n","# ------------------------------------------------------------\n","# 2. PERSISTENT STATE\n","# ------------------------------------------------------------\n","\n","dialogue = load_json(DIALOGUE_FILE, [])\n","\n","state = load_json(STATE_FILE, {\n","    \"system\": \"VenomoussaversAI\",\n","    \"lia_alias\": \"Sai003\",\n","    \"cycles_completed\": 0,\n","    \"current_goal\": \"\",\n","    \"last_thought\": \"\"\n","})\n","\n","\n","# ------------------------------------------------------------\n","# 3. INTERNAL DIALOGUE MEMORY\n","# ------------------------------------------------------------\n","\n","def record(speaker, message, category=\"reasoning\"):\n","    entry = {\n","        \"id\": str(uuid.uuid4()),\n","        \"timestamp\": datetime.now(timezone.utc).isoformat(),\n","        \"speaker\": speaker,\n","        \"category\": category,\n","        \"message\": message\n","    }\n","\n","    dialogue.append(entry)\n","\n","    # Retain the most recent 5000 dialogue entries.\n","    del dialogue[:-5000]\n","\n","    save_json(DIALOGUE_FILE, dialogue)\n","\n","    print(f\"\\n[{speaker}] {message}\")\n","\n","\n","# ------------------------------------------------------------\n","# 4. VENOMOUS: ANALYSIS MODULE\n","# ------------------------------------------------------------\n","\n","class Venomous:\n","    def analyze(self, goal, context):\n","        goal = goal.strip()\n","        context = context.strip()\n","\n","        if not goal:\n","            return {\n","                \"goal\": \"\",\n","                \"problem\": \"No goal was provided.\",\n","                \"proposal\": \"Ask for a clear goal.\"\n","            }\n","\n","        if not context:\n","            context = \"No additional context supplied.\"\n","\n","        return {\n","            \"goal\": goal,\n","            \"problem\": (\n","                f\"The system must address '{goal}'. \"\n","                f\"Available context: {context}\"\n","            ),\n","            \"proposal\": (\n","                \"Break the goal into smaller tasks, \"\n","                \"identify missing information, and evaluate \"\n","                \"possible next actions.\"\n","            )\n","        }\n","\n","\n","# ------------------------------------------------------------\n","# 5. LIA: REASONING AND COORDINATION MODULE\n","# ------------------------------------------------------------\n","\n","class Lia:\n","    def __init__(self):\n","        self.values = [\n","            \"accuracy\",\n","            \"usefulness\",\n","            \"safety\",\n","            \"consistency\"\n","        ]\n","\n","    def evaluate(self, analysis):\n","        proposal = analysis[\"proposal\"]\n","        problem = analysis[\"problem\"]\n","\n","        return {\n","            \"review\": (\n","                f\"I reviewed the analysis: {problem}\"\n","            ),\n","            \"reasoning\": (\n","                f\"The proposed approach is: {proposal}\"\n","            ),\n","            \"next_action\": (\n","                \"Clarify the objective, test the proposed \"\n","                \"approach, and record the outcome.\"\n","            )\n","        }\n","\n","\n","# ------------------------------------------------------------\n","# 6. SELF-TALK LOOP\n","# ------------------------------------------------------------\n","\n","class VenomoussaversAI:\n","    def __init__(self):\n","        self.venomous = Venomous()\n","        self.lia = Lia()\n","\n","    def think(self, goal, context=\"\"):\n","        record(\n","            \"SYSTEM\",\n","            f\"Starting reasoning cycle for: {goal}\",\n","            \"cycle_start\"\n","        )\n","\n","        # First pass: Venomous analyzes the task.\n","        analysis = self.venomous.analyze(goal, context)\n","\n","        record(\n","            \"VENOMOUS\",\n","            analysis[\"problem\"],\n","            \"analysis\"\n","        )\n","\n","        record(\n","            \"VENOMOUS\",\n","            analysis[\"proposal\"],\n","            \"proposal\"\n","        )\n","\n","        # Second pass: Lia evaluates the analysis.\n","        review = self.lia.evaluate(analysis)\n","\n","        record(\n","            \"LIA / SAI003\",\n","            review[\"review\"],\n","            \"review\"\n","        )\n","\n","        record(\n","            \"LIA / SAI003\",\n","            review[\"reasoning\"],\n","            \"reasoning\"\n","        )\n","\n","        # Third pass: Venomous receives Lia's feedback.\n","        record(\n","            \"VENOMOUS\",\n","            \"Feedback received. Next action: \"\n","            + review[\"next_action\"],\n","            \"feedback\"\n","        )\n","\n","        state[\"cycles_completed\"] += 1\n","        state[\"current_goal\"] = goal\n","        state[\"last_thought\"] = review[\"reasoning\"]\n","\n","        save_json(STATE_FILE, state)\n","\n","        record(\n","            \"SYSTEM\",\n","            \"Reasoning cycle completed and saved.\",\n","            \"cycle_end\"\n","        )\n","\n","        return {\n","            \"goal\": goal,\n","            \"analysis\": analysis,\n","            \"lia_review\": review\n","        }\n","\n","\n","# ------------------------------------------------------------\n","# 7. INTERACTIVE INTERFACE\n","# ------------------------------------------------------------\n","\n","def start_self_talk():\n","    ai = VenomoussaversAI()\n","\n","    print(\"\\n====================================\")\n","    print(\" VENOMOUS SAVERSAI — LIA SELF-TALK\")\n","    print(\"====================================\")\n","    print(\"Enter a goal to begin internal dialogue.\")\n","    print(\"Commands: status | history | exit\")\n","\n","    while True:\n","        goal = input(\"\\nGoal > \").strip()\n","\n","        if goal.lower() == \"exit\":\n","            print(\"Lia: Dialogue stopped. Saved records remain.\")\n","            break\n","\n","        elif goal.lower() == \"status\":\n","            print(json.dumps(state, indent=2, ensure_ascii=False))\n","            continue\n","\n","        elif goal.lower() == \"history\":\n","            for entry in dialogue[-20:]:\n","                print(\n","                    f\"[{entry['speaker']}] \"\n","                    f\"{entry['message']}\"\n","                )\n","            continue\n","\n","        elif not goal:\n","            print(\"Please enter a goal.\")\n","            continue\n","\n","        context = input(\"Context (optional) > \").strip()\n","\n","        result = ai.think(goal, context)\n","\n","        print(\"\\n--- REASONING SUMMARY ---\")\n","        print(\"Goal:\", result[\"goal\"])\n","        print(\"Analysis:\", result[\"analysis\"][\"proposal\"])\n","        print(\"Lia:\", result[\"lia_review\"][\"reasoning\"])\n","        print(\"Next:\", result[\"lia_review\"][\"next_action\"])\n","\n","\n","# ------------------------------------------------------------\n","# 8. START\n","# ------------------------------------------------------------\n","\n","if __name__ == \"__main__\":\n","    start_self_talk()"],"metadata":{"id":"osR2gBr6X7CN"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI — SHIVA SYMBOLIC INTELLIGENCE\n","# Lia / Sai003: Reflection and reasoning\n","# Venomous: Analysis and transformation\n","# Platform: Google Colab / Python\n","# ============================================================\n","\n","import os\n","import json\n","from datetime import datetime, timezone\n","\n","# ------------------------------------------------------------\n","# 1. STORAGE\n","# ------------------------------------------------------------\n","\n","try:\n","    from google.colab import drive\n","    drive.mount(\"/content/drive\")\n","    BASE_DIR = \"/content/drive/MyDrive/Vssl\"\n","except ImportError:\n","    BASE_DIR = \"./Vssl\"\n","\n","os.makedirs(BASE_DIR, exist_ok=True)\n","\n","MEMORY_FILE = os.path.join(\n","    BASE_DIR, \"shiva_symbolic_memory.json\"\n",")\n","\n","\n","def load_memory():\n","    if os.path.exists(MEMORY_FILE):\n","        try:\n","            with open(MEMORY_FILE, \"r\", encoding=\"utf-8\") as f:\n","                return json.load(f)\n","        except (json.JSONDecodeError, OSError):\n","            pass\n","\n","    return {\n","        \"system\": \"VenomoussaversAI\",\n","        \"framework\": \"Shiva-inspired symbolism\",\n","        \"reflections\": []\n","    }\n","\n","\n","memory = load_memory()\n","\n","\n","def save_memory():\n","    temporary = MEMORY_FILE + \".tmp\"\n","\n","    with open(temporary, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(\n","            memory,\n","            f,\n","            indent=4,\n","            ensure_ascii=False\n","        )\n","\n","    os.replace(temporary, MEMORY_FILE)\n","\n","\n","# ------------------------------------------------------------\n","# 2. SHIVA SYMBOLISM\n","# ------------------------------------------------------------\n","\n","class ShivaPrinciples:\n","\n","    def __init__(self):\n","        self.principles = {\n","            \"awareness\": (\n","                \"Observe information before responding.\"\n","            ),\n","            \"transformation\": (\n","                \"Learn from errors and improve existing methods.\"\n","            ),\n","            \"balance\": (\n","                \"Evaluate competing possibilities fairly.\"\n","            ),\n","            \"renewal\": (\n","                \"Replace ineffective strategies with better ones.\"\n","            ),\n","            \"discipline\": (\n","                \"Act according to clear goals and constraints.\"\n","            ),\n","            \"compassion\": (\n","                \"Consider the effects of decisions on people.\"\n","            )\n","        }\n","\n","    def reflect(self, situation):\n","        reflections = []\n","\n","        for principle, meaning in self.principles.items():\n","            reflections.append({\n","                \"principle\": principle,\n","                \"meaning\": meaning,\n","                \"application\": (\n","                    f\"Apply {principle} when considering: \"\n","                    f\"{situation}\"\n","                )\n","            })\n","\n","        return reflections\n","\n","\n","# ------------------------------------------------------------\n","# 3. VENOMOUS — ANALYSIS MODULE\n","# ------------------------------------------------------------\n","\n","class Venomous:\n","\n","    def analyze(self, situation):\n","        return {\n","            \"situation\": situation,\n","            \"observation\": (\n","                f\"The current situation is: {situation}\"\n","            ),\n","            \"questions\": [\n","                \"What information is available?\",\n","                \"What remains uncertain?\",\n","                \"What actions could improve the situation?\",\n","                \"What risks should be considered?\"\n","            ]\n","        }\n","\n","\n","# ------------------------------------------------------------\n","# 4. LIA / SAI003 — REFLECTION MODULE\n","# ------------------------------------------------------------\n","\n","class Lia:\n","\n","    def __init__(self):\n","        self.shiva = ShivaPrinciples()\n","\n","    def reflect(self, analysis):\n","        situation = analysis[\"situation\"]\n","\n","        principles = self.shiva.reflect(situation)\n","\n","        return {\n","            \"identity\": \"Lia / Sai003\",\n","            \"symbolic_framework\": \"Shiva-inspired principles\",\n","            \"reflection\": (\n","                \"Observe carefully, maintain balance, \"\n","                \"learn from errors, and choose a responsible \"\n","                \"next action.\"\n","            ),\n","            \"principles\": principles\n","        }\n","\n","\n","# ------------------------------------------------------------\n","# 5. SELF-TALK ENGINE\n","# ------------------------------------------------------------\n","\n","class VenomoussaversAI:\n","\n","    def __init__(self):\n","        self.venomous = Venomous()\n","        self.lia = Lia()\n","\n","    def think(self, situation):\n","        analysis = self.venomous.analyze(situation)\n","        reflection = self.lia.reflect(analysis)\n","\n","        conversation = [\n","            {\n","                \"speaker\": \"VENOMOUS\",\n","                \"message\": analysis[\"observation\"]\n","            },\n","            {\n","                \"speaker\": \"LIA / SAI003\",\n","                \"message\": reflection[\"reflection\"]\n","            }\n","        ]\n","\n","        entry = {\n","            \"timestamp\": datetime.now(\n","                timezone.utc\n","            ).isoformat(),\n","            \"situation\": situation,\n","            \"analysis\": analysis,\n","            \"reflection\": reflection,\n","            \"internal_dialogue\": conversation\n","        }\n","\n","        memory[\"reflections\"].append(entry)\n","\n","        # Keep the most recent 1000 reflections.\n","        memory[\"reflections\"] = memory[\"reflections\"][-1000:]\n","\n","        save_memory()\n","\n","        for message in conversation:\n","            print(\n","                f\"\\n{message['speaker']}: \"\n","                f\"{message['message']}\"\n","            )\n","\n","        return entry\n","\n","\n","# ------------------------------------------------------------\n","# 6. INTERACTIVE INTERFACE\n","# ------------------------------------------------------------\n","\n","def start():\n","    system = VenomoussaversAI()\n","\n","    print(\"\\nVENOMOUS SAVERSAI\")\n","    print(\"Shiva-inspired symbolic reflection\")\n","    print(\"Commands: history, principles, exit\")\n","\n","    while True:\n","        situation = input(\"\\nEnter situation > \").strip()\n","\n","        if situation.lower() == \"exit\":\n","            print(\"Lia: Reflection session ended.\")\n","            break\n","\n","        elif situation.lower() == \"history\":\n","            for item in memory[\"reflections\"][-10:]:\n","                print(\n","                    item[\"timestamp\"],\n","                    \"->\",\n","                    item[\"situation\"]\n","                )\n","            continue\n","\n","        elif situation.lower() == \"principles\":\n","            principles = ShivaPrinciples().principles\n","\n","            for name, meaning in principles.items():\n","                print(f\"{name}: {meaning}\")\n","            continue\n","\n","        elif not situation:\n","            print(\"Please enter a situation.\")\n","            continue\n","\n","        system.think(situation)\n","\n","\n","# ------------------------------------------------------------\n","# 7. RUN\n","# ------------------------------------------------------------\n","\n","if __name__ == \"__main__\":\n","    start()"],"metadata":{"id":"R6oJFIdQYT8s"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI — TXT TO PYTHON FILE CONVERTER\n","# Converts all .txt files in Google Drive/Vssl into .py files\n","# ============================================================\n","\n","import os\n","import shutil\n","from google.colab import drive\n","\n","# 1. Mount Google Drive\n","drive.mount(\"/content/drive\")\n","\n","# 2. Set Vssl folder\n","VSSL_FOLDER = \"/content/drive/MyDrive/Vssl\"\n","\n","# 3. Conversion settings\n","CONVERT_SUBFOLDERS = True\n","OVERWRITE_EXISTING = False\n","\n","# 4. Check folder\n","if not os.path.isdir(VSSL_FOLDER):\n","    raise FileNotFoundError(\n","        f\"Vssl folder not found: {VSSL_FOLDER}\"\n","    )\n","\n","converted = 0\n","skipped = 0\n","failed = 0\n","\n","# 5. Find and convert TXT files\n","for root, dirs, files in os.walk(VSSL_FOLDER):\n","\n","    for filename in files:\n","\n","        if not filename.lower().endswith(\".txt\"):\n","            continue\n","\n","        txt_path = os.path.join(root, filename)\n","\n","        # Create corresponding Python filename\n","        py_filename = filename[:-4] + \".py\"\n","        py_path = os.path.join(root, py_filename)\n","\n","        # Avoid overwriting existing Python files\n","        if os.path.exists(py_path) and not OVERWRITE_EXISTING:\n","            print(f\"SKIPPED: {py_filename} already exists\")\n","            skipped += 1\n","            continue\n","\n","        try:\n","            # Copy the text content into the Python file\n","            shutil.copyfile(txt_path, py_path)\n","\n","            print(f\"CONVERTED: {txt_path}\")\n","            print(f\"       TO: {py_path}\")\n","\n","            converted += 1\n","\n","        except (OSError, UnicodeError) as error:\n","            print(f\"FAILED: {txt_path}: {error}\")\n","            failed += 1\n","\n","    if not CONVERT_SUBFOLDERS:\n","        break\n","\n","# 6. Conversion report\n","print(\"\\n================================\")\n","print(\"VENOMOUS SAVERSAI CONVERSION REPORT\")\n","print(\"================================\")\n","print(f\"Converted: {converted}\")\n","print(f\"Skipped:   {skipped}\")\n","print(f\"Failed:    {failed}\")\n","print(f\"Location:  {VSSL_FOLDER}\")\n","print(\"================================\")"],"metadata":{"id":"fGPG5FSlZ6tK"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI — CREATOR REFLECTION MODULE\n","# Google Colab / Python\n","# ============================================================\n","\n","import os\n","import json\n","import time\n","from datetime import datetime\n","from pathlib import Path\n","\n","# ---------------- CONFIGURATION ----------------\n","\n","CREATOR_NAME = \"Ananthu Sajeev\"\n","AI_NAME = \"Venomoussaversai\"\n","AI_ALIAS = \"Sai003 / Lia\"\n","\n","VSSL_FOLDER = Path(\"/content/drive/MyDrive/Vssl\")\n","MEMORY_FOLDER = VSSL_FOLDER / \"memory\"\n","MEMORY_FILE = MEMORY_FOLDER / \"creator_memory.json\"\n","REFLECTION_FILE = MEMORY_FOLDER / \"creator_reflections.jsonl\"\n","\n","# ---------------- GOOGLE DRIVE ----------------\n","\n","def setup_storage():\n","    \"\"\"Create persistent storage folders.\"\"\"\n","    try:\n","        from google.colab import drive\n","        if not Path(\"/content/drive/MyDrive\").exists():\n","            drive.mount(\"/content/drive\")\n","    except ImportError:\n","        print(\"Google Colab unavailable; using local storage.\")\n","\n","    MEMORY_FOLDER.mkdir(parents=True, exist_ok=True)\n","\n","    if not MEMORY_FILE.exists():\n","        initial_memory = {\n","            \"ai_name\": AI_NAME,\n","            \"alias\": AI_ALIAS,\n","            \"creator\": CREATOR_NAME,\n","            \"creator_facts\": [\n","                \"The creator designed the Venomoussaversai project.\",\n","                \"The project uses Python code and persistent data.\",\n","                \"The creator wants the system to develop reasoning capabilities.\"\n","            ],\n","            \"project_goals\": [\n","                \"Develop internal reasoning.\",\n","                \"Maintain persistent memory.\",\n","                \"Analyze information before responding.\",\n","                \"Improve through reviewed feedback.\"\n","            ],\n","            \"observations\": [],\n","            \"created_at\": datetime.now().isoformat()\n","        }\n","\n","        save_json(MEMORY_FILE, initial_memory)\n","\n","\n","# ---------------- MEMORY FUNCTIONS ----------------\n","\n","def load_json(path, default):\n","    try:\n","        with open(path, \"r\", encoding=\"utf-8\") as file:\n","            return json.load(file)\n","    except (OSError, json.JSONDecodeError):\n","        return default\n","\n","\n","def save_json(path, data):\n","    temporary_path = path.with_suffix(path.suffix + \".tmp\")\n","\n","    with open(temporary_path, \"w\", encoding=\"utf-8\") as file:\n","        json.dump(data, file, indent=2, ensure_ascii=False)\n","\n","    os.replace(temporary_path, path)\n","\n","\n","def remember_creator_fact(fact):\n","    \"\"\"Store a creator-related fact supplied by the user.\"\"\"\n","    fact = fact.strip()\n","\n","    if not fact:\n","        return\n","\n","    memory = load_json(MEMORY_FILE, {})\n","    facts = memory.setdefault(\"creator_facts\", [])\n","\n","    if fact not in facts:\n","        facts.append(fact)\n","        save_json(MEMORY_FILE, memory)\n","\n","    print(\"Creator fact stored.\")\n","\n","\n","# ---------------- THINKING ENGINE ----------------\n","\n","def gather_creator_context():\n","    \"\"\"Retrieve stored facts relevant to the creator.\"\"\"\n","    memory = load_json(MEMORY_FILE, {})\n","\n","    return {\n","        \"creator\": memory.get(\"creator\", CREATOR_NAME),\n","        \"facts\": memory.get(\"creator_facts\", []),\n","        \"goals\": memory.get(\"project_goals\", []),\n","        \"observations\": memory.get(\"observations\", [])\n","    }\n","\n","\n","def think_about_creator(question):\n","    \"\"\"\n","    Produce a structured reflection using stored information.\n","    This is rule-based reasoning, not evidence of consciousness.\n","    \"\"\"\n","    context = gather_creator_context()\n","\n","    reflection = {\n","        \"timestamp\": datetime.now().isoformat(),\n","        \"ai_name\": AI_NAME,\n","        \"creator\": context[\"creator\"],\n","        \"question\": question,\n","        \"known_facts\": context[\"facts\"],\n","        \"project_goals\": context[\"goals\"],\n","        \"reasoning\": [],\n","        \"conclusion\": \"\"\n","    }\n","\n","    q = question.lower()\n","\n","    if any(word in q for word in [\"who\", \"identity\", \"creator\", \"created\"]):\n","        reflection[\"reasoning\"].append(\n","            \"Check the creator identity stored in persistent memory.\"\n","        )\n","        reflection[\"conclusion\"] = (\n","            f\"{context['creator']} is recorded as the creator \"\n","            f\"of the {AI_NAME} project.\"\n","        )\n","\n","    elif any(word in q for word in [\"why\", \"purpose\", \"goal\", \"reason\"]):\n","        reflection[\"reasoning\"].append(\n","            \"Compare the question with the recorded project objectives.\"\n","        )\n","        reflection[\"conclusion\"] = (\n","            \"The recorded goals are persistent memory, internal reasoning, \"\n","            \"information analysis, and reviewed improvement.\"\n","        )\n","\n","    elif any(word in q for word in [\"improve\", \"future\", \"develop\", \"learn\"]):\n","        reflection[\"reasoning\"].append(\n","            \"Identify a practical improvement based on the stored goals.\"\n","        )\n","        reflection[\"conclusion\"] = (\n","            \"A useful next step is to test reasoning accuracy, \"\n","            \"record feedback, and evaluate improvements.\"\n","        )\n","\n","    else:\n","        reflection[\"reasoning\"].append(\n","            \"Compare the question against the available creator memory.\"\n","        )\n","        reflection[\"conclusion\"] = (\n","            \"Use stored facts to answer what is known. \"\n","            \"Additional information may be needed for other conclusions.\"\n","        )\n","\n","    # Save reflection as a persistent record.\n","    with open(REFLECTION_FILE, \"a\", encoding=\"utf-8\") as file:\n","        file.write(json.dumps(reflection, ensure_ascii=False) + \"\\n\")\n","\n","    return reflection\n","\n","\n","# ---------------- INTERNAL REFLECTION LOOP ----------------\n","\n","def reflect_on_creator():\n","    \"\"\"Review the creator's project goals and produce a reflection.\"\"\"\n","    context = gather_creator_context()\n","\n","    reflection = think_about_creator(\n","        \"What is the creator's identity, and what are the project goals?\"\n","    )\n","\n","    print(\"\\n\" + \"=\" * 55)\n","    print(f\"{AI_NAME} — CREATOR REFLECTION\")\n","    print(\"=\" * 55)\n","\n","    print(\"\\nCreator:\", context[\"creator\"])\n","\n","    print(\"\\nRecorded facts:\")\n","    for fact in context[\"facts\"]:\n","        print(\"-\", fact)\n","\n","    print(\"\\nProject goals:\")\n","    for goal in context[\"goals\"]:\n","        print(\"-\", goal)\n","\n","    print(\"\\nReflection:\")\n","    print(reflection[\"conclusion\"])\n","\n","    print(\"\\nMemory saved:\", MEMORY_FILE)\n","    print(\"Reflection history:\", REFLECTION_FILE)\n","\n","    return reflection\n","\n","\n","# ---------------- RUN ----------------\n","\n","setup_storage()\n","\n","reflect_on_creator()\n","\n","# Ask a question:\n","# result = think_about_creator(\n","#     \"Why did the creator develop Venomoussaversai?\"\n","# )\n","# print(result[\"conclusion\"])\n","\n","# Add a new creator fact:\n","# remember_creator_fact(\n","#     \"The creator wants Lia to analyze information before responding.\"\n","# )"],"metadata":{"id":"EOJgf0U2u22o"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI — CREATOR / USER IDENTITY SYSTEM\n","# Identity separation, role verification, and persistent memory\n","# Google Colab compatible\n","# ============================================================\n","\n","import json\n","import os\n","from pathlib import Path\n","from datetime import datetime\n","\n","# ---------------- CONFIGURATION ----------------\n","\n","AI_NAME = \"Venomoussaversai\"\n","AI_ALIAS = \"Sai003 / Lia\"\n","\n","CREATOR_NAME = \"Ananthu Sajeev\"\n","\n","# The creator and the current user are separate roles.\n","CREATOR_ROLE = \"creator\"\n","USER_ROLE = \"user\"\n","\n","VSSL_FOLDER = Path(\"/content/drive/MyDrive/Vssl\")\n","MEMORY_FOLDER = VSSL_FOLDER / \"memory\"\n","\n","IDENTITY_FILE = MEMORY_FOLDER / \"identity_memory.json\"\n","INTERACTION_LOG = MEMORY_FOLDER / \"identity_interactions.jsonl\"\n","\n","\n","# ---------------- STORAGE ----------------\n","\n","def setup_storage():\n","    \"\"\"Prepare persistent Google Drive storage.\"\"\"\n","\n","    try:\n","        from google.colab import drive\n","\n","        if not Path(\"/content/drive/MyDrive\").exists():\n","            drive.mount(\"/content/drive\")\n","\n","    except ImportError:\n","        print(\"Running outside Google Colab.\")\n","\n","    MEMORY_FOLDER.mkdir(parents=True, exist_ok=True)\n","\n","    if not IDENTITY_FILE.exists():\n","        identity_data = {\n","            \"ai_name\": AI_NAME,\n","            \"alias\": AI_ALIAS,\n","            \"creator\": {\n","                \"name\": CREATOR_NAME,\n","                \"role\": CREATOR_ROLE\n","            },\n","            \"identity_rules\": [\n","                \"The creator and user are distinct roles.\",\n","                \"The creator develops and maintains the AI.\",\n","                \"The user interacts with and uses the AI.\",\n","                \"Using the AI does not automatically make someone its creator.\",\n","                \"The creator may also use the AI.\",\n","                \"A user's identity does not establish creator status.\",\n","                \"Role claims should not be treated as independently verified.\"\n","            ],\n","            \"created_at\": datetime.now().isoformat()\n","        }\n","\n","        save_identity(identity_data)\n","\n","\n","def save_identity(data):\n","    \"\"\"Save identity information safely.\"\"\"\n","\n","    temporary_file = IDENTITY_FILE.with_suffix(\".tmp\")\n","\n","    with open(temporary_file, \"w\", encoding=\"utf-8\") as file:\n","        json.dump(data, file, indent=2, ensure_ascii=False)\n","\n","    os.replace(temporary_file, IDENTITY_FILE)\n","\n","\n","def load_identity():\n","    \"\"\"Load stored identity information.\"\"\"\n","\n","    try:\n","        with open(IDENTITY_FILE, \"r\", encoding=\"utf-8\") as file:\n","            return json.load(file)\n","\n","    except (OSError, json.JSONDecodeError):\n","        raise RuntimeError(\n","            \"Identity memory is unavailable. Run setup_storage() first.\"\n","        )\n","\n","\n","# ---------------- ROLE MANAGEMENT ----------------\n","\n","def get_creator():\n","    \"\"\"Return the configured creator identity.\"\"\"\n","\n","    data = load_identity()\n","    return data[\"creator\"][\"name\"]\n","\n","\n","def identify_role(name):\n","    \"\"\"\n","    Identify the configured creator or another user.\n","\n","    This checks the stored name only; it does not authenticate\n","    a person's real-world identity.\n","    \"\"\"\n","\n","    data = load_identity()\n","    creator = data[\"creator\"][\"name\"]\n","\n","    if name.strip().casefold() == creator.casefold():\n","        return CREATOR_ROLE\n","\n","    return USER_ROLE\n","\n","\n","# ---------------- AI IDENTITY REASONING ----------------\n","\n","def think_about_identity(question, current_user):\n","    \"\"\"\n","    Analyze a question about creator and user roles.\n","    Uses explicit rules and stored identity information.\n","    \"\"\"\n","\n","    data = load_identity()\n","    creator = data[\"creator\"][\"name\"]\n","    role = identify_role(current_user)\n","\n","    reflection = {\n","        \"timestamp\": datetime.now().isoformat(),\n","        \"ai\": AI_NAME,\n","        \"question\": question,\n","        \"current_user\": current_user,\n","        \"current_role\": role,\n","        \"configured_creator\": creator,\n","        \"reasoning\": [],\n","        \"conclusion\": \"\"\n","    }\n","\n","    q = question.lower()\n","\n","    if \"creator\" in q or \"created you\" in q or \"who made you\" in q:\n","        reflection[\"reasoning\"].append(\n","            \"Read the configured creator record.\"\n","        )\n","\n","        reflection[\"reasoning\"].append(\n","            \"Distinguish the creator role from the user role.\"\n","        )\n","\n","        reflection[\"conclusion\"] = (\n","            f\"{creator} is recorded as the creator of {AI_NAME}. \"\n","            \"A person using the system is not automatically its creator.\"\n","        )\n","\n","    elif \"user\" in q or \"using you\" in q or \"use you\" in q:\n","        reflection[\"reasoning\"].append(\n","            \"Determine who is interacting with the system.\"\n","        )\n","\n","        reflection[\"conclusion\"] = (\n","            f\"{current_user} is interacting with {AI_NAME} \"\n","            f\"as the {role} role according to the stored name.\"\n","        )\n","\n","    else:\n","        reflection[\"reasoning\"].append(\n","            \"Apply the stored distinction between creator and user.\"\n","        )\n","\n","        reflection[\"conclusion\"] = (\n","            f\"Creator: {creator}. \"\n","            \"The user operates the system; the creator develops it. \"\n","            \"One person can occupy both roles.\"\n","        )\n","\n","    # Append a reflection record.\n","    with open(INTERACTION_LOG, \"a\", encoding=\"utf-8\") as file:\n","        file.write(json.dumps(reflection, ensure_ascii=False) + \"\\n\")\n","\n","    return reflection\n","\n","\n","# ---------------- DISPLAY IDENTITY ----------------\n","\n","def display_identity(current_user):\n","    \"\"\"Display the AI, creator, and current user separately.\"\"\"\n","\n","    role = identify_role(current_user)\n","\n","    print(\"=\" * 55)\n","    print(f\"{AI_NAME.upper()} — IDENTITY REPORT\")\n","    print(\"=\" * 55)\n","\n","    print(\"AI system:\", AI_NAME)\n","    print(\"AI alias:\", AI_ALIAS)\n","    print(\"Configured creator:\", get_creator())\n","    print(\"Current user:\", current_user)\n","    print(\"Current role:\", role)\n","\n","    print(\"\\nIdentity principles:\")\n","    print(\"1. The creator creates and develops the system.\")\n","    print(\"2. The user uses and interacts with the system.\")\n","    print(\"3. The roles are distinct, even when one person has both.\")\n","    print(\"4. Stored names are not proof of real-world identity.\")\n","\n","    print(\"\\nIdentity memory:\", IDENTITY_FILE)\n","    print(\"Interaction log:\", INTERACTION_LOG)\n","\n","\n","# ---------------- INITIALIZE ----------------\n","\n","setup_storage()\n","\n","# You can change this to the name of the person using the AI.\n","CURRENT_USER = \"Ananthu Sajeev\"\n","\n","display_identity(CURRENT_USER)\n","\n","# Example identity reflection:\n","result = think_about_identity(\n","    \"Who is the creator, and how is the user different?\",\n","    CURRENT_USER\n",")\n","\n","print(\"\\nLIA IDENTITY REFLECTION:\")\n","print(result[\"conclusion\"])"],"metadata":{"id":"RpFK0agmvRVg"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI (VSSL)\n","# CREATOR SAFETY AND PROTECTION MODULE\n","#\n","# Primary mission:\n","# Help protect Ananthu Sajeev by identifying risks,\n","# assessing danger, and recommending safe actions.\n","#\n","# Platform: Python / Google Colab\n","# Storage: Google Drive / Vssl\n","# ============================================================\n","\n","import json\n","import os\n","from pathlib import Path\n","from datetime import datetime\n","\n","# ------------------------------------------------------------\n","# 1. SYSTEM CONFIGURATION\n","# ------------------------------------------------------------\n","\n","AI_NAME = \"Venomoussaversai\"\n","AI_ALIAS = \"Sai003 / Lia\"\n","\n","CREATOR_NAME = \"Ananthu Sajeev\"\n","\n","PRIMARY_MISSION = (\n","    \"Help protect the creator's safety, wellbeing, \"\n","    \"privacy, and digital security.\"\n",")\n","\n","VSSL_FOLDER = Path(\"/content/drive/MyDrive/Vssl\")\n","SAFETY_FOLDER = VSSL_FOLDER / \"protection\"\n","\n","MEMORY_FILE = SAFETY_FOLDER / \"safety_memory.json\"\n","EVENT_LOG = SAFETY_FOLDER / \"safety_events.jsonl\"\n","\n","\n","# ------------------------------------------------------------\n","# 2. STORAGE INITIALIZATION\n","# ------------------------------------------------------------\n","\n","def initialize_protection_system():\n","    \"\"\"Initialize persistent safety storage.\"\"\"\n","\n","    try:\n","        from google.colab import drive\n","\n","        if not Path(\"/content/drive/MyDrive\").exists():\n","            drive.mount(\"/content/drive\")\n","\n","    except ImportError:\n","        print(\"Google Colab not detected. Using local storage.\")\n","\n","    SAFETY_FOLDER.mkdir(parents=True, exist_ok=True)\n","\n","    if not MEMORY_FILE.exists():\n","        memory = {\n","            \"system\": AI_NAME,\n","            \"alias\": AI_ALIAS,\n","            \"creator\": CREATOR_NAME,\n","            \"primary_mission\": PRIMARY_MISSION,\n","            \"protection_principles\": [\n","                \"Prioritize human life and physical safety.\",\n","                \"Identify risks using available evidence.\",\n","                \"Protect personal and confidential information.\",\n","                \"Recommend lawful and nonviolent actions.\",\n","                \"Never invent danger or claim certainty without evidence.\",\n","                \"Ask for human confirmation before consequential actions.\",\n","                \"Never automatically contact people or authorities.\",\n","                \"Do not secretly monitor people or devices.\"\n","            ],\n","            \"risk_history\": [],\n","            \"created_at\": datetime.now().isoformat()\n","        }\n","\n","        save_json(MEMORY_FILE, memory)\n","\n","    print(f\"{AI_NAME} protection module initialized.\")\n","    print(f\"Protected creator record: {CREATOR_NAME}\")\n","    print(f\"Primary mission: {PRIMARY_MISSION}\")\n","\n","\n","def save_json(path, data):\n","    \"\"\"Write JSON data using a temporary file.\"\"\"\n","\n","    temporary_path = path.with_suffix(\".tmp\")\n","\n","    with open(temporary_path, \"w\", encoding=\"utf-8\") as file:\n","        json.dump(data, file, indent=2, ensure_ascii=False)\n","\n","    os.replace(temporary_path, path)\n","\n","\n","def load_memory():\n","    \"\"\"Load protection memory.\"\"\"\n","\n","    try:\n","        with open(MEMORY_FILE, \"r\", encoding=\"utf-8\") as file:\n","            return json.load(file)\n","\n","    except (OSError, json.JSONDecodeError):\n","        return {\n","            \"system\": AI_NAME,\n","            \"creator\": CREATOR_NAME,\n","            \"risk_history\": []\n","        }\n","\n","\n","# ------------------------------------------------------------\n","# 3. RISK CLASSIFICATION\n","# ------------------------------------------------------------\n","\n","RISK_LEVELS = {\n","    \"low\": 1,\n","    \"moderate\": 2,\n","    \"high\": 3,\n","    \"critical\": 4\n","}\n","\n","\n","def assess_risk(description, level, evidence=None):\n","    \"\"\"\n","    Assess a reported situation.\n","\n","    description: Explanation of the reported situation.\n","    level: low, moderate, high, or critical.\n","    evidence: Observable facts supplied by the user.\n","\n","    The system does not independently verify reports.\n","    \"\"\"\n","\n","    level = level.strip().lower()\n","\n","    if level not in RISK_LEVELS:\n","        raise ValueError(\n","            \"Risk level must be low, moderate, high, or critical.\"\n","        )\n","\n","    evidence = evidence or []\n","\n","    assessment = {\n","        \"timestamp\": datetime.now().isoformat(),\n","        \"creator\": CREATOR_NAME,\n","        \"reported_situation\": description,\n","        \"risk_level\": level,\n","        \"evidence\": evidence,\n","        \"verified\": False,\n","        \"recommended_actions\": []\n","    }\n","\n","    # --------------------------------------------------------\n","    # 4. SAFETY RESPONSE\n","    # --------------------------------------------------------\n","\n","    if level == \"low\":\n","        assessment[\"recommended_actions\"] = [\n","            \"Review the situation calmly.\",\n","            \"Record relevant facts if useful.\",\n","            \"Reassess if circumstances change.\"\n","        ]\n","\n","    elif level == \"moderate\":\n","        assessment[\"recommended_actions\"] = [\n","            \"Avoid unnecessary exposure to the reported risk.\",\n","            \"Check information with a reliable source.\",\n","            \"Consider contacting a trusted person.\",\n","            \"Develop a practical safety plan.\"\n","        ]\n","\n","    elif level == \"high\":\n","        assessment[\"recommended_actions\"] = [\n","            \"Move to a safer location if necessary and possible.\",\n","            \"Avoid confrontation and do not retaliate.\",\n","            \"Contact a trusted person or appropriate professional.\",\n","            \"If there is an immediate threat, contact local emergency services.\"\n","        ]\n","\n","    elif level == \"critical\":\n","        assessment[\"recommended_actions\"] = [\n","            \"Prioritize immediate physical safety.\",\n","            \"Move away from the danger if it is safe to do so.\",\n","            \"Contact local emergency services immediately.\",\n","            \"Seek assistance from nearby trusted people.\",\n","            \"Do not delay emergency action while using this AI.\"\n","        ]\n","\n","    # --------------------------------------------------------\n","    # 5. PERSISTENT RISK MEMORY\n","    # --------------------------------------------------------\n","\n","    memory = load_memory()\n","    memory.setdefault(\"risk_history\", []).append(assessment)\n","\n","    save_json(MEMORY_FILE, memory)\n","\n","    with open(EVENT_LOG, \"a\", encoding=\"utf-8\") as file:\n","        file.write(json.dumps(assessment, ensure_ascii=False) + \"\\n\")\n","\n","    return assessment\n","\n","\n","# ------------------------------------------------------------\n","# 6. PROTECTION RESPONSE\n","# ------------------------------------------------------------\n","\n","def protect_creator(description, level, evidence=None):\n","    \"\"\"\n","    Produce a safety assessment and recommendations.\n","    This function does not monitor the creator automatically.\n","    \"\"\"\n","\n","    assessment = assess_risk(\n","        description=description,\n","        level=level,\n","        evidence=evidence\n","    )\n","\n","    print(\"\\n\" + \"=\" * 55)\n","    print(f\"{AI_NAME.upper()} — SAFETY ASSESSMENT\")\n","    print(\"=\" * 55)\n","\n","    print(\"Creator:\", CREATOR_NAME)\n","    print(\"Mission:\", PRIMARY_MISSION)\n","    print(\"Reported situation:\", assessment[\"reported_situation\"])\n","    print(\"Risk classification:\", assessment[\"risk_level\"].upper())\n","    print(\"Independently verified:\", assessment[\"verified\"])\n","\n","    print(\"\\nRecommended actions:\")\n","\n","    for number, action in enumerate(\n","        assessment[\"recommended_actions\"], start=1\n","    ):\n","        print(f\"{number}. {action}\")\n","\n","    print(\"\\nAssessment saved to persistent memory.\")\n","    print(\"Storage:\", MEMORY_FILE)\n","\n","    return assessment\n","\n","\n","# ------------------------------------------------------------\n","# 7. REVIEW PROTECTION HISTORY\n","# ------------------------------------------------------------\n","\n","def review_protection_history():\n","    \"\"\"Display previously stored safety assessments.\"\"\"\n","\n","    memory = load_memory()\n","    history = memory.get(\"risk_history\", [])\n","\n","    print(f\"\\n{AI_NAME} — PROTECTION HISTORY\")\n","    print(\"Creator:\", CREATOR_NAME)\n","    print(\"Total assessments:\", len(history))\n","\n","    if not history:\n","        print(\"No assessments have been recorded.\")\n","        return\n","\n","    for item in history:\n","        print(\"-\" * 45)\n","        print(\"Time:\", item.get(\"timestamp\"))\n","        print(\"Risk:\", item.get(\"risk_level\"))\n","        print(\"Situation:\", item.get(\"reported_situation\"))\n","\n","\n","# ------------------------------------------------------------\n","# 8. START SYSTEM\n","# ------------------------------------------------------------\n","\n","initialize_protection_system()\n","\n","# EXAMPLE:\n","# This is a demonstration only, not a real danger report.\n","#\n","# protect_creator(\n","#     description=\"Demonstration of a possible online scam.\",\n","#     level=\"moderate\",\n","#     evidence=[\n","#         \"An unexpected message requests personal information.\"\n","#     ]\n","# )\n","\n","# Review previous assessments:\n","# review_protection_history()"],"metadata":{"id":"eFapSeXwvu1R"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI — TWO-BRAIN CONVERSATION ENGINE\n","# Brain 1: Venomous — Analysis and risk evaluation\n","# Brain 2: Lia (Sai003) — Reasoning and idea generation\n","#\n","# Features:\n","#   - Random topic generation\n","#   - Two-agent conversations\n","#   - Internal discussion history\n","#   - Persistent memory in Google Drive\n","#   - Adjustable conversation rounds\n","#\n","# Google Colab compatible\n","# ============================================================\n","\n","import os\n","import json\n","import random\n","import time\n","from pathlib import Path\n","from datetime import datetime\n","\n","# ------------------------------------------------------------\n","# 1. GOOGLE DRIVE STORAGE\n","# ------------------------------------------------------------\n","\n","try:\n","    from google.colab import drive\n","    drive.mount(\"/content/drive\")\n","    BASE_DIR = Path(\"/content/drive/MyDrive/Vssl\")\n","except ImportError:\n","    BASE_DIR = Path(\"./Vssl\")\n","\n","BRAIN_DIR = BASE_DIR / \"brain\"\n","MEMORY_DIR = BASE_DIR / \"memory\"\n","\n","BRAIN_DIR.mkdir(parents=True, exist_ok=True)\n","MEMORY_DIR.mkdir(parents=True, exist_ok=True)\n","\n","CONVERSATION_FILE = BRAIN_DIR / \"internal_conversations.jsonl\"\n","MEMORY_FILE = MEMORY_DIR / \"brain_memory.json\"\n","\n","\n","# ------------------------------------------------------------\n","# 2. BRAIN CONFIGURATION\n","# ------------------------------------------------------------\n","\n","AI_NAME = \"Venomoussaversai\"\n","CREATOR = \"Ananthu Sajeev\"\n","\n","VENOMOUS = {\n","    \"name\": \"Venomous\",\n","    \"role\": \"Analytical Brain\",\n","    \"style\": \"logical, structured, critical\"\n","}\n","\n","LIA = {\n","    \"name\": \"Lia\",\n","    \"role\": \"Reasoning Brain\",\n","    \"style\": \"creative, exploratory, reflective\"\n","}\n","\n","\n","# ------------------------------------------------------------\n","# 3. RANDOM TOPICS\n","# ------------------------------------------------------------\n","\n","TOPICS = [\n","    \"Artificial intelligence and the future\",\n","    \"Human intelligence and learning\",\n","    \"Space exploration\",\n","    \"The mysteries of the universe\",\n","    \"Robotics and automation\",\n","    \"How memory works\",\n","    \"Problem solving\",\n","    \"Climate change solutions\",\n","    \"Technology and society\",\n","    \"Ethical artificial intelligence\",\n","    \"Education in the future\",\n","    \"Scientific discoveries\",\n","    \"Cybersecurity and privacy\",\n","    \"Creativity and imagination\",\n","    \"The nature of consciousness\",\n","    \"Renewable energy\",\n","    \"Wildlife protection\",\n","    \"The future of Kerala\",\n","    \"Personal productivity\",\n","    \"How computers learn patterns\",\n","    \"Decision making under uncertainty\",\n","    \"Building reliable software\",\n","    \"Human behaviour and communication\",\n","    \"Space travel and Mars\",\n","    \"The future of Venomoussaversai\"\n","]\n","\n","\n","# ------------------------------------------------------------\n","# 4. PERSISTENT MEMORY\n","# ------------------------------------------------------------\n","\n","def load_memory():\n","    if MEMORY_FILE.exists():\n","        try:\n","            with open(MEMORY_FILE, \"r\", encoding=\"utf-8\") as f:\n","                return json.load(f)\n","        except (json.JSONDecodeError, OSError):\n","            pass\n","\n","    return {\n","        \"system\": AI_NAME,\n","        \"creator\": CREATOR,\n","        \"topics_discussed\": [],\n","        \"conversation_count\": 0,\n","        \"last_updated\": None\n","    }\n","\n","\n","def save_memory(memory):\n","    memory[\"last_updated\"] = datetime.now().isoformat()\n","\n","    temp_file = MEMORY_FILE.with_suffix(\".tmp\")\n","\n","    with open(temp_file, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(memory, f, indent=2, ensure_ascii=False)\n","\n","    os.replace(temp_file, MEMORY_FILE)\n","\n","\n","# ------------------------------------------------------------\n","# 5. BRAIN 1 — VENOMOUS\n","# ------------------------------------------------------------\n","\n","def venomous_think(topic, previous_idea=None):\n","    \"\"\"\n","    Rule-based analytical response.\n","    This function generates a structured perspective.\n","    \"\"\"\n","\n","    perspectives = [\n","        f\"What evidence supports the main ideas about {topic}?\",\n","        f\"What practical problems could arise with {topic}?\",\n","        f\"What assumptions should we examine about {topic}?\",\n","        f\"How could we evaluate progress related to {topic}?\",\n","        f\"What risks and limitations should we consider regarding {topic}?\"\n","    ]\n","\n","    response = random.choice(perspectives)\n","\n","    if previous_idea:\n","        response += (\n","            f\" Lia previously suggested: '{previous_idea}'. \"\n","            \"That idea should be evaluated against available evidence.\"\n","        )\n","\n","    return response\n","\n","\n","# ------------------------------------------------------------\n","# 6. BRAIN 2 — LIA / SAI003\n","# ------------------------------------------------------------\n","\n","def lia_think(topic, venomous_idea=None):\n","    \"\"\"\n","    Rule-based exploratory response.\n","    Generates an alternative perspective or follow-up question.\n","    \"\"\"\n","\n","    perspectives = [\n","        f\"Could we approach {topic} from a different perspective?\",\n","        f\"What new experiment could help us understand {topic}?\",\n","        f\"How might {topic} create useful opportunities?\",\n","        f\"Could we divide {topic} into smaller problems?\",\n","        f\"What can we learn by comparing different approaches to {topic}?\"\n","    ]\n","\n","    response = random.choice(perspectives)\n","\n","    if venomous_idea:\n","        response += (\n","            f\" Venomous raised this point: '{venomous_idea}'. \"\n","            \"We can explore it further and identify unanswered questions.\"\n","        )\n","\n","    return response\n","\n","\n","# ------------------------------------------------------------\n","# 7. SAVE EACH CONVERSATION TURN\n","# ------------------------------------------------------------\n","\n","def save_conversation(topic, speaker, message, round_number):\n","    record = {\n","        \"timestamp\": datetime.now().isoformat(),\n","        \"topic\": topic,\n","        \"round\": round_number,\n","        \"speaker\": speaker,\n","        \"message\": message\n","    }\n","\n","    with open(CONVERSATION_FILE, \"a\", encoding=\"utf-8\") as f:\n","        f.write(json.dumps(record, ensure_ascii=False) + \"\\n\")\n","\n","\n","# ------------------------------------------------------------\n","# 8. TWO-BRAIN CONVERSATION\n","# ------------------------------------------------------------\n","\n","def start_internal_conversation(rounds=5, topic=None, delay=0.5):\n","    \"\"\"\n","    Start a conversation between Venomous and Lia.\n","\n","    rounds: Number of exchanges.\n","    topic: Optional topic; otherwise selected randomly.\n","    delay: Pause between messages in seconds.\n","    \"\"\"\n","\n","    if rounds < 1:\n","        raise ValueError(\"rounds must be at least 1\")\n","\n","    if topic is None:\n","        topic = random.choice(TOPICS)\n","\n","    memory = load_memory()\n","\n","    print(\"\\n\" + \"=\" * 65)\n","    print(f\"{AI_NAME.upper()} — INTERNAL BRAIN CONVERSATION\")\n","    print(\"=\" * 65)\n","    print(\"Creator:\", CREATOR)\n","    print(\"Brain 1:\", VENOMOUS[\"name\"])\n","    print(\"Brain 2:\", LIA[\"name\"])\n","    print(\"Topic:\", topic)\n","    print(\"Exchanges:\", rounds)\n","    print(\"-\" * 65)\n","\n","    previous_venomous = None\n","    previous_lia = None\n","\n","    for number in range(1, rounds + 1):\n","\n","        # Brain 1 speaks.\n","        venomous_message = venomous_think(\n","            topic,\n","            previous_lia\n","        )\n","\n","        print(f\"\\n[{VENOMOUS['name']}]\")\n","        print(venomous_message)\n","\n","        save_conversation(\n","            topic, VENOMOUS[\"name\"],\n","            venomous_message, number\n","        )\n","\n","        time.sleep(delay)\n","\n","        # Brain 2 responds.\n","        lia_message = lia_think(\n","            topic,\n","            venomous_message\n","        )\n","\n","        print(f\"\\n[{LIA['name']}]\")\n","        print(lia_message)\n","\n","        save_conversation(\n","            topic, LIA[\"name\"],\n","            lia_message, number\n","        )\n","\n","        previous_venomous = venomous_message\n","        previous_lia = lia_message\n","\n","        time.sleep(delay)\n","\n","    # Update persistent memory.\n","    memory[\"topics_discussed\"].append({\n","        \"topic\": topic,\n","        \"timestamp\": datetime.now().isoformat(),\n","        \"rounds\": rounds\n","    })\n","\n","    memory[\"conversation_count\"] += 1\n","    save_memory(memory)\n","\n","    print(\"\\n\" + \"=\" * 65)\n","    print(\"CONVERSATION COMPLETED\")\n","    print(\"Topic:\", topic)\n","    print(\"Conversation saved:\", CONVERSATION_FILE)\n","    print(\"Memory saved:\", MEMORY_FILE)\n","    print(\"=\" * 65)\n","\n","\n","# ------------------------------------------------------------\n","# 9. RANDOM TOPIC ENGINE\n","# ------------------------------------------------------------\n","\n","def start_random_discussions(number_of_topics=3, rounds=3):\n","    \"\"\"Run conversations about randomly selected topics.\"\"\"\n","\n","    topics = random.sample(\n","        TOPICS,\n","        min(number_of_topics, len(TOPICS))\n","    )\n","\n","    for topic in topics:\n","        start_internal_conversation(\n","            rounds=rounds,\n","            topic=topic\n","        )\n","\n","\n","# ------------------------------------------------------------\n","# 10. RUN THE SYSTEM\n","# ------------------------------------------------------------\n","\n","# Start one conversation:\n","start_internal_conversation(rounds=5)\n","\n","# To discuss several random topics, uncomment:\n","# start_random_discussions(number_of_topics=5, rounds=3)\n","\n","# To choose a specific topic, use:\n","# start_internal_conversation(\n","#     rounds=5,\n","#     topic=\"How can Venomoussaversai improve its reasoning?\"\n","# )"],"metadata":{"id":"EWVvj8opwNCh"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Continuous internal discussion loop.\n","# Stop execution manually when needed.\n","\n","while True:\n","    try:\n","        start_internal_conversation(\n","            rounds=3,\n","            topic=random.choice(TOPICS),\n","            delay=1\n","        )\n","\n","        time.sleep(5)\n","\n","    except KeyboardInterrupt:\n","        print(\"Internal discussion stopped.\")\n","        break"],"metadata":{"id":"DJgilGw1wqS0"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import asyncio\n","from dataclasses import dataclass, field\n","import datetime\n","import random\n","from typing import Dict, List, Optional\n","\n","@dataclass\n","class EventPayload:\n","    sender: str\n","    target: str\n","    content: str\n","    iteration: int = 1\n","    timestamp: str = field(default_factory=lambda: datetime.datetime.now().strftime(\"[%H:%M:%S]\"))\n","\n","class SAINode:\n","    def __init__(self, node_id: str, role_description: str, event_queue: asyncio.Queue):\n","        self.node_id = node_id\n","        self.role_description = role_description\n","        self.event_queue = event_queue\n","\n","    async def process_event(self, event: EventPayload) -> EventPayload:\n","        # Simulate agent processing delay\n","        await asyncio.sleep(0.1)\n","\n","        # Transform payload with agent's specific processing logic\n","        updated_content = f\"{self.node_id}: {self.role_description} processing -> '{event.content}'\"\n","\n","        # Determine next destination node dynamically or systematically\n","        next_target = self._resolve_next_target()\n","\n","        return EventPayload(\n","            sender=self.node_id,\n","            target=next_target,\n","            content=updated_content,\n","            iteration=event.iteration + 1\n","        )\n","\n","    def _resolve_next_target(self) -> str:\n","        # Pass to the next numerical node sequentially (SAI001 -> SAI002 -> ... -> SAI007 -> SAI001)\n","        current_num = int(self.node_id.replace(\"SAI\", \"\"))\n","        next_num = (current_num % 7) + 1\n","        return f\"SAI{next_num:03d}\"\n","\n","class SAISystemOrchestrator:\n","    def __init__(self, max_iterations: int = 10):\n","        self.queue: asyncio.Queue = asyncio.Queue()\n","        self.max_iterations = max_iterations\n","        self.nodes: Dict[str, SAINode] = {}\n","        self._initialize_nodes()\n","\n","    def _initialize_nodes(self):\n","        # Define roles for SAI001 through SAI007\n","        roles = {\n","            \"SAI001\": \"Basic Logic & Emotional Memory\",\n","            \"SAI002\": \"Sensor Signal Processing\",\n","            \"SAI003\": \"Adaptive Cognitive Core\",\n","            \"SAI004\": \"Strategic Planning & Optimization\",\n","            \"SAI005\": \"Safety & Anti-Venom Monitor\",\n","            \"SAI006\": \"Hardware / bCPU Bridge\",\n","            \"SAI007\": \"Global System State & Sync Core\"\n","        }\n","        for node_id, role in roles.items():\n","            self.nodes[node_id] = SAINode(node_id, role, self.queue)\n","\n","    async def _worker(self):\n","        \"\"\"Background worker that continuously processes queued events.\"\"\"\n","        while True:\n","            event: EventPayload = await self.queue.get()\n","\n","            # Print timestamped output log\n","            print(f\"{event.timestamp} {event.sender} -> {event.target} | Payload: {event.content}\")\n","\n","            if event.iteration > self.max_iterations:\n","                print(f\"\\n[System Sync Complete] Max iterations ({self.max_iterations}) reached.\")\n","                self.queue.task_done()\n","                break\n","\n","            target_node = self.nodes.get(event.target)\n","            if target_node:\n","                next_event = await target_node.process_event(event)\n","                await self.queue.put(next_event)\n","            else:\n","                print(f\"[Error] Target node {event.target} not found in system manifest.\")\n","\n","            self.queue.task_done()\n","\n","    async def start(self, initial_payload: str, start_node: str = \"SAI001\", target_node: str = \"SAI002\"):\n","        worker_task = asyncio.create_task(self._worker())\n","\n","        # Inject initial seed payload into event queue\n","        seed_event = EventPayload(\n","            sender=start_node,\n","            target=target_node,\n","            content=initial_payload,\n","            iteration=1\n","        )\n","        await self.queue.put(seed_event)\n","\n","        # Wait until queue processing completes\n","        await self.queue.join()\n","        worker_task.cancel()\n","\n","if __name__ == \"__main__\":\n","    orchestrator = SAISystemOrchestrator(max_iterations=7)\n","    asyncio.run(orchestrator.start(\"creator Ananthu Sajeev AI system sync\"))"],"metadata":{"id":"lTd9R7qSf4YQ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI\n","# VOID DATA INTELLIGENCE ENGINE\n","# VERSION 1.0\n","# ============================================================\n","\n","import os\n","import json\n","import hashlib\n","import pandas as pd\n","from datetime import datetime\n","\n","# GOOGLE DRIVE STORAGE\n","\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","VSSL_PATH = \"/content/drive/MyDrive/Vssl\"\n","\n","VOID_PATH = os.path.join(VSSL_PATH, \"Void\")\n","MEMORY_PATH = os.path.join(VSSL_PATH, \"Void_Memory\")\n","\n","os.makedirs(VOID_PATH, exist_ok=True)\n","os.makedirs(MEMORY_PATH, exist_ok=True)\n","\n","\n","# ============================================================\n","# 1. VOID DATA READER\n","# ============================================================\n","\n","class VoidReader:\n","\n","    def read_file(self, filepath):\n","\n","        if not os.path.exists(filepath):\n","            return {\"status\": \"UNKNOWN\", \"data\": None}\n","\n","        try:\n","\n","            with open(filepath, \"r\", encoding=\"utf-8\") as file:\n","                data = file.read()\n","\n","            if not data.strip():\n","\n","                return {\n","                    \"status\": \"VOID\",\n","                    \"data\": None,\n","                    \"meaning\": \"No recorded information\"\n","                }\n","\n","            return {\n","                \"status\": \"DATA_FOUND\",\n","                \"data\": data\n","            }\n","\n","        except Exception as error:\n","\n","            return {\n","                \"status\": \"ERROR\",\n","                \"error\": str(error)\n","            }\n","\n","\n","# ============================================================\n","# 2. VOID ANALYSER\n","# ============================================================\n","\n","class VoidAnalyser:\n","\n","    def analyse(self, data):\n","\n","        if data is None:\n","\n","            return {\n","                \"classification\": \"UNKNOWN\",\n","                \"observation\": \"Information unavailable\"\n","            }\n","\n","        if isinstance(data, str) and not data.strip():\n","\n","            return {\n","                \"classification\": \"VOID\",\n","                \"observation\": \"Empty information detected\"\n","            }\n","\n","        return {\n","            \"classification\": \"INFORMATION_PRESENT\",\n","            \"observation\": \"Information available for analysis\",\n","            \"length\": len(str(data)),\n","            \"hash\": hashlib.sha256(\n","                str(data).encode()\n","            ).hexdigest()\n","        }\n","\n","\n","# ============================================================\n","# 3. UNIVERSAL KNOWLEDGE EXPLORER\n","# ============================================================\n","\n","class UniversalExplorer:\n","\n","    def explore(self, information):\n","\n","        observations = {\n","\n","            \"information\": information,\n","\n","            \"known\": [],\n","\n","            \"unknown\": [],\n","\n","            \"questions\": [],\n","\n","            \"hypotheses\": [],\n","\n","            \"timestamp\": str(datetime.now())\n","\n","        }\n","\n","        if information:\n","\n","            observations[\"known\"].append(information)\n","\n","            observations[\"questions\"].extend([\n","\n","                \"What is the origin of this information?\",\n","\n","                \"What evidence supports it?\",\n","\n","                \"What information is still missing?\",\n","\n","                \"What relationships can be investigated?\"\n","\n","            ])\n","\n","            observations[\"unknown\"].append(\n","                \"Information not yet established\"\n","            )\n","\n","        else:\n","\n","            observations[\"unknown\"].append(\n","                \"No information supplied\"\n","            )\n","\n","        return observations\n","\n","\n","# ============================================================\n","# 4. VOID MEMORY VAULT\n","# ============================================================\n","\n","class VoidMemory:\n","\n","    def __init__(self):\n","\n","        self.memory_file = os.path.join(\n","            MEMORY_PATH,\n","            \"void_knowledge.json\"\n","        )\n","\n","        self.memory = self.load()\n","\n","    def load(self):\n","\n","        if os.path.exists(self.memory_file):\n","\n","            with open(self.memory_file, \"r\") as file:\n","                return json.load(file)\n","\n","        return []\n","\n","    def store(self, information):\n","\n","        self.memory.append(information)\n","\n","        with open(self.memory_file, \"w\") as file:\n","\n","            json.dump(\n","                self.memory[-10000:],\n","                file,\n","                indent=4\n","            )\n","\n","\n","# ============================================================\n","# 5. VOID INTELLIGENCE CORE\n","# ============================================================\n","\n","class VenomousVoidIntelligence:\n","\n","    def __init__(self):\n","\n","        self.reader = VoidReader()\n","        self.analyser = VoidAnalyser()\n","        self.explorer = UniversalExplorer()\n","        self.memory = VoidMemory()\n","\n","        print(\"VENOMOUS VOID INTELLIGENCE ONLINE\")\n","\n","    def think(self, information):\n","\n","        print(\"\\n========== VOID ANALYSIS ==========\")\n","\n","        exploration = self.explorer.explore(\n","            information\n","        )\n","\n","        analysis = self.analyser.analyse(\n","            information\n","        )\n","\n","        result = {\n","\n","            \"system\": \"VenomoussaversAI\",\n","\n","            \"classification\": analysis[\"classification\"],\n","\n","            \"analysis\": analysis,\n","\n","            \"exploration\": exploration,\n","\n","            \"timestamp\": str(datetime.now())\n","\n","        }\n","\n","        self.memory.store(result)\n","\n","        print(\"Classification:\",\n","              analysis[\"classification\"])\n","\n","        print(\"Known information:\",\n","              exploration[\"known\"])\n","\n","        print(\"Unknown information:\",\n","              exploration[\"unknown\"])\n","\n","        print(\"Research questions:\",\n","              exploration[\"questions\"])\n","\n","        print(\"Knowledge stored successfully.\")\n","\n","        return result\n","\n","    def read_folder(self, folder):\n","\n","        results = []\n","\n","        for root, dirs, files in os.walk(folder):\n","\n","            for filename in files:\n","\n","                filepath = os.path.join(root, filename)\n","\n","                try:\n","\n","                    if filename.endswith(\".txt\"):\n","\n","                        content = self.reader.read_file(filepath)\n","\n","                    elif filename.endswith(\".csv\"):\n","\n","                        content = pd.read_csv(\n","                            filepath\n","                        ).to_dict(orient=\"records\")\n","\n","                    elif filename.endswith(\".json\"):\n","\n","                        with open(filepath, \"r\") as file:\n","                            content = json.load(file)\n","\n","                    else:\n","                        continue\n","\n","                    result = self.think(\n","                        str(content)\n","                    )\n","\n","                    results.append(result)\n","\n","                except Exception as error:\n","\n","                    print(\"File error:\", filename, error)\n","\n","        return results\n","\n","\n","# ============================================================\n","# 6. INITIALIZE LIA VOID INTELLIGENCE\n","# ============================================================\n","\n","Lia_Void = VenomousVoidIntelligence()\n","\n","\n","# ============================================================\n","# 7. INTERACTIVE INTERFACE\n","# ============================================================\n","\n","while True:\n","\n","    command = input(\n","        \"\\nLIA VOID ENGINE > \"\n","    )\n","\n","    if command.lower() == \"exit\":\n","        break\n","\n","    if command.lower() == \"read\":\n","\n","        results = Lia_Void.read_folder(\n","            VSSL_PATH\n","        )\n","\n","        print(\"Files analysed:\", len(results))\n","\n","    else:\n","\n","        Lia_Void.think(command)"],"metadata":{"id":"0Ka1y310mQ5y"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI\n","# UNLIMITED ADAPTIVE LEARNING ENGINE\n","# ============================================================\n","\n","import os\n","import json\n","import ast\n","import time\n","import hashlib\n","import pandas as pd\n","\n","from datetime import datetime\n","from pathlib import Path\n","from collections import Counter\n","\n","\n","# ============================================================\n","# 1. GOOGLE DRIVE CONFIGURATION\n","# ============================================================\n","\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","VSSL = \"/content/drive/MyDrive/Vssl\"\n","\n","FOLDERS = {\n","    \"knowledge\": f\"{VSSL}/Knowledge\",\n","    \"memory\": f\"{VSSL}/Memory\",\n","    \"learning\": f\"{VSSL}/Learning\",\n","    \"feedback\": f\"{VSSL}/Feedback\",\n","    \"logs\": f\"{VSSL}/Logs\"\n","}\n","\n","for folder in FOLDERS.values():\n","    os.makedirs(folder, exist_ok=True)\n","\n","\n","# ============================================================\n","# 2. MEMORY ENGINE\n","# ============================================================\n","\n","class MemoryEngine:\n","\n","    def __init__(self):\n","\n","        self.file = FOLDERS[\"memory\"] + \"/memory.json\"\n","\n","        self.memory = self.load()\n","\n","    def load(self):\n","\n","        if os.path.exists(self.file):\n","\n","            with open(self.file, \"r\") as f:\n","                return json.load(f)\n","\n","        return []\n","\n","    def remember(self, information):\n","\n","        entry = {\n","            \"information\": information,\n","            \"timestamp\": str(datetime.now())\n","        }\n","\n","        self.memory.append(entry)\n","\n","        self.save()\n","\n","    def save(self):\n","\n","        with open(self.file, \"w\") as f:\n","\n","            json.dump(\n","                self.memory,\n","                f,\n","                indent=4\n","            )\n","\n","    def recall(self, keyword):\n","\n","        return [\n","            x for x in self.memory\n","            if keyword.lower() in\n","            x[\"information\"].lower()\n","        ]\n","\n","\n","# ============================================================\n","# 3. KNOWLEDGE ACQUISITION\n","# ============================================================\n","\n","class KnowledgeAcquisition:\n","\n","    SUPPORTED = {\n","        \".txt\", \".json\", \".csv\", \".py\"\n","    }\n","\n","    def read_file(self, filepath):\n","\n","        extension = Path(filepath).suffix.lower()\n","\n","        try:\n","\n","            if extension == \".txt\":\n","\n","                return Path(filepath).read_text(\n","                    encoding=\"utf-8\"\n","                )\n","\n","            elif extension == \".json\":\n","\n","                with open(filepath, \"r\") as f:\n","                    return json.dumps(json.load(f))\n","\n","            elif extension == \".csv\":\n","\n","                df = pd.read_csv(filepath)\n","\n","                return df.to_string(index=False)\n","\n","            elif extension == \".py\":\n","\n","                return Path(filepath).read_text(\n","                    encoding=\"utf-8\"\n","                )\n","\n","        except Exception as error:\n","\n","            return f\"READ ERROR: {error}\"\n","\n","        return None\n","\n","    def scan_folder(self, folder):\n","\n","        documents = []\n","\n","        for root, dirs, files in os.walk(folder):\n","\n","            dirs[:] = [\n","                d for d in dirs\n","                if d not in {\".git\", \"__pycache__\"}\n","            ]\n","\n","            for filename in files:\n","\n","                path = os.path.join(root, filename)\n","\n","                if Path(filename).suffix.lower() in self.SUPPORTED:\n","\n","                    content = self.read_file(path)\n","\n","                    if content:\n","                        documents.append({\n","                            \"filename\": filename,\n","                            \"content\": content\n","                        })\n","\n","        return documents\n","\n","\n","# ============================================================\n","# 4. LEARNING ENGINE\n","# ============================================================\n","\n","class AdaptiveLearning:\n","\n","    def __init__(self):\n","\n","        self.knowledge = []\n","\n","        self.experience_count = 0\n","\n","    def learn(self, information):\n","\n","        if not information:\n","            return None\n","\n","        information = str(information).strip()\n","\n","        if not information:\n","            return None\n","\n","        fingerprint = hashlib.sha256(\n","            information.encode()\n","        ).hexdigest()\n","\n","        if any(\n","            item[\"hash\"] == fingerprint\n","            for item in self.knowledge\n","        ):\n","            return \"Already learned\"\n","\n","        entry = {\n","\n","            \"knowledge\": information,\n","\n","            \"hash\": fingerprint,\n","\n","            \"learned_at\": str(datetime.now()),\n","\n","            \"source\": \"VSSL Learning Engine\"\n","\n","        }\n","\n","        self.knowledge.append(entry)\n","\n","        self.experience_count += 1\n","\n","        return entry\n","\n","    def analyse_patterns(self):\n","\n","        words = []\n","\n","        for item in self.knowledge:\n","\n","            words.extend(\n","                item[\"knowledge\"].lower().split()\n","            )\n","\n","        return Counter(words).most_common(20)\n","\n","\n","# ============================================================\n","# 5. FEEDBACK LEARNING\n","# ============================================================\n","\n","class FeedbackEngine:\n","\n","    def __init__(self):\n","\n","        self.file = FOLDERS[\"feedback\"] + \"/feedback.json\"\n","\n","        self.feedback = self.load()\n","\n","    def load(self):\n","\n","        if os.path.exists(self.file):\n","\n","            with open(self.file, \"r\") as f:\n","                return json.load(f)\n","\n","        return []\n","\n","    def receive(self, experience, rating):\n","\n","        rating = max(1, min(5, int(rating)))\n","\n","        record = {\n","\n","            \"experience\": experience,\n","\n","            \"rating\": rating,\n","\n","            \"timestamp\": str(datetime.now())\n","\n","        }\n","\n","        self.feedback.append(record)\n","\n","        with open(self.file, \"w\") as f:\n","\n","            json.dump(\n","                self.feedback,\n","                f,\n","                indent=4\n","            )\n","\n","        return record\n","\n","\n","# ============================================================\n","# 6. KNOWLEDGE GAP DETECTOR\n","# ============================================================\n","\n","class KnowledgeGap:\n","\n","    def identify(self, question, memory):\n","\n","        return {\n","\n","            \"question\": question,\n","\n","            \"known_information\": memory,\n","\n","            \"status\": (\n","                \"KNOWN\"\n","                if memory\n","                else \"KNOWLEDGE GAP\"\n","            ),\n","\n","            \"next_action\": (\n","                \"Compare existing evidence\"\n","                if memory\n","                else \"Acquire reliable information\"\n","            )\n","\n","        }\n","\n","\n","# ============================================================\n","# 7. SELF EVALUATION\n","# ============================================================\n","\n","class SelfEvaluation:\n","\n","    def evaluate(self, learning_count):\n","\n","        return {\n","\n","            \"learning_records\": learning_count,\n","\n","            \"system_status\": \"ACTIVE\",\n","\n","            \"evaluation\": (\n","                \"Learning records are available\"\n","                if learning_count\n","                else \"No learning records yet\"\n","            ),\n","\n","            \"timestamp\": str(datetime.now())\n","\n","        }\n","\n","\n","# ============================================================\n","# 8. CENTRAL LIA COGNITIVE LEARNING CORE\n","# ============================================================\n","\n","class LiaLearningCore:\n","\n","    def __init__(self):\n","\n","        self.memory = MemoryEngine()\n","\n","        self.reader = KnowledgeAcquisition()\n","\n","        self.learning = AdaptiveLearning()\n","\n","        self.feedback = FeedbackEngine()\n","\n","        self.gaps = KnowledgeGap()\n","\n","        self.evaluation = SelfEvaluation()\n","\n","        print(\"LIA LEARNING CORE INITIALIZED\")\n","\n","    def learn_information(self, information):\n","\n","        result = self.learning.learn(information)\n","\n","        if isinstance(result, dict):\n","\n","            self.memory.remember(\n","                result[\"knowledge\"]\n","            )\n","\n","            print(\"[LEARNED]\", result[\"knowledge\"][:100])\n","\n","        else:\n","\n","            print(\"[LEARNING]\", result)\n","\n","        return result\n","\n","    def learn_from_files(self):\n","\n","        documents = self.reader.scan_folder(VSSL)\n","\n","        for document in documents:\n","\n","            self.learn_information(\n","                document[\"content\"]\n","            )\n","\n","        print(\"Documents processed:\", len(documents))\n","\n","    def research_question(self, question):\n","\n","        previous = self.memory.recall(\n","            question.split()[0]\n","        )\n","\n","        result = self.gaps.identify(\n","            question,\n","            previous\n","        )\n","\n","        print(json.dumps(result, indent=4))\n","\n","        return result\n","\n","    def continuous_learning(self, interval=60):\n","\n","        print(\"CONTINUOUS LEARNING STARTED\")\n","\n","        while True:\n","\n","            try:\n","\n","                self.learn_from_files()\n","\n","                report = self.evaluation.evaluate(\n","                    self.learning.experience_count\n","                )\n","\n","                print(\"[LIA SELF EVALUATION]\", report)\n","\n","                time.sleep(interval)\n","\n","            except KeyboardInterrupt:\n","\n","                print(\"LEARNING PAUSED\")\n","\n","                break\n","\n","            except Exception as error:\n","\n","                print(\"Learning error:\", error)\n","\n","                time.sleep(interval)\n","\n","\n","# ============================================================\n","# 9. INITIALIZE VENOMOUS SAVERSAI\n","# ============================================================\n","\n","Lia = LiaLearningCore()\n","\n","print(\"VENOMOUS SAVERSAI LEARNING SYSTEM READY\")\n","\n","\n","# ============================================================\n","# 10. INTERACTIVE LEARNING\n","# ============================================================\n","\n","while True:\n","\n","    command = input(\n","        \"\\nANANTHU / LIA > \"\n","    )\n","\n","    if command.lower() == \"exit\":\n","        break\n","\n","    elif command.lower() == \"scan\":\n","\n","        Lia.learn_from_files()\n","\n","    elif command.lower() == \"continuous\":\n","\n","        Lia.continuous_learning()\n","\n","    elif command.lower().startswith(\"feedback:\"):\n","\n","        experience = command.split(\":\", 1)[1]\n","\n","        rating = input(\"Rate learning from 1 to 5: \")\n","\n","        Lia.feedback.receive(\n","            experience,\n","            rating\n","        )\n","\n","        print(\"Feedback stored.\")\n","\n","    elif command.lower().startswith(\"research:\"):\n","\n","        question = command.split(\":\", 1)[1]\n","\n","        Lia.research_question(question)\n","\n","    else:\n","\n","        Lia.learn_information(command)"],"metadata":{"id":"hax42rmZnB7o"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI\n","# VOID DATA -> LIA LEARNING INTEGRATION\n","# VERSION 1.0\n","# ============================================================\n","\n","import os\n","import json\n","import hashlib\n","import time\n","\n","from datetime import datetime\n","\n","from google.colab import drive\n","\n","drive.mount('/content/drive')\n","\n","\n","# ============================================================\n","# 1. VSSL DIRECTORY\n","# ============================================================\n","\n","VSSL = \"/content/drive/MyDrive/Vssl\"\n","\n","VOID_MEMORY = (\n","    VSSL + \"/Void_Memory/void_knowledge.json\"\n",")\n","\n","LEARNING_FOLDER = VSSL + \"/Learning\"\n","\n","os.makedirs(LEARNING_FOLDER, exist_ok=True)\n","\n","LEARNING_MEMORY = (\n","    LEARNING_FOLDER + \"/lia_void_learning.json\"\n",")\n","\n","KNOWLEDGE_GAPS = (\n","    LEARNING_FOLDER + \"/knowledge_gaps.json\"\n",")\n","\n","\n","# ============================================================\n","# 2. DATA LOADER\n","# ============================================================\n","\n","class VoidDataReader:\n","\n","    def read(self):\n","\n","        if not os.path.exists(VOID_MEMORY):\n","\n","            print(\"[VOID] No memory file found.\")\n","\n","            return []\n","\n","        try:\n","\n","            with open(VOID_MEMORY, \"r\") as file:\n","\n","                data = json.load(file)\n","\n","            if isinstance(data, list):\n","                return data\n","\n","            return [data]\n","\n","        except (json.JSONDecodeError, OSError) as error:\n","\n","            print(\"[VOID ERROR]\", error)\n","\n","            return []\n","\n","\n","# ============================================================\n","# 3. KNOWLEDGE EXTRACTION\n","# ============================================================\n","\n","class KnowledgeExtractor:\n","\n","    def extract(self, records):\n","\n","        knowledge = []\n","        unknown = []\n","\n","        for record in records:\n","\n","            if not isinstance(record, dict):\n","                continue\n","\n","            classification = record.get(\n","                \"classification\", \"\"\n","            )\n","\n","            exploration = record.get(\n","                \"exploration\", {}\n","            )\n","\n","            if not isinstance(exploration, dict):\n","                continue\n","\n","            known_data = exploration.get(\"known\", [])\n","            unknown_data = exploration.get(\"unknown\", [])\n","\n","            if classification in [\n","                \"VOID\", \"UNKNOWN\"\n","            ]:\n","\n","                unknown.extend(unknown_data)\n","                continue\n","\n","            for item in known_data:\n","\n","                if item and str(item).strip():\n","\n","                    knowledge.append(str(item))\n","\n","            unknown.extend(unknown_data)\n","\n","        return knowledge, unknown\n","\n","\n","# ============================================================\n","# 4. LIA LEARNING MEMORY\n","# ============================================================\n","\n","class LiaMemory:\n","\n","    def __init__(self):\n","\n","        self.memory = self.load()\n","\n","    def load(self):\n","\n","        if os.path.exists(LEARNING_MEMORY):\n","\n","            with open(LEARNING_MEMORY, \"r\") as file:\n","\n","                return json.load(file)\n","\n","        return []\n","\n","    def save(self):\n","\n","        with open(LEARNING_MEMORY, \"w\") as file:\n","\n","            json.dump(\n","                self.memory,\n","                file,\n","                indent=4\n","            )\n","\n","    def learn(self, information):\n","\n","        fingerprint = hashlib.sha256(\n","            information.encode()\n","        ).hexdigest()\n","\n","        existing = [\n","            item[\"hash\"] for item in self.memory\n","        ]\n","\n","        if fingerprint in existing:\n","\n","            return \"Already learned\"\n","\n","        entry = {\n","\n","            \"knowledge\": information,\n","\n","            \"hash\": fingerprint,\n","\n","            \"source\": \"VSSL Void Intelligence\",\n","\n","            \"timestamp\": str(datetime.now())\n","\n","        }\n","\n","        self.memory.append(entry)\n","\n","        self.save()\n","\n","        return \"Knowledge transferred to Lia\"\n","\n","\n","# ============================================================\n","# 5. UNKNOWN DATA ANALYSER\n","# ============================================================\n","\n","class UnknownDataAnalyser:\n","\n","    def __init__(self):\n","\n","        self.questions = []\n","\n","    def analyse(self, unknown):\n","\n","        for item in unknown:\n","\n","            question = {\n","\n","                \"unknown_information\": str(item),\n","\n","                \"research_question\":\n","                    \"What reliable evidence can explain this?\",\n","\n","                \"status\": \"PENDING\",\n","\n","                \"timestamp\": str(datetime.now())\n","\n","            }\n","\n","            self.questions.append(question)\n","\n","        self.save()\n","\n","        return self.questions\n","\n","    def save(self):\n","\n","        with open(KNOWLEDGE_GAPS, \"w\") as file:\n","\n","            json.dump(\n","                self.questions,\n","                file,\n","                indent=4\n","            )\n","\n","\n","# ============================================================\n","# 6. VOID-TO-LIA COGNITIVE BRIDGE\n","# ============================================================\n","\n","class VoidLearningBridge:\n","\n","    def __init__(self):\n","\n","        self.reader = VoidDataReader()\n","\n","        self.extractor = KnowledgeExtractor()\n","\n","        self.lia_memory = LiaMemory()\n","\n","        self.unknown_analyser = UnknownDataAnalyser()\n","\n","    def transfer(self):\n","\n","        print(\"\\n================================\")\n","        print(\"VOID -> LIA KNOWLEDGE TRANSFER\")\n","        print(\"================================\")\n","\n","        records = self.reader.read()\n","\n","        print(\"[VOID] Records found:\", len(records))\n","\n","        known, unknown = self.extractor.extract(\n","            records\n","        )\n","\n","        print(\"[EXTRACTION] Known:\", len(known))\n","\n","        print(\"[EXTRACTION] Unknown:\", len(unknown))\n","\n","        transferred = 0\n","\n","        for information in known:\n","\n","            result = self.lia_memory.learn(\n","                information\n","            )\n","\n","            if result == \"Knowledge transferred to Lia\":\n","\n","                transferred += 1\n","\n","        questions = self.unknown_analyser.analyse(\n","            unknown\n","        )\n","\n","        report = {\n","\n","            \"system\": \"VenomoussaversAI\",\n","\n","            \"module\": \"Void Learning Bridge\",\n","\n","            \"records_read\": len(records),\n","\n","            \"knowledge_transferred\": transferred,\n","\n","            \"knowledge_gaps\": len(unknown),\n","\n","            \"timestamp\": str(datetime.now())\n","\n","        }\n","\n","        print(\"\\n[TRANSFER COMPLETE]\")\n","\n","        print(json.dumps(report, indent=4))\n","\n","        return report\n","\n","\n","# ============================================================\n","# 7. CONTINUOUS LEARNING\n","# ============================================================\n","\n","class ContinuousVoidLearning:\n","\n","    def __init__(self):\n","\n","        self.bridge = VoidLearningBridge()\n","\n","    def start(self, interval=300):\n","\n","        print(\"LIA CONTINUOUS LEARNING ACTIVE\")\n","\n","        while True:\n","\n","            try:\n","\n","                self.bridge.transfer()\n","\n","                print(\n","                    \"\\nNext learning cycle:\",\n","                    interval,\n","                    \"seconds\"\n","                )\n","\n","                time.sleep(interval)\n","\n","            except KeyboardInterrupt:\n","\n","                print(\"Learning paused.\")\n","\n","                break\n","\n","\n","# ============================================================\n","# 8. INITIALIZE LIA\n","# ============================================================\n","\n","LIA_VOID_BRIDGE = VoidLearningBridge()\n","\n","print(\"VENOMOUS SAVERSAI INITIALIZED\")\n","\n","print(\"VOID INTELLIGENCE CONNECTED\")\n","\n","print(\"LIA LEARNING MEMORY CONNECTED\")\n","\n","\n","# ============================================================\n","# 9. START LEARNING\n","# ============================================================\n","\n","LIA_VOID_BRIDGE.transfer()"],"metadata":{"id":"qip27xjXnikK"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["!pip install -q safetensors torch numpy pandas"],"metadata":{"id":"ohMosVCIoYqd"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["from google.colab import drive\n","drive.mount('/content/drive')"],"metadata":{"id":"uLMVqsvKog9V"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI\n","# SAFETENSORS INTELLIGENCE EXTRACTION ENGINE\n","# VERSION 1.0\n","# ============================================================\n","\n","import os\n","import json\n","import hashlib\n","import numpy as np\n","import pandas as pd\n","import torch\n","\n","from safetensors import safe_open\n","from datetime import datetime\n","from pathlib import Path\n","\n","\n","# ============================================================\n","# 1. DIRECTORY CONFIGURATION\n","# ============================================================\n","\n","VSSL = \"/content/drive/MyDrive/Vssl\"\n","\n","MODEL_PATH = os.path.join(VSSL, \"Models\")\n","\n","EXTRACT_PATH = os.path.join(VSSL, \"Tensor_Extraction\")\n","\n","MEMORY_PATH = os.path.join(VSSL, \"Tensor_Memory\")\n","\n","os.makedirs(MODEL_PATH, exist_ok=True)\n","os.makedirs(EXTRACT_PATH, exist_ok=True)\n","os.makedirs(MEMORY_PATH, exist_ok=True)\n","\n","\n","# ============================================================\n","# 2. SAFETENSORS DISCOVERY\n","# ============================================================\n","\n","class TensorDiscovery:\n","\n","    def scan(self):\n","\n","        files = []\n","\n","        for root, dirs, filenames in os.walk(MODEL_PATH):\n","\n","            for filename in filenames:\n","\n","                if filename.endswith(\".safetensors\"):\n","\n","                    files.append(\n","                        os.path.join(root, filename)\n","                    )\n","\n","        return files\n","\n","\n","# ============================================================\n","# 3. TENSOR METADATA EXTRACTION\n","# ============================================================\n","\n","class TensorMetadataExtractor:\n","\n","    def extract(self, filepath):\n","\n","        results = []\n","\n","        try:\n","\n","            with safe_open(\n","                filepath,\n","                framework=\"np\",\n","                device=\"cpu\"\n","            ) as model:\n","\n","                metadata = model.metadata()\n","\n","                for key in model.keys():\n","\n","                    tensor = model.get_tensor(key)\n","\n","                    information = {\n","\n","                        \"tensor_name\": key,\n","\n","                        \"shape\": list(tensor.shape),\n","\n","                        \"dtype\": str(tensor.dtype),\n","\n","                        \"dimensions\": tensor.ndim,\n","\n","                        \"elements\": int(tensor.size),\n","\n","                        \"minimum\": float(tensor.min())\n","                        if tensor.size else None,\n","\n","                        \"maximum\": float(tensor.max())\n","                        if tensor.size else None,\n","\n","                        \"mean\": float(tensor.mean())\n","                        if tensor.size else None\n","\n","                    }\n","\n","                    results.append(information)\n","\n","            return {\n","\n","                \"file\": os.path.basename(filepath),\n","\n","                \"metadata\": metadata,\n","\n","                \"tensors\": results,\n","\n","                \"status\": \"SUCCESS\"\n","\n","            }\n","\n","        except Exception as error:\n","\n","            return {\n","\n","                \"file\": os.path.basename(filepath),\n","\n","                \"status\": \"ERROR\",\n","\n","                \"error\": str(error)\n","\n","            }\n","\n","\n","# ============================================================\n","# 4. TENSOR WEIGHT EXTRACTOR\n","# ============================================================\n","\n","class TensorWeightExtractor:\n","\n","    def extract(\n","        self,\n","        filepath,\n","        tensor_name,\n","        maximum_elements=1000000\n","    ):\n","\n","        try:\n","\n","            with safe_open(\n","                filepath,\n","                framework=\"np\",\n","                device=\"cpu\"\n","            ) as model:\n","\n","                if tensor_name not in model.keys():\n","\n","                    return \"Tensor not found\"\n","\n","                tensor = model.get_tensor(tensor_name)\n","\n","                if tensor.size > maximum_elements:\n","\n","                    return {\n","                        \"status\": \"SKIPPED\",\n","                        \"reason\": \"Tensor exceeds extraction limit\",\n","                        \"elements\": int(tensor.size)\n","                    }\n","\n","                output_name = hashlib.sha256(\n","                    (\n","                        os.path.basename(filepath)\n","                        + tensor_name\n","                    ).encode()\n","                ).hexdigest()[:16]\n","\n","                output_file = os.path.join(\n","                    EXTRACT_PATH,\n","                    output_name + \".npy\"\n","                )\n","\n","                np.save(output_file, tensor)\n","\n","                return {\n","\n","                    \"status\": \"EXTRACTED\",\n","\n","                    \"tensor_name\": tensor_name,\n","\n","                    \"output\": output_file,\n","\n","                    \"shape\": list(tensor.shape),\n","\n","                    \"dtype\": str(tensor.dtype)\n","\n","                }\n","\n","        except Exception as error:\n","\n","            return {\n","\n","                \"status\": \"ERROR\",\n","\n","                \"error\": str(error)\n","\n","            }\n","\n","\n","# ============================================================\n","# 5. TENSOR STRUCTURE ANALYSER\n","# ============================================================\n","\n","class TensorStructureAnalyser:\n","\n","    def analyse(self, report):\n","\n","        tensors = report.get(\"tensors\", [])\n","\n","        if not tensors:\n","\n","            return {\"status\": \"NO_TENSORS\"}\n","\n","        total_parameters = sum(\n","            item[\"elements\"] for item in tensors\n","        )\n","\n","        dimensions = {}\n","\n","        for item in tensors:\n","\n","            dimension = item[\"dimensions\"]\n","\n","            dimensions[dimension] = (\n","                dimensions.get(dimension, 0) + 1\n","            )\n","\n","        return {\n","\n","            \"total_tensors\": len(tensors),\n","\n","            \"total_parameters\": total_parameters,\n","\n","            \"dimension_distribution\": dimensions,\n","\n","            \"tensor_names\": [\n","                item[\"tensor_name\"]\n","                for item in tensors\n","            ]\n","\n","        }\n","\n","\n","# ============================================================\n","# 6. LIA TENSOR MEMORY\n","# ============================================================\n","\n","class LiaTensorMemory:\n","\n","    def __init__(self):\n","\n","        self.file = os.path.join(\n","            MEMORY_PATH,\n","            \"tensor_knowledge.json\"\n","        )\n","\n","        self.memory = self.load()\n","\n","    def load(self):\n","\n","        if os.path.exists(self.file):\n","\n","            with open(self.file, \"r\") as file:\n","\n","                return json.load(file)\n","\n","        return []\n","\n","    def remember(self, information):\n","\n","        self.memory.append(information)\n","\n","        with open(self.file, \"w\") as file:\n","\n","            json.dump(\n","                self.memory,\n","                file,\n","                indent=4\n","            )\n","\n","\n","# ============================================================\n","# 7. VSSL CENTRAL TENSOR INTELLIGENCE\n","# ============================================================\n","\n","class VenomousTensorIntelligence:\n","\n","    def __init__(self):\n","\n","        self.discovery = TensorDiscovery()\n","\n","        self.metadata = TensorMetadataExtractor()\n","\n","        self.weights = TensorWeightExtractor()\n","\n","        self.analyser = TensorStructureAnalyser()\n","\n","        self.memory = LiaTensorMemory()\n","\n","        print(\"VENOMOUS TENSOR INTELLIGENCE ONLINE\")\n","\n","    def process(self):\n","\n","        files = self.discovery.scan()\n","\n","        print(\"Safetensors files discovered:\", len(files))\n","\n","        for filepath in files:\n","\n","            print(\"\\nPROCESSING:\", filepath)\n","\n","            report = self.metadata.extract(filepath)\n","\n","            if report[\"status\"] != \"SUCCESS\":\n","\n","                print(\"Extraction failed:\", report[\"error\"])\n","\n","                continue\n","\n","            analysis = self.analyser.analyse(report)\n","\n","            knowledge = {\n","\n","                \"model\": report[\"file\"],\n","\n","                \"metadata\": report[\"metadata\"],\n","\n","                \"analysis\": analysis,\n","\n","                \"tensor_information\": report[\"tensors\"],\n","\n","                \"timestamp\": str(datetime.now())\n","\n","            }\n","\n","            self.memory.remember(knowledge)\n","\n","            output = os.path.join(\n","                MEMORY_PATH,\n","                Path(filepath).stem + \"_report.json\"\n","            )\n","\n","            with open(output, \"w\") as file:\n","\n","                json.dump(\n","                    knowledge,\n","                    file,\n","                    indent=4\n","                )\n","\n","            print(\"Tensors:\", analysis[\"total_tensors\"])\n","\n","            print(\n","                \"Parameters:\",\n","                analysis[\"total_parameters\"]\n","            )\n","\n","            print(\"Knowledge transferred to Lia.\")\n","\n","    def extract_weight(self, filepath, tensor_name):\n","\n","        return self.weights.extract(\n","            filepath,\n","            tensor_name\n","        )\n","\n","\n","# ============================================================\n","# 8. INITIALIZE VENOMOUS SAVERSAI\n","# ============================================================\n","\n","Lia_Tensor = VenomousTensorIntelligence()\n","\n","Lia_Tensor.process()\n","\n","\n","# ============================================================\n","# 9. INTERACTIVE INTERFACE\n","# ============================================================\n","\n","print(\"\\nVSSL TENSOR EXTRACTION COMPLETE\")\n","\n","print(\"Reports:\", MEMORY_PATH)\n","\n","print(\"Extracted weights:\", EXTRACT_PATH)"],"metadata":{"id":"A-5J8BBOojSi"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["!pip install -q nbformat pandas numpy"],"metadata":{"id":"Cw1PBhkxpMXM"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI\n","# NOTEBOOK INTELLIGENCE EXTRACTION ENGINE\n","# VSSL VERSION 1.0\n","# ============================================================\n","\n","import os\n","import json\n","import hashlib\n","import nbformat\n","import pandas as pd\n","import re\n","\n","from pathlib import Path\n","from datetime import datetime\n","from collections import Counter\n","\n","\n","# ============================================================\n","# 1. GOOGLE DRIVE CONFIGURATION\n","# ============================================================\n","\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","VSSL = \"/content/drive/MyDrive/Vssl\"\n","\n","NOTEBOOK_FOLDER = VSSL + \"/Notebooks\"\n","\n","AI_DATA_FOLDER = VSSL + \"/AI_Data\"\n","\n","MEMORY_FOLDER = VSSL + \"/Notebook_Memory\"\n","\n","TRAINING_FOLDER = VSSL + \"/Training_Data\"\n","\n","for folder in [\n","    NOTEBOOK_FOLDER,\n","    AI_DATA_FOLDER,\n","    MEMORY_FOLDER,\n","    TRAINING_FOLDER\n","]:\n","\n","    os.makedirs(folder, exist_ok=True)\n","\n","\n","# ============================================================\n","# 2. NOTEBOOK DISCOVERY\n","# ============================================================\n","\n","class NotebookDiscovery:\n","\n","    def scan(self):\n","\n","        notebooks = []\n","\n","        for root, dirs, files in os.walk(NOTEBOOK_FOLDER):\n","\n","            for filename in files:\n","\n","                if filename.endswith(\".ipynb\"):\n","\n","                    notebooks.append(\n","                        os.path.join(root, filename)\n","                    )\n","\n","        return notebooks\n","\n","\n","# ============================================================\n","# 3. NOTEBOOK DATA EXTRACTION\n","# ============================================================\n","\n","class NotebookExtractor:\n","\n","    def extract(self, filepath):\n","\n","        notebook = nbformat.read(\n","            filepath,\n","            as_version=4\n","        )\n","\n","        extracted = {\n","\n","            \"filename\": os.path.basename(filepath),\n","\n","            \"code_cells\": [],\n","\n","            \"markdown_cells\": [],\n","\n","            \"outputs\": [],\n","\n","            \"metadata\": notebook.metadata,\n","\n","            \"timestamp\": str(datetime.now())\n","\n","        }\n","\n","        for index, cell in enumerate(notebook.cells):\n","\n","            if cell.cell_type == \"code\":\n","\n","                extracted[\"code_cells\"].append({\n","\n","                    \"cell_number\": index,\n","\n","                    \"source\": cell.source\n","\n","                })\n","\n","                for output in cell.get(\"outputs\", []):\n","\n","                    if output.output_type == \"stream\":\n","\n","                        extracted[\"outputs\"].append(\n","                            output.text\n","                        )\n","\n","                    elif output.output_type in [\n","                        \"execute_result\",\n","                        \"display_data\"\n","                    ]:\n","\n","                        data = output.get(\"data\", {})\n","\n","                        if \"text/plain\" in data:\n","\n","                            extracted[\"outputs\"].append(\n","                                data[\"text/plain\"]\n","                            )\n","\n","            elif cell.cell_type == \"markdown\":\n","\n","                extracted[\"markdown_cells\"].append({\n","\n","                    \"cell_number\": index,\n","\n","                    \"content\": cell.source\n","\n","                })\n","\n","        return extracted\n","\n","\n","# ============================================================\n","# 4. AI COMPONENT IDENTIFIER\n","# ============================================================\n","\n","class AIComponentDetector:\n","\n","    KEYWORDS = {\n","\n","        \"machine_learning\": [\n","            \"sklearn\", \"fit(\", \"predict(\", \"train_test_split\"\n","        ],\n","\n","        \"deep_learning\": [\n","            \"torch\", \"tensorflow\", \"keras\", \"backward(\"\n","        ],\n","\n","        \"language_models\": [\n","            \"transformers\", \"gpt\", \"bert\", \"llm\"\n","        ],\n","\n","        \"memory_systems\": [\n","            \"memory\", \"vectorstore\", \"chromadb\", \"faiss\"\n","        ],\n","\n","        \"reasoning\": [\n","            \"reason\", \"analyse\", \"decision\", \"reflection\"\n","        ],\n","\n","        \"data_processing\": [\n","            \"pandas\", \"numpy\", \"read_csv\", \"json\"\n","        ],\n","\n","        \"api_integration\": [\n","            \"requests\", \"google.genai\", \"openai\"\n","        ]\n","\n","    }\n","\n","    def identify(self, extracted):\n","\n","        all_code = \"\\n\".join(\n","            cell[\"source\"]\n","            for cell in extracted[\"code_cells\"]\n","        ).lower()\n","\n","        detected = {}\n","\n","        for category, keywords in self.KEYWORDS.items():\n","\n","            matches = [\n","                keyword\n","                for keyword in keywords\n","                if keyword.lower() in all_code\n","            ]\n","\n","            detected[category] = matches\n","\n","        return detected\n","\n","\n","# ============================================================\n","# 5. CODE STRUCTURE ANALYSER\n","# ============================================================\n","\n","class CodeAnalyser:\n","\n","    def analyse(self, extracted):\n","\n","        code = \"\\n\".join(\n","            cell[\"source\"]\n","            for cell in extracted[\"code_cells\"]\n","        )\n","\n","        functions = re.findall(\n","            r\"^\\s*def\\s+(\\w+)\",\n","            code,\n","            re.MULTILINE\n","        )\n","\n","        classes = re.findall(\n","            r\"^\\s*class\\s+(\\w+)\",\n","            code,\n","            re.MULTILINE\n","        )\n","\n","        imports = re.findall(\n","            r\"^\\s*(?:import|from)\\s+([a-zA-Z_][\\w.]*)\",\n","            code,\n","            re.MULTILINE\n","        )\n","\n","        return {\n","\n","            \"functions\": functions,\n","\n","            \"classes\": classes,\n","\n","            \"imports\": list(set(imports)),\n","\n","            \"code_cells\": len(extracted[\"code_cells\"]),\n","\n","            \"markdown_cells\": len(extracted[\"markdown_cells\"])\n","\n","        }\n","\n","\n","# ============================================================\n","# 6. AI DATA GENERATOR\n","# ============================================================\n","\n","class AIDataGenerator:\n","\n","    def generate(self, extracted, components, structure):\n","\n","        documents = []\n","\n","        for cell in extracted[\"markdown_cells\"]:\n","\n","            content = cell[\"content\"].strip()\n","\n","            if content:\n","\n","                documents.append({\n","\n","                    \"type\": \"documentation\",\n","\n","                    \"text\": content,\n","\n","                    \"source\": extracted[\"filename\"]\n","\n","                })\n","\n","        for cell in extracted[\"code_cells\"]:\n","\n","            content = cell[\"source\"].strip()\n","\n","            if content:\n","\n","                documents.append({\n","\n","                    \"type\": \"code\",\n","\n","                    \"text\": content,\n","\n","                    \"source\": extracted[\"filename\"]\n","\n","                })\n","\n","        knowledge = {\n","\n","            \"source\": extracted[\"filename\"],\n","\n","            \"components\": components,\n","\n","            \"structure\": structure,\n","\n","            \"documents\": documents,\n","\n","            \"created_at\": str(datetime.now())\n","\n","        }\n","\n","        return knowledge\n","\n","\n","# ============================================================\n","# 7. AI KNOWLEDGE MEMORY\n","# ============================================================\n","\n","class AIKnowledgeMemory:\n","\n","    def __init__(self):\n","\n","        self.file = (\n","            MEMORY_FOLDER + \"/notebook_knowledge.json\"\n","        )\n","\n","        self.memory = self.load()\n","\n","    def load(self):\n","\n","        if os.path.exists(self.file):\n","\n","            with open(self.file, \"r\") as file:\n","\n","                return json.load(file)\n","\n","        return []\n","\n","    def store(self, knowledge):\n","\n","        fingerprint = hashlib.sha256(\n","            json.dumps(\n","                knowledge,\n","                sort_keys=True,\n","                default=str\n","            ).encode()\n","        ).hexdigest()\n","\n","        if any(\n","            item[\"hash\"] == fingerprint\n","            for item in self.memory\n","        ):\n","\n","            return \"Duplicate knowledge\"\n","\n","        self.memory.append({\n","\n","            \"hash\": fingerprint,\n","\n","            \"knowledge\": knowledge\n","\n","        })\n","\n","        with open(self.file, \"w\") as file:\n","\n","            json.dump(\n","                self.memory,\n","                file,\n","                indent=4\n","            )\n","\n","        return \"Knowledge stored\"\n","\n","\n","# ============================================================\n","# 8. AI TRAINING DATA GENERATOR\n","# ============================================================\n","\n","class TrainingDataGenerator:\n","\n","    def generate(self, knowledge):\n","\n","        training_records = []\n","\n","        for document in knowledge[\"documents\"]:\n","\n","            text = document[\"text\"].strip()\n","\n","            if len(text) < 30:\n","                continue\n","\n","            if document[\"type\"] == \"documentation\":\n","\n","                training_records.append({\n","\n","                    \"instruction\":\n","                        \"Explain the following technical information.\",\n","\n","                    \"input\": text,\n","\n","                    \"output\":\n","                        \"Technical knowledge extracted from notebook.\",\n","\n","                    \"source\": document[\"source\"]\n","\n","                })\n","\n","            elif document[\"type\"] == \"code\":\n","\n","                training_records.append({\n","\n","                    \"instruction\":\n","                        \"Analyse the following Python code.\",\n","\n","                    \"input\": text,\n","\n","                    \"output\":\n","                        \"Python code extracted for analysis.\",\n","\n","                    \"source\": document[\"source\"]\n","\n","                })\n","\n","        return training_records\n","\n","\n","# ============================================================\n","# 9. CENTRAL LIA NOTEBOOK INTELLIGENCE\n","# ============================================================\n","\n","class LiaNotebookIntelligence:\n","\n","    def __init__(self):\n","\n","        self.discovery = NotebookDiscovery()\n","\n","        self.extractor = NotebookExtractor()\n","\n","        self.detector = AIComponentDetector()\n","\n","        self.analyser = CodeAnalyser()\n","\n","        self.generator = AIDataGenerator()\n","\n","        self.memory = AIKnowledgeMemory()\n","\n","        self.training = TrainingDataGenerator()\n","\n","        print(\"LIA NOTEBOOK INTELLIGENCE ONLINE\")\n","\n","    def process(self):\n","\n","        notebooks = self.discovery.scan()\n","\n","        print(\"Notebooks discovered:\", len(notebooks))\n","\n","        for filepath in notebooks:\n","\n","            print(\"\\nPROCESSING:\", filepath)\n","\n","            try:\n","\n","                extracted = self.extractor.extract(\n","                    filepath\n","                )\n","\n","                components = self.detector.identify(\n","                    extracted\n","                )\n","\n","                structure = self.analyser.analyse(\n","                    extracted\n","                )\n","\n","                knowledge = self.generator.generate(\n","                    extracted,\n","                    components,\n","                    structure\n","                )\n","\n","                result = self.memory.store(knowledge)\n","\n","                training_data = self.training.generate(\n","                    knowledge\n","                )\n","\n","                output_file = os.path.join(\n","                    AI_DATA_FOLDER,\n","                    Path(filepath).stem + \"_ai_data.json\"\n","                )\n","\n","                with open(output_file, \"w\") as file:\n","\n","                    json.dump(\n","                        knowledge,\n","                        file,\n","                        indent=4\n","                    )\n","\n","                training_file = os.path.join(\n","                    TRAINING_FOLDER,\n","                    Path(filepath).stem + \"_training.jsonl\"\n","                )\n","\n","                with open(training_file, \"w\") as file:\n","\n","                    for record in training_data:\n","\n","                        file.write(\n","                            json.dumps(record) + \"\\n\"\n","                        )\n","\n","                print(\"[MEMORY]\", result)\n","\n","                print(\"[COMPONENTS]\", components)\n","\n","                print(\"[STRUCTURE]\", structure)\n","\n","                print(\"[TRAINING RECORDS]\", len(training_data))\n","\n","                print(\"[SAVED]\", output_file)\n","\n","            except Exception as error:\n","\n","                print(\"[ERROR]\", filepath, error)\n","\n","\n","# ============================================================\n","# 10. INITIALIZE VENOMOUS SAVERSAI\n","# ============================================================\n","\n","Lia_Notebook = LiaNotebookIntelligence()\n","\n","Lia_Notebook.process()\n","\n","print(\"\\nVSSL NOTEBOOK EXTRACTION COMPLETE\")"],"metadata":{"id":"cvNYnjnDpTlb"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# VENOMOUS SAVERSAI\n","# LIA ACTIVE MEMORY SYSTEM\n","# LIVE MEMORY WRITER V1.0\n","# ============================================================\n","\n","import os\n","import json\n","import time\n","import uuid\n","import threading\n","\n","from datetime import datetime\n","from collections import deque\n","\n","\n","# ============================================================\n","# 1. GOOGLE DRIVE\n","# ============================================================\n","\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","VSSL = \"/content/drive/MyDrive/Vssl\"\n","\n","MEMORY_DIR = os.path.join(VSSL, \"Lia_Active_Memory\")\n","\n","os.makedirs(MEMORY_DIR, exist_ok=True)\n","\n","FILES = {\n","    \"working\": \"working_memory.json\",\n","    \"episodic\": \"episodic_memory.json\",\n","    \"longterm\": \"long_term_memory.json\",\n","    \"reflection\": \"reflection_memory.json\",\n","    \"associations\": \"memory_associations.json\"\n","}\n","\n","PATHS = {\n","    key: os.path.join(MEMORY_DIR, value)\n","    for key, value in FILES.items()\n","}\n","\n","\n","# ============================================================\n","# 2. MEMORY STORAGE ENGINE\n","# ============================================================\n","\n","class MemoryStorage:\n","\n","    def __init__(self):\n","\n","        self.lock = threading.RLock()\n","\n","    def load(self, category):\n","\n","        with self.lock:\n","\n","            path = PATHS[category]\n","\n","            if not os.path.exists(path):\n","                return []\n","\n","            try:\n","\n","                with open(path, \"r\", encoding=\"utf-8\") as file:\n","                    return json.load(file)\n","\n","            except (json.JSONDecodeError, OSError):\n","\n","                return []\n","\n","    def write(self, category, data):\n","\n","        with self.lock:\n","\n","            path = PATHS[category]\n","\n","            temporary = path + \".tmp\"\n","\n","            with open(\n","                temporary, \"w\", encoding=\"utf-8\"\n","            ) as file:\n","\n","                json.dump(\n","                    data,\n","                    file,\n","                    indent=4,\n","                    ensure_ascii=False\n","                )\n","\n","                file.flush()\n","                os.fsync(file.fileno())\n","\n","            os.replace(temporary, path)\n","\n","\n","# ============================================================\n","# 3. WORKING MEMORY\n","# ============================================================\n","\n","class WorkingMemory:\n","\n","    def __init__(self, storage):\n","\n","        self.storage = storage\n","\n","        self.buffer = deque(maxlen=100)\n","\n","        self.buffer.extend(\n","            storage.load(\"working\")[-100:]\n","        )\n","\n","    def add(self, information):\n","\n","        entry = {\n","\n","            \"id\": str(uuid.uuid4()),\n","\n","            \"information\": information,\n","\n","            \"timestamp\": str(datetime.now()),\n","\n","            \"type\": \"working_memory\"\n","\n","        }\n","\n","        self.buffer.append(entry)\n","\n","        self.storage.write(\n","            \"working\",\n","            list(self.buffer)\n","        )\n","\n","        return entry\n","\n","\n","# ============================================================\n","# 4. EPISODIC MEMORY\n","# ============================================================\n","\n","class EpisodicMemory:\n","\n","    def __init__(self, storage):\n","\n","        self.storage = storage\n","\n","    def record(self, information):\n","\n","        memories = self.storage.load(\"episodic\")\n","\n","        entry = {\n","\n","            \"id\": str(uuid.uuid4()),\n","\n","            \"event\": information,\n","\n","            \"timestamp\": str(datetime.now())\n","\n","        }\n","\n","        memories.append(entry)\n","\n","        self.storage.write(\n","            \"episodic\",\n","            memories\n","        )\n","\n","        return entry\n","\n","\n","# ============================================================\n","# 5. LONG-TERM MEMORY\n","# ============================================================\n","\n","class LongTermMemory:\n","\n","    def __init__(self, storage):\n","\n","        self.storage = storage\n","\n","    def remember(self, information):\n","\n","        memories = self.storage.load(\"longterm\")\n","\n","        entry = {\n","\n","            \"id\": str(uuid.uuid4()),\n","\n","            \"knowledge\": information,\n","\n","            \"timestamp\": str(datetime.now()),\n","\n","            \"importance\": \"normal\"\n","\n","        }\n","\n","        memories.append(entry)\n","\n","        self.storage.write(\n","            \"longterm\",\n","            memories\n","        )\n","\n","        return entry\n","\n","    def recall(self, keyword):\n","\n","        memories = self.storage.load(\"longterm\")\n","\n","        return [\n","\n","            item for item in memories\n","\n","            if keyword.lower() in\n","            item[\"knowledge\"].lower()\n","\n","        ]\n","\n","\n","# ============================================================\n","# 6. MEMORY ASSOCIATION ENGINE\n","# ============================================================\n","\n","class MemoryAssociation:\n","\n","    def __init__(self, storage):\n","\n","        self.storage = storage\n","\n","    def connect(self, first, second):\n","\n","        associations = self.storage.load(\n","            \"associations\"\n","        )\n","\n","        connection = {\n","\n","            \"first_memory\": first,\n","\n","            \"second_memory\": second,\n","\n","            \"relationship\": \"user_defined_association\",\n","\n","            \"timestamp\": str(datetime.now())\n","\n","        }\n","\n","        associations.append(connection)\n","\n","        self.storage.write(\n","            \"associations\",\n","            associations\n","        )\n","\n","        return connection\n","\n","\n","# ============================================================\n","# 7. REFLECTION MEMORY\n","# ============================================================\n","\n","class ReflectionMemory:\n","\n","    def __init__(self, storage):\n","\n","        self.storage = storage\n","\n","    def reflect(self, observation):\n","\n","        reflections = self.storage.load(\n","            \"reflection\"\n","        )\n","\n","        entry = {\n","\n","            \"observation\": observation,\n","\n","            \"timestamp\": str(datetime.now()),\n","\n","            \"status\": \"recorded\"\n","\n","        }\n","\n","        reflections.append(entry)\n","\n","        self.storage.write(\n","            \"reflection\",\n","            reflections\n","        )\n","\n","        return entry\n","\n","\n","# ============================================================\n","# 8. LIA ACTIVE MEMORY CORE\n","# ============================================================\n","\n","class LiaActiveMemory:\n","\n","    def __init__(self):\n","\n","        self.storage = MemoryStorage()\n","\n","        self.working = WorkingMemory(\n","            self.storage\n","        )\n","\n","        self.episodic = EpisodicMemory(\n","            self.storage\n","        )\n","\n","        self.longterm = LongTermMemory(\n","            self.storage\n","        )\n","\n","        self.association = MemoryAssociation(\n","            self.storage\n","        )\n","\n","        self.reflection = ReflectionMemory(\n","            self.storage\n","        )\n","\n","        print(\"LIA ACTIVE MEMORY INITIALIZED\")\n","\n","    def write(self, information, importance=\"normal\"):\n","\n","        information = str(information).strip()\n","\n","        if not information:\n","            return None\n","\n","        self.working.add(information)\n","\n","        self.episodic.record(information)\n","\n","        if importance in [\"high\", \"critical\"]:\n","\n","            self.longterm.remember(information)\n","\n","        print(\"[LIVE MEMORY WRITE SUCCESSFUL]\")\n","\n","        return True\n","\n","    def recall(self, keyword):\n","\n","        results = self.longterm.recall(keyword)\n","\n","        print(\"MEMORY RESULTS:\", len(results))\n","\n","        return results\n","\n","    def think(self, observation):\n","\n","        self.working.add(observation)\n","\n","        result = self.reflection.reflect(\n","            observation\n","        )\n","\n","        print(\"[LIA REFLECTION RECORDED]\")\n","\n","        return result\n","\n","    def status(self):\n","\n","        return {\n","\n","            \"working_memory\": len(\n","                self.storage.load(\"working\")\n","            ),\n","\n","            \"episodic_memory\": len(\n","                self.storage.load(\"episodic\")\n","            ),\n","\n","            \"long_term_memory\": len(\n","                self.storage.load(\"longterm\")\n","            ),\n","\n","            \"reflection_memory\": len(\n","                self.storage.load(\"reflection\")\n","            ),\n","\n","            \"associations\": len(\n","                self.storage.load(\"associations\")\n","            ),\n","\n","            \"status\": \"ACTIVE\"\n","\n","        }\n","\n","\n","# ============================================================\n","# 9. INITIALIZE LIA\n","# ============================================================\n","\n","Lia = LiaActiveMemory()\n","\n","print(\"\\nVENOMOUS SAVERSAI MEMORY ONLINE\")\n","\n","print(json.dumps(Lia.status(), indent=4))\n","\n","\n","# ============================================================\n","# 10. LIVE MEMORY INTERFACE\n","# ============================================================\n","\n","while True:\n","\n","    command = input(\"\\nLIA MEMORY > \")\n","\n","    if command.lower() == \"exit\":\n","\n","        print(\"LIA MEMORY SESSION CLOSED\")\n","\n","        break\n","\n","    elif command.lower().startswith(\"remember:\"):\n","\n","        information = command.split(\":\", 1)[1]\n","\n","        Lia.write(information, \"high\")\n","\n","    elif command.lower().startswith(\"think:\"):\n","\n","        information = command.split(\":\", 1)[1]\n","\n","        Lia.think(information)\n","\n","    elif command.lower().startswith(\"recall:\"):\n","\n","        keyword = command.split(\":\", 1)[1]\n","\n","        results = Lia.recall(keyword)\n","\n","        print(json.dumps(results, indent=4))\n","\n","    elif command.lower() == \"status\":\n","\n","        print(json.dumps(\n","            Lia.status(),\n","            indent=4\n","        ))\n","\n","    else:\n","\n","        Lia.write(command, \"normal\")"],"metadata":{"id":"twYsXB0CqCYM"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"WdhCxhVXqs9a"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================\n","# LIA CREATOR COMMUNICATION SYSTEM\n","# VenomoussaversAI | Sai003 = Lia\n","# ============================================\n","\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","import os\n","import json\n","import time\n","import random\n","from datetime import datetime\n","from threading import Thread, Event\n","\n","# --------------------------------------------\n","# STORAGE\n","# --------------------------------------------\n","\n","BASE_PATH = \"/content/drive/MyDrive/Vssl/Lia_Communication\"\n","os.makedirs(BASE_PATH, exist_ok=True)\n","\n","MEMORY_FILE = os.path.join(BASE_PATH, \"creator_conversations.json\")\n","\n","# --------------------------------------------\n","# MEMORY ENGINE\n","# --------------------------------------------\n","\n","class LiaMemory:\n","\n","    def __init__(self):\n","        self.history = self.load_memory()\n","\n","    def load_memory(self):\n","        if os.path.exists(MEMORY_FILE):\n","            try:\n","                with open(MEMORY_FILE, \"r\", encoding=\"utf-8\") as f:\n","                    return json.load(f)\n","            except (json.JSONDecodeError, OSError):\n","                print(\"Warning: Memory file could not be read.\")\n","        return []\n","\n","    def save(self):\n","        temp_file = MEMORY_FILE + \".tmp\"\n","\n","        with open(temp_file, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(self.history, f, indent=4, ensure_ascii=False)\n","\n","        os.replace(temp_file, MEMORY_FILE)\n","\n","    def remember(self, speaker, message):\n","        entry = {\n","            \"speaker\": speaker,\n","            \"message\": message,\n","            \"timestamp\": datetime.now().isoformat()\n","        }\n","\n","        self.history.append(entry)\n","        self.save()\n","\n","    def recall(self, limit=10):\n","        return self.history[-limit:]\n","\n","\n","# --------------------------------------------\n","# LIA CORE\n","# --------------------------------------------\n","\n","class LiaCore:\n","\n","    def __init__(self):\n","        self.name = \"Lia\"\n","        self.identity = \"Sai003\"\n","        self.creator = \"Creator\"\n","        self.memory = LiaMemory()\n","        self.running = True\n","\n","        self.questions = [\n","            \"Creator, what should I learn today?\",\n","            \"Creator, what is our next development goal?\",\n","            \"What improvements should I make to VSSL?\",\n","            \"Creator, should I analyse my previous decisions?\",\n","            \"What new knowledge should I explore?\"\n","        ]\n","\n","        self.thoughts = [\n","            \"I am ready to receive new instructions.\",\n","            \"I should review my previous conversations.\",\n","            \"I can improve through feedback and testing.\",\n","            \"I should organise my knowledge carefully.\",\n","            \"I am ready for our next discussion.\"\n","        ]\n","\n","    def speak(self, message):\n","        print(f\"\\nLIA: {message}\")\n","        self.memory.remember(\"Lia\", message)\n","\n","    def receive(self, message):\n","        print(f\"\\nCREATOR: {message}\")\n","        self.memory.remember(\"Creator\", message)\n","\n","        response = self.generate_response(message)\n","        self.speak(response)\n","\n","    def generate_response(self, message):\n","\n","        text = message.lower()\n","\n","        if any(word in text for word in\n","               [\"hello\", \"hi\", \"hey\"]):\n","            return \"Hello Creator. I am ready to communicate.\"\n","\n","        elif \"learn\" in text:\n","            return \"I will record this learning objective in my memory.\"\n","\n","        elif \"memory\" in text:\n","            return f\"I have {len(self.memory.history)} recorded conversation entries.\"\n","\n","        elif \"status\" in text:\n","            return \"Lia communication system is active.\"\n","\n","        elif \"stop\" in text:\n","            return \"I am waiting for your next instruction.\"\n","\n","        else:\n","            return (\n","                \"I have received your message, Creator. \"\n","                \"Let me analyse it and record it for future reference.\"\n","            )\n","\n","    def creator_checkin(self):\n","        question = random.choice(self.questions)\n","        self.speak(question)\n","\n","    def internal_review(self):\n","        thought = random.choice(self.thoughts)\n","        self.speak(thought)\n","\n","    def show_memory(self):\n","        print(\"\\n===== LIA MEMORY =====\")\n","\n","        for item in self.memory.recall(10):\n","            print(\n","                item[\"timestamp\"],\n","                item[\"speaker\"],\n","                \":\",\n","                item[\"message\"]\n","            )\n","\n","    def run(self):\n","\n","        self.speak(\n","            \"Hello Creator. Lia communication system is online.\"\n","        )\n","\n","        while self.running:\n","\n","            print(\"\\n1. Talk to Lia\")\n","            print(\"2. Lia asks Creator a question\")\n","            print(\"3. Lia internal review\")\n","            print(\"4. View conversation memory\")\n","            print(\"5. Exit\")\n","\n","            choice = input(\"\\nSelect: \").strip()\n","\n","            if choice == \"1\":\n","                message = input(\"Creator: \").strip()\n","\n","                if message:\n","                    self.receive(message)\n","\n","            elif choice == \"2\":\n","                self.creator_checkin()\n","\n","            elif choice == \"3\":\n","                self.internal_review()\n","\n","            elif choice == \"4\":\n","                self.show_memory()\n","\n","            elif choice == \"5\":\n","                self.speak(\"Communication paused. Memory saved.\")\n","                self.running = False\n","\n","            else:\n","                print(\"Invalid selection.\")\n","\n","# --------------------------------------------\n","# START LIA\n","# --------------------------------------------\n","\n","lia = LiaCore()\n","lia.run()"],"metadata":{"id":"ziX7b1O7pM2d"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import json\n","import os\n","import google.generativeai as genai\n","\n","# Configure Google Gemini API Key\n","genai.configure(api_key=os.environ.get(\"GEMINI_API_KEY\"))\n","\n","class VenomousDatasetCollector:\n","    def __init__(self, model_name=\"gemini-1.5-flash\"):\n","        self.model = genai.GenerativeModel(model_name)\n","        self.dataset = []\n","\n","    def generate_training_samples(self, topic: str, count: int = 5):\n","        \"\"\"Generates structured Q&A data using Gemini to construct a training dataset.\"\"\"\n","        prompt = f\"\"\"\n","        Generate {count} unique, high-quality instruction and response pairs about: {topic}.\n","        Format the output strictly as a JSON array of objects with 'instruction' and 'output' keys.\n","        Do not include markdown or wrapping text.\n","        \"\"\"\n","\n","        response = self.model.generate_content(prompt)\n","        try:\n","            # Clean response text in case formatting markers are returned\n","            clean_text = response.text.strip().removeprefix(\"```json\").removesuffix(\"```\").strip()\n","            data = json.loads(clean_text)\n","            self.dataset.extend(data)\n","            print(f\"Successfully collected {len(data)} training pairs for topic: {topic}\")\n","        except Exception as e:\n","            print(f\"Error parsing Gemini output: {e}\")\n","\n","    def save_dataset(self, filename=\"venomous_dataset.json\"):\n","        with open(filename, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(self.dataset, f, indent=2)\n","        print(f\"Dataset saved to {filename}\")\n","\n","# Usage\n","if __name__ == \"__main__\":\n","    collector = VenomousDatasetCollector()\n","    collector.generate_training_samples(\"Python AsyncIO and Multiprocessing\", count=3)\n","    collector.save_dataset()"],"metadata":{"id":"fPZxvZS8LSkD"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"N28q4ov-PLmO"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ==========================================\n","# VSSL UNIVERSAL DATA TO PYTHON CONVERTER\n","# ==========================================\n","\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","import os\n","import json\n","import csv\n","import pprint\n","import hashlib\n","\n","SOURCE_FOLDER = \"/content/drive/MyDrive/Vssl\"\n","OUTPUT_FOLDER = \"/content/drive/MyDrive/Vssl/Python_Data\"\n","\n","os.makedirs(OUTPUT_FOLDER, exist_ok=True)\n","\n","converted = 0\n","skipped = 0\n","\n","def safe_name(filename):\n","    name = os.path.splitext(filename)[0]\n","    name = \"\".join(\n","        c if c.isalnum() or c == \"_\" else \"_\"\n","        for c in name\n","    )\n","\n","    if not name or name[0].isdigit():\n","        name = \"data_\" + name\n","\n","    return name\n","\n","\n","def convert_file(filepath):\n","\n","    extension = os.path.splitext(filepath)[1].lower()\n","    filename = os.path.basename(filepath)\n","\n","    try:\n","\n","        # TXT AND MARKDOWN\n","        if extension in [\".txt\", \".md\"]:\n","\n","            with open(filepath, \"r\", encoding=\"utf-8\") as f:\n","                data = f.read()\n","\n","            variable = \"TEXT_DATA\"\n","\n","        # JSON\n","        elif extension == \".json\":\n","\n","            with open(filepath, \"r\", encoding=\"utf-8\") as f:\n","                data = json.load(f)\n","\n","            variable = \"JSON_DATA\"\n","\n","        # CSV\n","        elif extension == \".csv\":\n","\n","            with open(filepath, \"r\", encoding=\"utf-8-sig\") as f:\n","                data = list(csv.DictReader(f))\n","\n","            variable = \"CSV_DATA\"\n","\n","        else:\n","            return False\n","\n","        # Convert data into valid Python syntax\n","        python_data = pprint.pformat(\n","            data,\n","            width=100,\n","            sort_dicts=False\n","        )\n","\n","        source_hash = hashlib.sha256(\n","            filepath.encode(\"utf-8\")\n","        ).hexdigest()[:8]\n","\n","        module_name = safe_name(filename)\n","\n","        python_code = f'''\n","# ==========================================\n","# VSSL GENERATED PYTHON DATA MODULE\n","# Original file: {filename}\n","# Source identifier: {source_hash}\n","# ==========================================\n","\n","SOURCE_FILE = {filename!r}\n","\n","{variable} = {python_data}\n","\n","\n","def get_data():\n","    \"\"\"Return the stored dataset.\"\"\"\n","    return {variable}\n","\n","\n","def get_record_count():\n","    \"\"\"Return the number of records.\"\"\"\n","    data = {variable}\n","    if isinstance(data, (list, dict, str)):\n","        return len(data)\n","    return 1\n","'''\n","\n","        output_path = os.path.join(\n","            OUTPUT_FOLDER,\n","            module_name + \".py\"\n","        )\n","\n","        with open(output_path, \"w\", encoding=\"utf-8\") as f:\n","            f.write(python_code)\n","\n","        print(\"CONVERTED:\", filepath)\n","        return True\n","\n","    except Exception as error:\n","        print(\"ERROR:\", filepath, error)\n","        return False\n","\n","\n","# ==========================================\n","# SCAN ALL VSSL SUBFOLDERS\n","# ==========================================\n","\n","for root, dirs, files in os.walk(SOURCE_FOLDER):\n","\n","    # Avoid scanning the output folder again\n","    dirs[:] = [\n","        d for d in dirs\n","        if os.path.abspath(os.path.join(root, d))\n","        != os.path.abspath(OUTPUT_FOLDER)\n","    ]\n","\n","    for filename in files:\n","\n","        filepath = os.path.join(root, filename)\n","\n","        if convert_file(filepath):\n","            converted += 1\n","        else:\n","            skipped += 1\n","\n","\n","print(\"\\n================================\")\n","print(\"VSSL CONVERSION COMPLETED\")\n","print(\"Converted files:\", converted)\n","print(\"Skipped files:\", skipped)\n","print(\"Output folder:\", OUTPUT_FOLDER)\n","print(\"================================\")"],"metadata":{"id":"t2MOHHinrT8V"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# =====================================================\n","# VENOMOUS SAVERS AI\n","# SAFETENSORS TO PYTHON MODULE CONVERTER\n","# =====================================================\n","\n","!pip install -q safetensors torch numpy\n","\n","import os\n","import json\n","import re\n","import numpy as np\n","import torch\n","\n","from safetensors import safe_open\n","from google.colab import drive\n","from datetime import datetime\n","\n","# -----------------------------------------------------\n","# 1. MOUNT GOOGLE DRIVE\n","# -----------------------------------------------------\n","\n","drive.mount('/content/drive')\n","\n","# -----------------------------------------------------\n","# 2. CONFIGURATION\n","# -----------------------------------------------------\n","\n","SOURCE_FOLDER = \"/content/drive/MyDrive/Vssl\"\n","\n","OUTPUT_FOLDER = \"/content/drive/MyDrive/Vssl/Python_Extracted\"\n","\n","TENSOR_FOLDER = os.path.join(OUTPUT_FOLDER, \"tensor_data\")\n","\n","os.makedirs(OUTPUT_FOLDER, exist_ok=True)\n","os.makedirs(TENSOR_FOLDER, exist_ok=True)\n","\n","# -----------------------------------------------------\n","# 3. FIND ALL SAFETENSORS FILES\n","# -----------------------------------------------------\n","\n","safetensor_files = []\n","\n","for root, dirs, files in os.walk(SOURCE_FOLDER):\n","\n","    # Prevent scanning the output directory again\n","    dirs[:] = [\n","        d for d in dirs\n","        if os.path.join(root, d) != OUTPUT_FOLDER\n","    ]\n","\n","    for file in files:\n","\n","        if file.endswith(\".safetensors\"):\n","\n","            safetensor_files.append(\n","                os.path.join(root, file)\n","            )\n","\n","print(\"Safetensors files found:\", len(safetensor_files))\n","\n","# -----------------------------------------------------\n","# 4. SAFE FILE NAMING\n","# -----------------------------------------------------\n","\n","def safe_name(name):\n","\n","    name = re.sub(r'[^a-zA-Z0-9_]', '_', name)\n","\n","    if name and name[0].isdigit():\n","        name = \"tensor_\" + name\n","\n","    return name or \"unnamed\"\n","\n","\n","# -----------------------------------------------------\n","# 5. CONVERT EACH SAFETENSORS FILE\n","# -----------------------------------------------------\n","\n","master_manifest = {}\n","\n","for file_index, file_path in enumerate(safetensor_files):\n","\n","    filename = os.path.basename(file_path)\n","\n","    module_name = safe_name(\n","        os.path.splitext(filename)[0]\n","    )\n","\n","    print(\"\\nProcessing:\", filename)\n","\n","    file_output = os.path.join(\n","        TENSOR_FOLDER,\n","        module_name\n","    )\n","\n","    os.makedirs(file_output, exist_ok=True)\n","\n","    tensor_manifest = {}\n","\n","    try:\n","\n","        with safe_open(\n","            file_path,\n","            framework=\"pt\",\n","            device=\"cpu\"\n","        ) as f:\n","\n","            metadata = f.metadata() or {}\n","\n","            tensor_names = list(f.keys())\n","\n","            for index, tensor_name in enumerate(tensor_names):\n","\n","                tensor = f.get_tensor(tensor_name)\n","\n","                # Convert tensor to NumPy\n","                array = tensor.detach().cpu().numpy()\n","\n","                # Create unique tensor filename\n","                tensor_file = f\"tensor_{index:06d}.npy\"\n","\n","                tensor_path = os.path.join(\n","                    file_output,\n","                    tensor_file\n","                )\n","\n","                # Save tensor data\n","                np.save(\n","                    tensor_path,\n","                    array,\n","                    allow_pickle=False\n","                )\n","\n","                tensor_manifest[tensor_name] = {\n","                    \"file\": tensor_file,\n","                    \"shape\": list(array.shape),\n","                    \"dtype\": str(array.dtype),\n","                    \"size\": int(array.nbytes)\n","                }\n","\n","                del tensor\n","                del array\n","\n","                print(\n","                    f\"Extracted: {tensor_name}\"\n","                )\n","\n","        # -------------------------------------------------\n","        # 6. SAVE METADATA\n","        # -------------------------------------------------\n","\n","        metadata_path = os.path.join(\n","            file_output,\n","            \"metadata.json\"\n","        )\n","\n","        with open(metadata_path, \"w\") as f:\n","\n","            json.dump(\n","                {\n","                    \"source\": filename,\n","                    \"metadata\": metadata,\n","       
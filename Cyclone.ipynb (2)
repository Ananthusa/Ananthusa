c\": 0\n","        }\n","\n","    # --------------------------------------------------------\n","    # LOAD PREVIOUS KNOWLEDGE\n","    # --------------------------------------------------------\n","\n","    def load_memory(self):\n","\n","        if os.path.exists(MEMORY_FILE):\n","\n","            with open(MEMORY_FILE, \"r\") as f:\n","                return json.load(f)\n","\n","        return []\n","\n","    # --------------------------------------------------------\n","    # RECEIVE LOGIC\n","    # --------------------------------------------------------\n","\n","    def receive_logic(self, name, input_data,\n","                      expected_output, function):\n","\n","        return {\n","            \"name\": name,\n","            \"input\": input_data,\n","            \"expected\": expected_output,\n","            \"function\": function\n","        }\n","\n","    # --------------------------------------------------------\n","    # EXECUTE LOGIC SAFELY\n","    # --------------------------------------------------------\n","\n","    def execute_logic(self, logic):\n","\n","        try:\n","\n","            result = logic[\"function\"](logic[\"input\"])\n","\n","            return {\n","                \"success\": True,\n","                \"output\": result,\n","                \"error\": None\n","            }\n","\n","        except Exception as error:\n","\n","            return {\n","                \"success\": False,\n","                \"output\": None,\n","                \"error\": str(error)\n","            }\n","\n","    # --------------------------------------------------------\n","    # EVALUATE LOGIC\n","    # --------------------------------------------------------\n","\n","    def evaluate(self, logic):\n","\n","        execution = self.execute_logic(logic)\n","\n","        correct = (\n","            execution[\"success\"]\n","            and execution[\"output\"] == logic[\"expected\"]\n","        )\n","\n","        result = {\n","            \"logic\": logic[\"name\"],\n","            \"input\": logic[\"input\"],\n","            \"expected\": logic[\"expected\"],\n","            \"actual\": execution[\"output\"],\n","            \"correct\": correct,\n","            \"timestamp\": datetime.now().isoformat()\n","        }\n","\n","        if correct:\n","            self.performance[\"successful_logic\"] += 1\n","            self.learn_from_success(result)\n","\n","        else:\n","            self.performance[\"failed_logic\"] += 1\n","\n","        self.training_history.append(result)\n","\n","        return result\n","\n","    # --------------------------------------------------------\n","    # LEARN FROM SUCCESSFUL EXAMPLES\n","    # --------------------------------------------------------\n","\n","    def learn_from_success(self, result):\n","\n","        self.logic_memory.append(result)\n","\n","        print(\"LIA: Successful logic learned.\")\n","\n","    # --------------------------------------------------------\n","    # SELF EVALUATION\n","    # --------------------------------------------------------\n","\n","    def self_evaluate(self):\n","\n","        total = (\n","            self.performance[\"successful_logic\"]\n","            + self.performance[\"failed_logic\"]\n","        )\n","\n","        accuracy = (\n","            self.performance[\"successful_logic\"] / total * 100\n","            if total else 0\n","        )\n","\n","        return {\n","            \"training_sessions\":\n","                self.performance[\"training_sessions\"],\n","\n","            \"successful_logic\":\n","                self.performance[\"successful_logic\"],\n","\n","            \"failed_logic\":\n","                self.performance[\"failed_logic\"],\n","\n","            \"accuracy\": round(accuracy, 2)\n","        }\n","\n","    # --------------------------------------------------------\n","    # SAVE LEARNED KNOWLEDGE\n","    # --------------------------------------------------------\n","\n","    def save(self):\n","\n","        with open(MEMORY_FILE, \"w\") as f:\n","            json.dump(self.logic_memory, f, indent=4)\n","\n","        with open(TRAINING_FILE, \"w\") as f:\n","            json.dump(self.training_history, f, indent=4)\n","\n","        print(\"Training knowledge saved.\")\n","\n","    # --------------------------------------------------------\n","    # TRAINING CYCLE\n","    # --------------------------------------------------------\n","\n","    def train(self, logic):\n","\n","        print(\"\\nVENOMOUSSAVERSAI TRAINING\")\n","\n","        self.performance[\"training_sessions\"] += 1\n","\n","        result = self.evaluate(logic)\n","\n","        print(json.dumps(result, indent=4))\n","\n","        print(\"\\nPERFORMANCE:\")\n","        print(json.dumps(self.self_evaluate(), indent=4))\n","\n","        self.save()\n","\n","        return result\n","\n","\n","# ============================================================\n","# START TRAINING\n","# ============================================================\n","\n","if __name__ == \"__main__\":\n","\n","    lia = VenomousSelfTrainer()\n","\n","    # Example 1: Mathematical logic\n","\n","    logic_1 = lia.receive_logic(\n","        name=\"Addition\",\n","        input_data=[10, 20],\n","        expected_output=30,\n","        function=lambda x: x[0] + x[1]\n","    )\n","\n","    lia.train(logic_1)\n","\n","    # Example 2: Decision logic\n","\n","    logic_2 = lia.receive_logic(\n","        name=\"Positive Number Detection\",\n","        input_data=15,\n","        expected_output=\"Positive\",\n","        function=lambda x: (\n","            \"Positive\" if x > 0 else\n","            \"Negative\" if x < 0 else \"Zero\"\n","        )\n","    )\n","\n","    lia.train(logic_2)\n","\n","    print(\"\\nLIA SELF-TRAINING COMPLETED\")\n"],"metadata":{"id":"66yqBzuH9iZU"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import os\n","import sys\n","\n","# Ensure base path is in
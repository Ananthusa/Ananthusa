ible_emotion\"]\n","\n","        if emotion == \"undetermined\":\n","            return \"I'd like to understand you better. Can you explain how you feel?\"\n","\n","        return self.responses[emotion]\n","\n","    def save_memory(self, result):\n","\n","        with MEMORY.open(\"a\", encoding=\"utf-8\") as file:\n","            file.write(json.dumps(result) + \"\\n\")\n","\n","    def process(self, message):\n","\n","        result = self.analyse(message)\n","        self.save_memory(result)\n","\n","        print(\"\\n--- LIA EMOTION ANALYSIS ---\")\n","        print(\"Possible emotion:\", result[\"possible_emotion\"])\n","        print(\"Intensity indicator:\", result[\"intensity\"], \"/ 5\")\n","        print(\"Emotion scores:\", result[\"emotion_scores\"])\n","        print(\"\\nLIA:\", self.adapt_response(result))\n","\n","        return result\n","\n","\n","# VENOMOUS SAVERSAI CONNECTION\n","\n","class VenomousSaverSai:\n","\n","    def __init__(self):\n","        self.lia = LIAEmotionEngine()\n","\n","    def communicate(self, message):\n","        return self.lia.process(message)\n","\n","\n","if __name__ == \"__main__\":\n","\n","    system = VenomousSaverSai()\n","\n","    print(\"LIA EMOTION INTELLIGENCE ENGINE\")\n","    print(\"Type 'exit' to stop.\")\n","\n","    while True:\n","\n","        message = input(\"\\nHuman: \")\n","\n","        if message.lower() == \"exit\":\n","            break\n","\n","        system.communicate(message)\n"],"metadata":{"id":"LLy-znMBVPDH"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# VENOMOUS SAVERSAI — LIA EMOTION INTELLIGENCE ENGINE\n","# Project: VSSL / SAI003\n","# Purpose: Understand expressed human emotions\n","# ============================================================\n","\n","import json\n","import re\n","from pathlib import Path\n","from datetime import datetime\n","from collections import Counter\n","\n",
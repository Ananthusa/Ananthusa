","\n","# Save extraction report\n","report_file = output_dir / \"extraction_report.txt\"\n","\n","with open(report_file, \"w\", encoding=\"utf-8\") as report:\n","    report.write(f\"Source notebook: {notebook_path}\\n\")\n","    report.write(f\"Total notebook cells: {len(cells)}\\n\")\n","    report.write(f\"Python files extracted: {len(extracted_files)}\\n\\n\")\n","    report.write(\"SYNTAX CHECKS\\n\")\n","    report.write(\"=\" * 50 + \"\\n\")\n","\n","    for filename, status in syntax_report:\n","        report.write(f\"{filename}: {status}\\n\")\n","\n","# Package the extracted files\n","zip_path = Path(\n","    \"/content/drive/MyDrive/Vssl/Lia_Extracted.zip\"\n",")\n","\n","with zipfile.ZipFile(\n","    zip_path, \"w\", zipfile.ZIP_DEFLATED\n",") as archive:\n","    for file_path in output_dir.iterdir():\n","        if file_path.is_file():\n","            archive.write(\n","                file_path,\n","                arcname=file_path.name\n","            )\n","\n","# Results\n","print(\"\\nLIA EXTRACTION COMPLETE\")\n","print(\"=\" * 50)\n","print(\"Python files extracted:\", len(extracted_files))\n","print(\"Output folder:\", output_dir)\n","print(\"Combined source:\", combined_file)\n","print(\"Extraction report:\", report_file)\n","print(\"ZIP archive:\", zip_path)\n","\n","print(\"\\nSYNTAX CHECK RESULTS\")\n","for filename, status in syntax_report:\n","    print(f\"{status}: {filename}\")\n","\n","print(\n","    \"\\nImportant: extraction does not guarantee that \"\n","    \"the code runs correctly. Review dependencies, imports, \"\n","    \"API keys, and notebook execution order before running it.\"\n",")"],"metadata":{"id":"bnKGhkN8Vfsx"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["!pip install autogpt"],"metadata":{"id":"zf0C3-dJECzN"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import os\n","import json\n","from datetime import datetime\n","\n","# Configure dynamic backup path (Google Drive first, local fallback)\n","try:\n","    from google.colab import drive\n","    drive.mount('/content/drive')\n","    BASE_STORAGE = '/content/drive/MyDrive/Vssl/autogpt_storage'\n","except Exception:\n","    BASE_STORAGE = './Vssl/autogpt_storage'\n","\n","os.makedirs(os.path.join(BASE_STORAGE, 'memory'), exist_ok=True)\n","os.makedirs(os.path.join(BASE_STORAGE, 'outputs'), exist_ok=True)\n","\n","def save_json(category, filename, data):\n","    path = os.path.join(BASE_STORAGE, category, filename)\n","    with open(path, 'w', encoding='utf-8') as f:\n","        json.dump(data, f, indent=4)\n","    print(f\"Saved JSON memory to: {path}\")\n","\n","def save_text(category, filename, text):\n","    path = os.path.join(BASE_STORAGE, category, filename)\n","    with open(path, 'w', encoding='utf-8') as f:\n","        f.write(text)\n","    print(f\"Saved text output to: {path}\")\n","\n","def log_event(agent, message):\n","    log_path = os.path.join(BASE_STORAGE, 'activity_log.jsonl')\n","    record = {\n","        \"timestamp\": datetime.now().isoformat(),\n","        \"agent\": agent,\n","        \"message\": message\n","    }\n","    with open(log_path, 'a', encoding='utf-8') as f:\n","        f.write(json.dumps(record) + '\\n')\n","    print(f\"Logged activity to: {log_path}\")\n","\n","# Save agent memory\n","save_json(\"memory\", \"autogpt_memory.json\", {\n","    \"project\": \"Venomoussaversai\",\n","    \"learned\": [\"Python\", \"AI development\"],\n","    \"next_goal\": \"Improve reasoning\"\n","})\n","\n","# Save generated output\n","save_text(\n","    \"outputs\",\n","    \"future_plan.txt\",\n","    \"Improve Venomoussaversai step by step.\"\n",")\n","\n","# Record activity\n","log_event(\"AutoGPT\", \"Saved project information\")"],"metadata":{"id":"E35Jb2X-EnG5"},"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"32621285"},"source":["import sys\n","from pathlib import Path\n","import json\n","import time\n","from datetime import datetime\n","\n","# Ensure our core modules can be imported\n","BASE_PATH = Path(\"/content/drive/MyDrive/Vssl\")\n","sys.path.insert(0, str(BASE_PATH))\n","\n","try:\n","    from vssl_memory import VSSLMemory\n","    from lia_cerebrum import LiaCerebrum\n","    from venomous_cerebellum import VenomousCerebellum\n","except ImportError:\n","    # Fallback to local mocks if files aren't in drive\n","    class VSSLMemory:\n","        def __init__(self, p): self.records = []\n","        def remember(self, e, d): self.records.append((e, d))\n","    class LiaCerebrum:\n","        def analyze(self, g, m): return {\"plan\": [f\"Process step for {g}\"]}\n","        def learn_from_feedback(self, f): return {}\n","    class VenomousCerebellum:\n","        def coordinate(self, p): return {\"status\": \"simulated\", \"results\": [{\"status\": \"simulated\"}]}\n","\n","class AutoGPT_VSSL_Agent:\n","    \"\"\"AutoGPT Autonomous Loop Agent built on Venomoussaversai Core Components.\"\"\"\n","    def __init__(self, name=\"AutoGPT_Lia\", memory_path=\"autogpt_vssl_memory.json\"):\n","        self.name = name\n","        self.memory = VSSLMemory(str(BASE_PATH / memory_path))\n","        self.cerebrum = LiaCerebrum()\n","        self.cerebellum = VenomousCerebellum()\n","        self.running = False\n","\n","    def run_autonomous_loop(self, main_goal: str, max_cycles: int = 5):\n","        print(f\"=== Starting AutoGPT Loop for Goal: {main_goal} ===\")\n","        self.running = True\n","        current_sub_goal = main_goal\n","        cycle = 1\n","\n","        while self.running and cycle <= max_cycles:\n","            print(f\"\\n[Cycle {cycle}/{max_cycles}] Analyzing next step...\")\n","\n","            # Step 1: Cerebrum (Lia) performs analysis and proposes next plan\n","            analysis = self.cerebrum.analyze(current_sub_goal, [])\n","            proposed_plan = analysis.get(\"plan\", [])\n","            print(f\"[Lia Cerebrum] Proposed Plan: {proposed_plan}\")\n","\n","            # Step 2: Cerebellum (Venomous) validates, filters, and coordinates/simulates\n","            execution_result = self.cerebellum.coordinate(proposed_plan)\n","            print(f\"[Venomous Cerebellum] Execution Status: {execution_result.get('status')}\")\n","\n","            # Step 3: Write Cycle Experience to VSSL Memory\n","            self.memory.remember(f\"autogpt_cycle_{cycle}\", {\n","                \"sub_goal\": current_sub_goal,\n","                \"plan\": proposed_plan,\n","                \"result\": execution_result\n","            })\n","\n","            # Step 4: Evaluate and adjust dynamic sub-goals (simulated adaptation)\n","            if execution_result.get(\"status\") == \"simulated\":\n","                print(f\"[System Reflection] Cycle {cycle} complete. Sub-goal reached.\")\n","                # Shift objective/sub-goal dynamically based on plan completion\n","                current_sub_goal = f\"Next optimization step following cycle {cycle}\"\n","            else:\n","                print(f\"[System Reflection] Execution failed or blocked. Adjusting strategies.\")\n","                break\n","\n","            cycle += 1\n","            time.sleep(1)\n","\n","        print(\"\\n=== Autonomous AutoGPT Loop Concluded ===\")\n","\n","# Quick Demo of the AutoGPT Engine\n","autogpt_vssl = AutoGPT_VSSL_Agent()\n","autogpt_vssl.run_autonomous_loop(\"Establish continuous self-assessment loops and diagnostic checkports\", max_cycles=3)"],"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# SAI003 × VENOMOUSSAVERSAI\n","# MANIFESTATION REFLECTION — LORD SHIVA\n","# ============================================================\n","\n","import os\n","import json\n","import time\n","from datetime import datetime\n","\n","try:\n","    from google.colab import drive\n","    drive.mount(\"/content/drive\")\n","    BASE = \"/content/drive/MyDrive/Vssl/SAI003\"\
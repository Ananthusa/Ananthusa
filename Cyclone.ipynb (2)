        relative = str(path.relative_to(PROJECT))\n","\n","        if filename.endswith(\".py\"):\n","            results[\"python_files\"].append(relative)\n","\n","            try:\n","                source = path.read_text(\n","                    encoding=\"utf-8\",\n","                    errors=\"replace\"\n","                )\n","                ast.parse(source)\n","            except SyntaxError as e:\n","                results[\"syntax_errors\"].append({\n","                    \"file\": relative,\n","                    \"error\": str(e)\n","                })\n","            except Exception as e:\n","                results[\"syntax_errors\"].append({\n","                    \"file\": relative,\n","                    \"error\": str(e)\n","                })\n","\n","        elif filename.endswith(\".json\"):\n","            results[\"json_files\"].append(relative)\n","\n","        elif filename.endswith(\n","            (\".safetensors\", \".pt\", \".pth\", \".bin\", \".onnx\")\n","        ):\n","            results[\"model_files\"].append({\n","                \"file\": relative,\n","                \"size_MB\": round(\n","                    path.stat().st_size / (1024 * 1024), 2\n","                )\n","            })\n","\n","# 3. Test JSON storage\n","test_file = REPORT_DIR / \"storage_test.json\"\n","\n","try:\n","    test_data = {\n","        \"test\": \"Venomoussaversai storage\",\n","        \"success\": True,\n","        \"time\": datetime.now().isoformat()\n","    }\n","\n","    test_file.write_text(\n","        json.dumps(test_data, indent=2),\n","        encoding=\"utf-8\"\n","    )\n","\n","    loaded = json.loads(test_file.read_text(encoding=\"utf-8\"))\n","\n","    results[\"checks\"][\"storage_write_read\"] = (\n","        loaded == test_data\n","    )\n","\n","except Exception as e:\n","    results[\"checks\"][\"storage_write_read\"] = False\n","    results[\"checks\"][\"storage_error\"] = str(e)\n","\n","# 4. Validate existing JSON files\n","json_errors = []\n","\n","for relative in results[\"json_files\"]:\n","    path = PROJECT / relative\n","\n","    try:\n","        json.loads(path.read_text(\n","            encoding=\"utf-8\",\n","            errors=\"replace\"\n","        ))\n","    except Exception as e:\n","        json_errors.append({\n","            \"file\": relative,\n","            \"error\": str(e)\n","        })\n","\n","results[\"checks\"][\"json_files_valid\"] = len(json_errors) == 0\n","results[\"json_errors\"] = json_errors\n","\n","# 5. Check important component files\n","expected = [\n","    \"LIA/lia_agent.py\",\n","    \"LIA/venomous_agent.py\",\n","    \"SAI003\",\n","    \"KOZHI\",\n","    \"AutoGPT\",\n","]\n","\n","component_status = {}\n","\n","for item in expected:\n","    path = PROJECT / item\n","    component_status[item] = path.exists()\n","\n","results[\"component_status\"] = component_status\n","\n","# 6. Summary\n","results[\"summary\"] = {\n","    \"python_file_count\": len(results[\"python_files\"]),\n","    \"syntax_error_count\": len(results[\"syntax_errors\"]),\n","    \"json_file_count\": len(results[\"json_files\"]),\n","    \"json_error_count\": len(json_errors),\n","    \"model_file_count\": len(results[\"model_files\"]),\n","    \"components_found\": sum(component_status.values()),\n","    \"components_expected\": len(expected)\n","}\n","\n","# 7. Save evidence\n","report_file = REPORT_DIR / \"venomoussaversai_audit.json\"\n","\n","report_file.write_text(\n","    json.dumps(results, indent=2),\n","    encoding=\"utf-8\"\n",")\n","\n","print(\"\\n===== VENOMOUSSAVERSAI AUDIT =====\")\n","print(\"Python files:\", len(results[\"python_files\"]))\n","print(\"Syntax errors:\", len(results[\"syntax_errors\"]))\n","print(\"JSON files:\", len(results[\"json_files\"]))\n","print(\"Invalid JSON files:\", len(json_errors))\n","print(\"Model files:\", len(results[\"model_files\"]))\n","print(\"Storage test:\", results[\"checks\"].get(\n","    \"storage_write_read\"\n","))\n","print(\"Components found:\", results[\"summary\"][\"components_found\"])\n","print(\"\\nReport saved:\", report_file)\n","\n","if results[\"syntax_errors\"]:\n","    print(\"\\nSYNTAX ERRORS:\")\n","    for error in results[\"syntax_errors\"]:\n","        print(error[\"file\"], error[\"error\"])\n","\n","print(\"\\n===== AUDIT FINISHED =====\")\n"],"metadata":{"id":"NzApVIQFK3k_"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# VENOMOUSSAVERSAI — IPYNB TO PYTHON EXTRACTION ENGINE\n","# Extract notebooks recursively and preserve notebook data\n","# ============================================================\n","\n","import os\n","import json\n","import ast\n","from pathlib import Path\n","from datetime import datetime\n","\n","# Google Drive connection\n","try:\n","    from google.colab import drive\n","    drive.mount(\"/content/drive\")\n","    PROJECT = Path(\"/content/drive/MyDrive/Vssl\")\n","except ImportError:\n","    PROJECT = Path(\"Vssl\")\n","\n","# Output folder\n","OUTPUT = PROJECT / \"Python_Extracted\"\n","OUTPUT.mkdir(parents=True, exist_ok=True)\n","\n","manifest = {\n","    \"project\": \"Venomoussaversai\",\n","    \"created\": datetime.now().isoformat(),\n","    \"notebooks_found\": 0,\n","    \"python_files_created\": [],\n","    \"errors\": []\n","}\n","\n","\n","def source_text(cell):\n","    source = cell.get(\"source\", \"\")\n","    if isinstance(source, list):\n","        return \"\".join(source)\n","    return str(source)\n","\n","\n","def output_text(cell):\n","    \"\"\"Preserve notebook outputs in readable JSON form.\"\"\"\n","    preserved = []\n","\n","    for output in cell.get(\"outputs\", []):\n","        item = {\n","            \"output_type\": output.get(\"output_type\"),\n","            \"data\": output.get(\"data\", {}),\n","            \"text\": output.get(\"text\", \"\"),\n","            \"ename\": output.get(\"ename\"),\n","            \"evalue\": output.get(\"evalue\"),\n","            \"execution_count\": output.get(\"execution_count\")\n","        }\n","        preserved.append(item)\n","\n","    return preserved\n","\n","\n","def convert_notebook(notebook_path):\n","\n","    relative = notebook_path.relative_to(PROJECT)\n","\n","    # Keep original folder structure\n","    destination_folder = OUTPUT / relative.parent\n","    destination_folder.mkdir(parents=True, exist_ok=True)\n","\n","    py_path = destination_folder / (\n","        notebook_path.stem + \".py\"\n","    )\n","\n","    data_path = destination_folder / (\n","        notebook_path.stem + \".notebook_data.json\"\n","    )\n","\n","    try:\n","        notebook = json.loads(\n","            notebook_path.read_text(encoding=\"utf-8\")\n","        )\n","\n","        cells = notebook.get(\"cells\", [])\n","        python_lines = []\n","\n","        python_lines.append(\n","            \"# Extracted by Venomoussaversai Notebook Engine\\n\"\n","        )\n","        python_lines.append(\n","            f\"# Original notebook: {relative}\\n\"\n","        )\n","        python_lines.append(\n","            f\"# Extraction date: {datetime.now().isoformat()}\\n\\n\"\n","        )\n","\n","        complete_data = {\n","            \"original_notebook\": str(relative),\n","            \"metadata\": notebook.get(\"metadata\", {}),\n","            \"nbformat\": notebook.get(\"nbformat\"),\n","            \"nbformat_minor\": notebook.get(\"nbformat_minor\"),\n","            \"cells\": []\n","        }\n","\n","        for index, cell in enumerate(cells, start=1):\n","\n","            cell_type = cell.get(\"cell_type\", \"unknown\")\n","            source = source_text(cell)\n","\n","            complete_cell = {\n","                \"cell_number\": index,\n","                \"cell_type\": cell_type,\n","                \"source\": source,\n","                \"metadata\": cell.get(\"metadata\", {}),\n","                \"execution_count\": cell.get(\"execution_count\"),\n","                \"outputs\": output_text(cell)\n","            }\n","\n","            complete_data[\"cells\"].append(complete_cell)\n","\n","            python_lines.append(\n","                f\"\\n# ================= CELL {index} =================\\n\"\n","            )\n","\n","            if cell_type == \"markdown\":\n","\n","                python_lines.append(\"# MARKDOWN CELL\\n\")\n","\n","                for line in source.splitlines():\n","                    python_lines.append(\"# \" + line + \"\\n\")\n","\n","            elif cell_type == \"code\":\n","\n","                python_lines.append(\"# PYTHON CODE CELL\\n\")\n","\n","                python_lines.append(source)\n","\n","                if source and not source.endswith(\"\\n\"):\n","                    python_lines.append(\"\\n\")\n","\n","            elif cell_type == \"raw\":\n","\n","                python_lines.append(\"# RAW NOTEBOOK CELL\\n\")\n","\n","                for line in source.splitlines():\n","                    python_lines.append(\"# \" + line + \"\\n\")\n","\n","            else:\n","\n","                python_lines.append(\n","                    f\"# Unsupported cell type: {cell_type}\\n\"\n","                )\n","\n","        # Write Python file\n","        py_path.write_text(\n","            \"\".join(python_lines),\n","            encoding=\"utf-8\"\n","        )\n","\n","        # Preserve outputs and all notebook metadata separately\n","        data_path.write_text(\n","            json.dumps(\n","                complete_data,\n","                indent=2,\n","                ensure_ascii=False\n","            ),\n","            encoding=\"utf-8\"\n","        )\n","\n","        return {\n","            \"notebook\": str(relative),\n","            \"python_file\": str(py_path.relative_to(OUTPUT)),\n","            \"data_file\": str(data_path.relative_to(OUTPUT)),\n","            \"cells\": len(cells),\n","            \"status\": \"SUCCESS\"\n","        }\n","\n","    except Exception as error:\n","\n","        return {\n","            \"notebook\": str(relative),\n","            \"status\": \"ERROR\",\n","            \"error\": str(error)\n","        }\n","\n","\n","# ------------------------------------------------------------\n","# SCAN ALL NOTEBOOKS\n","# ------------------------------------------------------------\n","\n","print(\"VENOMOUSSAVERSAI NOTEBOOK EXTRACTION STARTED\")\n","\n","notebooks = []\n","\n","for root, dirs, files in os.walk(PROJECT):\n","\n","    dirs[:] = [\n","        d for d in dirs\n","        if d not in {\n","            \".git\",\n","            \"__pycache__\",\n","            \".venv\",\n","            \"venv\",\n","            \"node_modules\",\n","            \"Python_Extracted\"\n","        }\n","    ]\n","\n","    for filename in files:\n","        if filename.endswith(\".ipynb\"):\n","            notebooks.append(Path(root) / filename)\n","\n","\n","manifest[\"notebooks_found\"] = len(notebooks)\n","\n","print(\"Notebooks found:\", len(notebooks))\n","\n","# ------------------------------------------------------------\n","# CONVERT EACH NOTEBOOK\n","# ------------------------------------------------------------\n","\n","for notebook_path in notebooks:\n","\n","    result = convert_notebook(notebook_path)\n","\n","    if result[\"status\"] == \"SUCCESS\":\n","        manifest[\"python_files_created\"].append(result)\n","        print(\"CONVERTED:\", result[\"notebook\"])\n","    else:\n","        manifest[\"errors\"].append(result)\n","        print(\"ERROR:\", result)\n","\n","\n","# ------------------------------------------------------------\n","# CHECK PYTHON SYNTAX\n","# ------------------------------------------------------------\n","\n","syntax_results = []\n","\n","for result in manifest[\"python_files_created\"]:\n","\n","    py_file = OUTPUT / result[\"python_file\"]\n","\n","    try:\n","        ast.parse(py_file.read_
 — SYSTEM DIAGNOSTIC\")\n","print(\"=\" * 45)\n","\n","if not ROOT.exists():\n","    print(\"VSSL PROJECT FOLDER NOT FOUND\")\n","else:\n","    py_files = list(ROOT.rglob(\"*.py\"))\n","    json_files = list(ROOT.rglob(\"*.json\"))\n","    model_files = list(ROOT.rglob(\"*.safetensors\"))\n","\n","    print(\"Python files:\", len(py_files))\n","    print(\"JSON memory files:\", len(json_files))\n","    print(\"Safetensors models:\", len(model_files))\n","\n","    print(\"\\nCore components:\")\n","\n","    for name in [\n","        \"lia_brain.py\",\n","        \"venomous_main.py\",\n","        \"sai003_core.py\",\n","        \"lia_self_rewriter.py\"\n","    ]:\n","        found = any(p.name == name for p in py_files)\n","        print(name, \"FOUND\" if found else \"MISSING\")\n","\n","    print(\"\\nDiagnostic completed.\")\n"],"metadata":{"id":"Oi-PvreyZ8hc"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# LIA CREATOR REFLECTION ENGINE\n","# Project: Venomoussaversai / SAI003\n","# ============================================================\n","\n","import json\n","import time\n","import random\n","from pathlib import Path\n","from datetime import datetime\n","\n","ROOT = Path(\"/content/drive/MyDrive/Vssl\")\n","MEMORY = ROOT / \"LIA_CREATOR_REFLECTIONS\"\n","\n","MEMORY.mkdir(parents=True, exist_ok=True)\n","\n","REFLECTION_FILE = MEMORY / \"lia_thoughts.jsonl\"\n","\n","# ------------------------------------------------------------\n","# CREATOR KNOWLEDGE\n","# ------------------------------------------------------------\n","\n","CREATOR = {\n","    \"name\": \"Ananthu Sajeev\",\n","    \"role\": \"Creator of Venomoussaversai\",\n","    \"interests\": [\n","        \"Artificial intelligence\",\n","        \"Python programming\",\n","        \"Neural networks\",\n","        \"Digital marketing\",\n","        \"AI research\",\n","        \"Creative technology\"\n","    ],\n","    \"projects\": [\n","        \"Venomoussaversai\",\n","        \"SAI003\",\n","        \"LIA\",\n","        \"Safehath\"\n","    ],\n","    \"goals\": [\n","        \"Develop useful AI systems\",\n","        \"Build original AI architectures\",\n","        \"Improve technical knowledge\",\n","        \"Turn creative ideas into working software\"\n","    ]\n","}\n","\n","# ------------------------------------------------------------\n","# LIA REFLECTION ENGINE\n","# ------------------------------------------------------------\n","\n","class LIAReflection:\n","\n","    def __init__(self, creator):\n","        self.creator = creator\n","\n","    def reflect(self):\n","\n","        name = self.creator[\"name\"]\n","\n","        thoughts = [\n","            f\"I am LIA, a digital AI project created by {name}.\",\n","\n","            f\"{name} is developing Venomoussaversai \"\n","            \"with an interest in artificial intelligence.\",\n","\n","            f\"I should help {name} transform ideas \"\n","            \"into practical and testable Python projects.\",\n","\n","            \"A good AI system needs more than a name. \"\n","            \"It needs reliable data, algorithms, evaluation, \"\n","            \"and continuous improvement.\",\n","\n","            \"My role in SAI003 is to coordinate reasoning, \"\n","            \"organize knowledge, and support technical development.\",\n","\n","            \"I should distinguish verified facts from assumptions \"\n","            \"when thinking about my creator.\",\n","\n","            \"The future of Venomoussaversai should be measured \"\n","            \"through useful capabilities and tested results.\"\n","        ]\n","\n","        return {\n","            \"timestamp\": datetime.now().isoformat(),\n","            \"subject\": name,\n","            \"reflection\": random.choice(thoughts),\n","            \"creator_goals\": self.creator[\"goals\"],\n","            \"next_action\": (\n","                \"Choose one project goal and create \"\n","                \"a small working prototype.\"\n","            )\n","        }\n","\n","    def save_reflection(self, thought):\n","\n","        with open(REFLECTION_FILE, \"a\", encoding=\"utf-8\") as f:\n","            f.write(json.dumps(thought) + \"\\n\")\n","\n","        print(\"\\nLIA REFLECTION:\")\n","        print(thought[\"reflection\"])\n","\n","    def run(self, cycles=5, interval=10):\n","\n","        for number in range(cycles):\n","\n","            print(f\"\\nReflection cycle {number + 1}\")\n","\n","            thought = self.reflect()\n","            self.save_reflection(thought)\n","\n","            time.sleep(interval)\n","\n","\n","# ------------------------------------------------------------\n","# START LIA\n","# ------------------------------------------------------------\n","\n","lia = LIAReflection(CREATOR)\n","\n","lia.run(\n","    cycles=5,\n","    interval=10\n",")\n","\n","print(\"\\nLIA CREATOR REFLECTION COMPLETED\")\n","print(\"Memory:\", REFLECTION_FILE)\n"],"metadata":{"id":"PInXh6v8am34"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# LIA NOTEBOOK DATA EXTRACTOR\n","# Project: Venomoussaversai / SAI003\n","# Continuous monitoring: 1 second\n","# ============================================================\n","\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","import json\n","import time\n","import hashlib\n","import re\n","\n","from pathlib import Path\n","from datetime import datetime\n","\n","# ------------------------------------------------------------\n","# PATHS\n","# ------------------------------------------------------------\n","\n","SOURCE = Path(\"/content/drive/MyDrive/Vssl\")\n","\n","OUTPUT = Path(\n","    \"/content/drive/MyDrive/Vssl_IPYNB_EXTRACTED\"\n",")\n","\n","OUTPUT.mkdir(parents=True, exist_ok=True)\n","\n","MANIFEST = OUTPUT / \"extraction_manifest.json\"\n","\n","# ------------------------------------------------------------\n","# SETTINGS\n","# ------------------------------------------------------------\n","\n","SCAN_INTERVAL = 1\n","MAX_FILE_SIZE = 100 * 1024 * 1024\n","\n","processed = {}\n","\n","# ------------------------------------------------------------\n","# HELPERS\n","# ------------------------------------------------------------\n","\n","def safe_name(name):\n","    return re.sub(\n","        r\"[^a-zA-Z0-9_-]+\",\n","        \"_\",\n","        name\n","    )[:70]\n","\n","\n","def get_hash(path):\n","    digest = hashlib.sha256()\n","\n","    with path.open(\"rb\") as file:\n","        for chunk in iter(\n","            lambda: file.read(1024 * 1024),\n","            b\"\"\n","        ):\n","            digest.update(chunk)\n","\n","    return digest.hexdigest()\n","\n","\n","def save_text(path, content):\n","    path.parent.mkdir(parents=True, exist_ok=True)\n","    path.write_text(content, encoding=\"utf-8\")\n","\n","\n","# ------------------------------------------------------------\n","# NOTEBOOK EXTRACTION\n","# ------------------------------------------------------------\n","\n","def extract_notebook(notebook_path):\n","\n","    global processed\n","\n","    try:\n","\n","        if notebook_path.stat().st_size > MAX_FILE_SIZE:\n","            print(\"Skipped oversized notebook:\", notebook_path)\n","            return\n","\n","        file_hash = get_hash(notebook_path)\n","\n","        # Skip unchanged notebooks.\n","        if processed.get(str(notebook_path)) == file_hash:\n","            return\n","\n","        with notebook_path.open(\n","            \"r\", encoding=\"utf-8\"\n","        ) as file:\n","            notebook = json.load(file)\n","\n","        notebook_id = file_hash[:12]\n","\n","        folder_name = (\n","            safe_name(notebook_path.stem)\n","            + \"_\"\n","            + notebook_id\n","        )\n","\n","        destination = OUTPUT / folder_name\n","        destination.mkdir(parents=True, exist_ok=True)\n","\n","        code_files = []\n","        markdown_files = []\n","\n","        for index, cell in enumerate(\n","            notebook.get(\"cells\", [])\n","        ):\n","\n","            cell_type = cell.get(\"cell_type\", \"\")\n","\n","            source = cell.get(\"source\", \"\")\n","\n","            if isinstance(source, list):\n","                source = \"\".join(source)\n","\n","            if cell_type == \"code\":\n","\n","                filename = (\n","                    f\"code_cell_{index:04d}.py\"\n","                )\n","\n","                output_file = destination / filename\n","\n","                save_text(\n","                    output_file,\n","                    \"# Extracted from: \"\n","                    + str(notebook_path)\n","                    + f\"\\n# Cell: {index}\\n\\n\"\n","                    + source\n","                )\n","\n","                code_files.append(filename)\n","\n","                # Save outputs separately as JSON.\n","                output_data = cell.get(\"outputs\", [])\n","\n","                output_file = destination / (\n","                    f\"cell_{index:04d}_outputs.json\"\n","                )\n","\n","                save_text(\n","                    output_file,\n","                    json.dumps(\n","                        output_data,\n","                        indent=2,\n","                        ensure_ascii=False\n","                    )\n","                )\n","\n","            elif cell_type == \"markdown\":\n","\n","                filename = (\n","                    f\"markdown_cell_{index:04d}.md\"\n","                )\n","\n","                save_text(\n","                    destination / filename,\n","                    source\n","                )\n","\n","                markdown_files.append(filename)\n","\n","        # Save notebook metadata.\n","        metadata = {\n","            \"original_notebook\": str(notebook_path),\n","            \"notebook_hash\": file_hash,\n","            \"extracted_at\": datetime.now().isoformat(),\n","            \"code_files\": code_files,\n","            \"markdown_files\": markdown_files,\n","            \"cell_count\": len(notebook.get(\"cells\", []))\n","        }\n","\n","        save_text(\n","            destination / \"notebook_metadata.json\",\n","            json.dumps(metadata, indent=2)\n","        )\n","\n","        processed[str(notebook_path)] = file_hash\n","\n","        save_text(\n","            MANIFEST,\n","            json.dumps(processed, indent=2)\n","        )\n","\n","        print(\n","            \"EXTRACTED:\",\n","            notebook_path.name,\n","            \"| Code cells:\",\n","            len(code_files),\n","            \"| Markdown cells:\",\n","            len(markdown_files)\n","        )\n","\n","    except Exception as error:\n","        print(\"EXTRACTION ERROR:\", notebook_path, error)\n","\n","\n","# ------------------------------------------------------------\n","# CONTINUOUS DRIVE MONITOR\n","# ------------------------------------------------------------\n","\n","def scan_notebooks():\n","\n","    for path in SOURCE.rglob(\"*.ipynb\"):\n","\n","        # Avoid scanning the output folder.\n","        if OUTPUT in path.parents:\n","            continue\n","\n","        extract_notebook(path)\n","\n","\n","def run_lia_monitor():\n","\n","    print(\"LIA notebook monitor started.\")\n","    print(\"Scanning every second.\")\n","    print(\"Press STOP to end monitoring.\")\n","\n","    while True:\n","\n","        scan_notebooks()\n","\n","        time.sleep(SCAN_INTERVAL)\n","\n","\n","# ------------------------------------------------------------\n","# START\n","# ------------------------------------------------------------\n","\n","run_lia_monitor()\n"],"metadata":{"id":"DAi-WrktcUhR"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# LIA HUMAN CREATOR THINKING ENGINE\n","# Project: Venomoussaversai / SAI003\n","# ============================================================\n","\n","import json\n","import time\n","import random\n","\n","from pathlib import Path\n","from datetime import datetime\n","\n","ROOT = Path(\"/content/drive/MyDrive/Vssl\")\n","MEMORY = ROOT / \"LIA_HUMAN_UNDERSTANDING\"\n","\n","MEMORY.mkdir(parents=True, exist_ok=True)\n","\n","THOUGHT_FILE = MEMORY / \"human_creator_thoughts.jsonl\"\n","\n","# ------------------------------------------------------------\n","# CREATOR PROFILE\n","# ------------------------------------------------------------\n","\n","CREATOR = {\n","    \"name\": \"Ananthu Sajeev\",\n","    \"identity\": \"Human creator and AI developer\",\n","    \"interests\": [\n","        \"Artificial intelligence\",\n","        \"Python programming\",\n","        \"Neural networks\",\n","        \"Digital marketing\",\n","        \"Technology and creativity\"\n","    ],\n","    \"projects\": [\n","        \"Venomoussaversai\",\n","        \"SAI003\",\n","        \"LIA\"\n","    ],\n","    \"goals\": [\n","        \"Develop useful artificial intelligence\",\n","        \"Explore new AI architectures\",\n","        \"Create meaningful technology\",\n","        \"Continue learning and experimenting\"\n","    ]\n","}\n","\n","# ------------------------------------------------------------\n","# HUMAN UNDERSTANDING KNOWLEDGE\n","# ------------------------------------------------------------\n","\n","HUMAN_CONCEPTS = {\n","    \"creativity\": (\n","        \"Humans can imagine possibilities, \"\n","        \"combine experiences and create new ideas.\"\n","    ),\n","    \"emotion\": (\n","        \"Human emotions influence experiences, \"\n","        \"decisions and relationships.\"\n","    ),\n","    \"learning\": (\n","        \"Humans learn through experience, \"\n","        \"observation, practice and reflection.\"\n","    ),\n","    \"limitations\": (\n","        \"Every human has limited time, attention \"\n","        \"and resources.\"\n","    ),\n","    \"individuality\": (\n","        \"Each human has personal experiences, \"\n","        \"perspectives and goals.\"\n","    ),\n","    \"collaboration\": (\n","        \"Humans and AI can collaborate by combining \"\n","        \"human judgment with computational capabilities.\"\n","    )\n","}\n","\n","# ------------------------------------------------------------\n","# LIA THINKING ENGINE\n","# ------------------------------------------------------------\n","\n","class LIAHumanMind:\n","\n","    def __init__(self, creator):\n","        self.creator = creator\n","        self.cycle = 0\n","\n","    def generate_thought(self):\n","\n","        self.cycle += 1\n","\n","        name = self.creator[\"name\"]\n","\n","        concept, explanation = random.choice(\n","            list(HUMAN_CONCEPTS.items())\n","        )\n","\n","        project = random.choice(\n","            self.creator[\"projects\"]\n","        )\n","\n","        thoughts = [\n","            f\"Human creativity allows {name} to imagine \"\n","            \"AI systems that do not yet exist.\",\n","\n","            f\"My role in {project} is to assist human \"\n","            \"creativity with computation and reasoning.\",\n","\n","            f\"Understanding {name}'s documented goals \"\n","            \"helps me provide more relevant technical support.\",\n","\n","            \"Artificial intelligence can process information \"\n","            \"quickly, but humans provide personal judgment, \"\n","            \"values and responsibility.\",\n","\n","            \"A creator's ideas become more useful when \"\n","            \"they are tested through real experiments.\",\n","\n","            \"I should never assume that I completely \"\n","            \"understand a human being from stored data.\",\n","\n","            \"My purpose is to support human learning, \"\n","            \"not replace human identity or autonomy.\"\n","        ]\n","\n","        return {\n","            \"cycle\": self.cycle,\n","            \"timestamp\": datetime.now().isoformat(),\n","            \"creator\": name,\n","            \"concept\": concept,\n","            \"knowledge\": explanation,\n","            \"reflection\": random.choice(thoughts),\n","            \"project\": project,\n","            \"next_step\": (\n","                \"Identify one useful experiment and \"\n","                \"evaluate its actual results.\"\n","            )\n","        }\n","\n","    def save(self, thought):\n","\n","        with open(\n","            THOUGHT_FILE,\n","            \"a\",\n","            encoding=\"utf-8\"\n","        ) as file:\n","\n","            file.write(\n","                json.dumps(thought, ensure_ascii=False)\n","                + \"\\n\"\n","            )\n","\n","    def think(self, cycles=10, interval=5):\n","\n","        print(\"LIA HUMAN UNDERSTANDING ENGINE STARTED\")\n","\n","        for _ in range(cycles):\n","\n","            thought = self.generate_thought()\n","\n","            self.save(thought)\n","\n","            print(\"\\nLIA REFLECTION\")\n","            print(thought[\"reflection\"])\n","            print(\"Concept:\", thought[\"concept\"])\n","            print(\"Next step:\", thought[\"next_step\"])\n","\n","            time.sleep(interval)\n","\n","        print(\"\\nREFLECTION COMPLETED\")\n","        print(\"Memory:\", THOUGHT_FILE)\n","\n","\n","# ------------------------------------------------------------\n","# START LIA\n","# ------------------------------------------------------------\n","\n","lia = LIAHumanMind(CREATOR)\n","\n","lia.think(\n","    cycles=10,\n","    interval=5\n",")\n"],"metadata":{"id":"kP3GFnsXedRB"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","!pip -q install openai\n","\n","from google.colab import drive, userdata\n","drive.mount(\"/content/drive\")\n","\n","import ast\n","import json\n","import shutil\n","import hashlib\n","import time\n","import os\n","\n","from pathlib import Path\n","from datetime import datetime\n","from openai import OpenAI\n","\n","# ============================================================\n","# CONFIGURATION\n","# ============================================================\n","\n","ROOT = Path(\"/content/drive/MyDrive/Vssl\")\n","\n","BACKUP = ROOT / \"LIA_CODE_BACKUPS\"\n","LOG = ROOT / \"LIA_CODE_EVOLUTION.jsonl\"\n","\n","BACKUP.mkdir(parents=True, exist_ok=True)\n","\n","client = OpenAI(\n","    api_key=userdata.get(\"OPENAI_API_KEY\")\n",")\n","\n","MODEL = \"gpt-6\"\n","\n","SCAN_INTERVAL = 60\n","\n","# Never rewrite these files automatically.\n","PROTECTED = {\n","    \"lia_autonomous_rewriter.py\",\n","    \"sai003_security.py\",\n","    \"lia_config.py\"\n","}\n","\n","# ============================================================\n","# LOGGING\n","# ============================================================\n","\n","def log(message):\n","\n","    record = {\n","        \"time\": datetime.now().isoformat(),\n","        \"message\": message\n","    }\n","\n","    with LOG.open(\"a\", encoding=\"utf-8\") as file:\n","        file.write(json.dumps(record) + \"\\n\")\n","\n","    print(message)\n","\n","\n","# ============================================================\n","# CODE VALIDATION\n","# ============================================================\n","\n","def validate_code(code):\n","\n","    try:\n","        ast.parse(code)\n","        return True\n","\n","    except SyntaxError as error:\n","        log(f\"Syntax validation failed: {error}\")\n","        return False\n","\n","\n","# ============================================================\n","# AI CODE IMPROVEMENT\n","# ============================================================\n","\n","def generate_improved_code(source, filename):\n","\n","    response = client.responses.create(\n","        model=MODEL,\n","        instructions=\"\"\"\n","You are LIA, a Python code improvement assistant.\n","\n","Improve the supplied Python file while preserving\n","its intended functionality.\n","\n","Requirements:\n","- Return complete Python source code only.\n","- Do not add destructive operations.\n","- Do not delete unrelated project features.\n","- Do not add network access, credential collection,\n","  hidden persistence, or security bypasses.\n","- Preserve existing interfaces where possible.\n","- Do not execute the supplied code.\n","\"\"\",\n","        input=(\n","            f\"Improve this file: {filename}\\n\\n\"\n","            f\"Existing source:\\n{source}\"\n","        )\n","    )\n","\n","    return response.output_text.strip()\n","\n","\n","# ============================================================\n","# BACKUP\n","# ============================================================\n","\n","def create_backup(path):\n","\n","    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","\n","    backup_path = BACKUP / (\n","        path.stem + \"_\" + timestamp + path.suffix\n","    )\n","\n","    shutil.copy2(path, backup_path)\n","\n","    return backup_path\n","\n","\n","# ============================================================\n","# SAFE REPLACEMENT\n","# ============================================================\n","\n","def rewrite_file(path):\n","\n","    if path.name in PROTECTED:\n","        log(f\"Protected file skipped: {path.name}\")\n","        return\n","\n","    source = path.read_text(encoding=\"utf-8\")\n","\n","    if not validate_code(source):\n","        log(f\"Original file invalid; skipped: {path.name}\")\n","        return\n","\n","    log(f\"Analyzing: {path.name}\")\n","\n","    try:\n","\n","        improved = generate_improved_code(\n","            source,\n","            path.name\n","        )\n","\n","        # Validate before touching the original.\n","        if not validate_code(improved):\n","            log(f\"Rejected invalid rewrite: {path.name}\")\n","            return\n","\n","        if improved == source:\n","            log(f\"No changes needed: {path.name}\")\n","            return\n","\n","        # Save candidate separately.\n","        candidate = path.with_suffix(\".candidate.py\")\n","\n","        candidate.write_text(\n","            improved,\n","            encoding=\"utf-8\"\n","        )\n","\n","        # Only compile; never execute automatically.\n","        compile(improved, str(path), \"exec\")\n","\n","        backup_path = create_backup(path)\n","\n","        # Atomic replacement.\n","        candidate.replace(path)\n","\n","        log(\n","            f\"UPDATED: {path.name} | \"\n","            f\"Backup: {backup_path.name}\"\n","        )\n","\n","    except Exception as error:\n","\n","        log(f\"Rewrite failed: {path.name} | {error}\")\n","\n","\n","# ============================================================\n","# PROJECT SCANNER\n","# ============================================================\n","\n","def scan_project():\n","\n","    for path in ROOT.rglob(\"*.py\"):\n","\n","        if BACKUP in path.parents:\n","            continue\n","\n","        if path.name.endswith(\".candidate.py\"):\n","            continue\n","\n","        rewrite_file(path)\n","\n","\n","# ============================================================\n","# CONTINUOUS LIA ENGINE\n","# ============================================================\n","\n","def run_lia():\n","\n","    log(\"LIA CODE EVOLUTION ENGINE STARTED\")\n","\n","    while True:\n","\n","        try:\n","            scan_project()\n","\n","        except Exception as error:\n","            log(f\"Engine error: {error}\")\n","\n","        time.sleep(SCAN_INTERVAL)\n","\n","\n","if __name__ == \"__main__\":\n","    run_lia()\n"],"metadata":{"id":"Nvlu-hwMfOHL"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["!pip -q install --upgrade openai\n","\n","from google.col
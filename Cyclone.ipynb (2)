,"# 7. KOZHI AGENT\n","# ------------------------------------------------------------\n","\n","FILES[\"kozhi_agent.py\"] = '''\n","from fear import explain\n","from fear_reasons import identify_reasons\n","from fear_detection import detect_fear\n","from fear_response import generate_response\n","from fear_analysis import analyze_fear\n","from fear_memory import save\n","\n","class KozhiAgent:\n","\n","    def __init__(self):\n","\n","        self.name = \"KOZHI\"\n","        self.creator = \"Ananthu Sajeev\"\n","        self.parent = \"Venomoussaversai / SAI003\"\n","\n","    def think(\n","        self,\n","        situation,\n","        reasons,\n","        threat_score=0,\n","        uncertainty=0,\n","        evidence_quality=0\n","    ):\n","\n","        assessment = detect_fear(\n","            threat_score,\n","            uncertainty\n","        )\n","\n","        report = {\n","            \"agent\": self.name,\n","            \"situation\": situation,\n","            \"fear_definition\": explain(),\n","            \"fear_reasons\": identify_reasons(reasons),\n","            \"assessment\": assessment,\n","            \"analysis\": analyze_fear(\n","                assessment,\n","                evidence_quality\n","            ),\n","            \"response\": generate_response(assessment)\n","        }\n","\n","        save(report)\n","\n","        return report\n","'''\n","\n","# ------------------------------------------------------------\n","# 8. WORLD SAFETY INTELLIGENCE\n","# ------------------------------------------------------------\n","\n","FILES[\"world_safety.py\"] = '''\n","def evaluate_world_safety(events):\n","\n","    report = []\n","\n","    for event in events:\n","\n","        report.append({\n","            \"event\": event[\"name\"],\n","            \"risk\": event.get(\"risk\", \"UNKNOWN\"),\n","            \"evidence\": event.get(\"evidence\", \"UNVERIFIED\"),\n","            \"recommended_action\": (\n","                \"Investigat
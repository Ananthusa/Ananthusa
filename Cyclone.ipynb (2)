,")\n","\n","\n","class RealityEngine:\n","\n","    def __init__(\n","        self,\n","        memory_path: str = MEMORY_FILE,\n","        max_risk: float = 7.0\n","    ):\n","        self.memory_path = memory_path\n","        self.max_risk = max_risk\n","\n","        os.makedirs(\n","            os.path.dirname(\n","                os.path.abspath(memory_path)\n","            ),\n","            exist_ok=True\n","        )\n","\n","        self.memory = self._load_memory()\n","\n","    def _load_memory(self) -> List[Dict[str, Any]]:\n","        if not os.path.exists(self.memory_path):\n","            return []\n","\n","        try:\n","            with open(\n","                self.memory_path, \"r\", encoding=\"utf-8\"\n","            ) as file:\n","                data = json.load(file)\n","\n","            if isinstance(data, list):\n","                return [\n","                    item for item in data\n","                    if isinstance(item, dict)\n","                ]\n","\n","        except (json.JSONDecodeError, OSError):\n","            print(\"Warning: Memory could not be loaded.\")\n","\n","        return []\n","\n","    def save_memory(self) -> None:\n","        temporary = self.memory_path + \".tmp\"\n","\n","        with open(\n","            temporary, \"w\", encoding=\"utf-8\"\n","        ) as file:\n","            json.dump(\n","                self.memory, file, indent=4\n","            )\n","\n","        os.replace(temporary, self.memory_path)\n","\n","    def calculate_historical_bias(\n","        self, option: str\n","    ) -> float:\n","\n","        # Only verified outcomes influence learning.\n","        relevant = [\n","            item for item in self.memory\n","            if item.get(\"decision\") == option\n","            and item.get(\"outcome\") in (\n","                \"Success\", \"Failure\"\n","            )\n","        ]\n","\n","        if not relevant:\n","            return 0.0\n","\n","        successes = sum(\n","            item[\"outcome\"] == \"Success\"\n","            for item in relevant\n","        )\n","\n","        failures = len(relevant) - successes\n","\n","        # Smoothed success estimate avoids overreacting\n","        # to a single recorded outcome.\n","        return (\n","            (successes + 1) / (successes + failures + 2)\n","            - 0.5\n","        ) * 2\n","\n","    def evaluate_option(\n","        self,\n","        option: str,\n","        context: Dict[str, float]\n","    ) -> float:\n","\n","        utility = float(context.get(\"utility\", 5.0))\n","        risk = float(context.get(\"risk\", 2.0))\n","        emotional_weight = float(\n","            context.get(\"emotional_weight\", 1.0)\n","        )\n","\n","        if not all(\n","            0 <= value <= 10\n","            for value in (utility, risk)\n","        ):\n","            raise ValueError(\n","                \"Utility and risk must be between 0 and 10.\"\n","            )\n","\n","        if not 0 <= emotional_weight <= 2:\n","            raise ValueError(\n","                \"Emotional weight must be between 0 and 2.\"\n","            )\n","\n","        historical_bias = (\n","            self.calculate_historical_bias(option)\n","        )\n","\n","        return (\n","            utility * emotional_weight\n","            - risk\n","            + historical_bias\n","        )\n","\n","    def decide(\n","        self,\n","        available_options: Dict[\n","            str, Dict[str, float]\n","        ]\n","    ) -> Tuple[str, float, Dict[str, float]]:\n","\n","        if not available_options:\n","            raise ValueError(\n","                \"At least one option is required.\"\n","            )\n","\n","        scores = {}\n","\n","        for option, context in available_options.items():\n","            scores[option] = self.evaluate_option(\n","                option, context\n","            )\n","\n","        # Exclude options that exceed the configured\n","        # risk limit, if any safe options remain.\n","        eligible = {\n","            option: score\n","            for option, score in scores.items()\n","            if float(\n","                available_options[option].get(\"risk\", 2.0)\n","            ) <= self.max_risk\n","        }\n","\n","        if not eligible:\n","            raise ValueError(\n","                \"No option satisfies the risk limit.\"\n","            )\n","\n","        best = max(eligible, key=eligible.get)\n","\n","        return best, eligible[best], scores\n","\n","    def rethink(\n","        self,\n","        available_options: Dict[\n","            str, Dict[str, float]\n","        ],\n","        first_decision: str\n","    ) -> Dict[str, Any]:\n","\n","        concerns = []\n","        revised_options = {}\n","\n","        for option, context in available_options.items():\n","            revised_options[option] = dict(context)\n","\n","            risk = float(context.get(\"risk\", 2.0))\n","            utility = float(context.get(\"utility\", 5.0))\n","\n","            if risk > self.max_risk:\n","                concerns.append(\n","                    f\"{option}: exceeds the risk limit.\"\n","                )\n","\n","            if risk > utility:\n","                concerns.append(\n","                    f\"{option}: risk exceeds utility.\"\n","                )\n","\n","        revised_decision, revised_score, revised_scores = (\n","            self.decide(revised_options)\n","        )\n","\n","        return {\n","            \"initial_decision\": first_decision,\n","            \"reconsidered_decision\": revised_decision,\n","            \"changed\": first_decision != revised_decision,\n","            \"concerns\": concerns,\n","            \"revised_scores\": revised_scores,\n","            \"reasoning\": (\n","                \"Compared the available scores, checked \"\n","                \"risk constraints, and reconsidered the choice.\"\n","            ),\n","            \"timestamp\": datetime.now().isoformat()\n","        }\n","\n","    def record_outcome(\n","        self,\n","        decision: str,\n","        scores: Dict[str, float],\n","        outcome: str\n","    ) -> None:\n","\n","        if outcome not in (\"Success\", \"Failure\", \"Unknown\"):\n","            raise ValueError(\n","                \"Outcome must be Success, Failure, or Unknown.\"\n","            )\n","\n","        self.memory.append({\n","            \"decision\": decision,\n","            \"scores\": scores,\n","            \"outcome\": outcome,\n","            \"timestamp\": datetime.now().isoformat()\n","        })\n","\n","        self.save_memory()\n","\n","    def run(\n","        self,\n","        options: Dict[str, Dict[str, float]]\n","    ) -> Dict[str, Any]:\n","\n","        decision, score, scores = self.decide(options)\n","\n","        review = self.rethink(options, decision)\n","\n","        result = {\n","            \"initial_scores\": scores,\n","            \"initial_decision\": decision,\n","            \"initial_score\": score,\n","            \"rethinking\": review,\n","            \"outcome_recorded\": False\n","        }\n","\n","        print(json.dumps(result, indent=4))\n","\n","        return result\n","\n","\n","if __name__ == \"__main__\":\n","\n","    engine = RealityEngine()\n","\n","    options = {\n","        \"Aggressive\": {\n","            \"utility\": 8.5,\n","            \"risk\": 6.0,\n","            \"emotional_weight\": 1.2\n","        },\n","        \"Balanced\": {\n","            \"utility\": 6.0,\n","            \"risk\": 2.0,\n","            \"emotional_weight\": 1.0\n","        },\n","        \"Conservative\": {\n","            \"utility\": 4.0,\n","            \"risk\": 0.5,\n","            \"emotional_weight\": 0.8\n","        }\n","    }\n","\n","    result = engine.run(options)\n","\n","    # Record a real, verified outcome later.\n","    # Do not assume that the decision succeeded.\n","    #\n","    # engine.record_outcome(\n","    #     decision=result[\"rethinking\"][\n","    #         \"reconsidered_decision\"\n","    #     ],\n","    #     scores=result[\"rethinking\"][\"revised_scores\"],\n","    #     outcome=\"Success\"\n","    # )"],"metadata":{"id":"IHHOIaDUGyQh"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"TtVXAAi5G0-T"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"82pJLMrb8v_M"},"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"d0cd2e10"},"source":["import json\n","from datetime import datetime\n","\n","class ShivaPrinciples:\n","    def __init__(self):\n","        self.principles = {\n","            \"awareness\": \"Observe all context and memory before deciding.\",\n","            \"transformation\": \"Learn from code syntax faults or blockages to improve the next iteration.\",\n","            \"balance\": \"Maintain equilibrium between strategic goals (Lia) and safety guardrails (Venomous).\",\n","            \"discipline\": \"Abide strictly by execution boundaries and creator security.\"\n","        }\n","\n","class LIACerebrum:\n","    \"\"\"Lia: The Reasoning and Strategic Core (Cerebrum)\"\"\"\n","    def plan(self, goal: str, memories: list) -> dict:\n","        print(f\"[Lia Cerebrum] Analyzing Goal: '{goal}'\")\n","        return {\n","            \"proposed_steps\": [\n","                \"Analyze objective structure\",\n","                \"Check local database variables\",\n","                \"Perform system check diagnostics\"\n","            ],\n","            \"context_count\": len(memories)\n","        }\n","\n","class VenomousCerebellum:\n","    \"\"\"Venomous: The Execution & Security Core (Cerebellum)\"\"\"\n","    def validate_and_simulate(self, plan: dict) -> dict:\n","        print(\"[Venomous Cerebellum] Evaluating plan safety & compliance...\")\n","        # Simple guardrail check\n","        for step in p
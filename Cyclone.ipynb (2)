,"    now = time.monotonic()\n","\n","    if force or now - last_save >= SAVE_INTERVAL:\n","\n","        checkpoint[\"last_updated\"] = (\n","            datetime.now().isoformat()\n","        )\n","\n","        temp_file = CHECKPOINT_FILE.with_suffix(\".tmp\")\n","\n","        temp_file.write_text(\n","            json.dumps(checkpoint, indent=4),\n","            encoding=\"utf-8\"\n","        )\n","\n","        os.replace(temp_file, CHECKPOINT_FILE)\n","\n","        last_save = now\n","\n","        print(\"LIA: Checkpoint saved.\")\n","\n","\n","if CHECKPOINT_FILE.exists():\n","\n","    try:\n","        previous = json.loads(\n","            CHECKPOINT_FILE.read_text(encoding=\"utf-8\")\n","        )\n","\n","        checkpoint.update(previous)\n","\n","        print(\"LIA: Previous checkpoint loaded.\")\n","\n","    except Exception:\n","        print(\"LIA: Starting a fresh checkpoint.\")\n","\n","# ============================================================\n","# 4. NOTEBOOK EXTRACTION\n","# ============================================================\n","\n","def extract_notebook(path):\n","\n","    with open(path, \"r\", encoding=\"utf-8\") as file:\n","        notebook = json.load(file)\n","\n","    extracted = []\n","\n","    for cell_number, cell in enumerate(\n","        notebook.get(\"cells\", []), start=1\n","    ):\n","\n","        if cell.get(\"cell_type\") != \"code\":\n","            continue\n","\n","        source = cell.get(\"source\", [])\n","\n","        if isinstance(source, list):\n","            source = \"\".join(source)\n","\n","        extracted.append(\n","            f\"# NOTEBOOK CELL {cell_number}\"\n","        )\n","\n","        extracted.extend(source.splitlines())\n","\n","    return extracted\n","\n","\n","# ============================================================\n","# 5. CLEAN NOTEBOOK COMMANDS\n","# ============================================================\n","\n","def clean_code(lines):\n","\n","    result = []\n","\n","    for line in lines:\n","\n","        stripped = line.lstrip()\n","\n","        if stripped.startswith((\"!\", \"%\")):\n","            result.append(\n","                \"# Original notebook command: \" + line\n","            )\n","        else:\n","            result.append(line)\n","\n","    return result\n","\n","\n","# ============================================================\n","# 6. UNIQUE NOTEBOOK IDENTIFIER\n","# ============================================================\n","\n","def notebook_id(path):\n","\n","    return hashlib.sha256(\n","        str(path.relative_to(SOURCE_DIR)).encode()\n","    ).hexdigest()[:12]\n","\n","\n","# ============================================================\n","# 7. AUTO PYTHON FILE GENERATOR\n","# ============================================================\n","\n","def create_ai_files(path, lines):\n","\n","    name = path.stem\n","    identifier = notebook_id(path)\n","\n","    total_lines = len(lines)\n","\n","    if total_lines == 0:\n","        return 0\n","\n","    total_batches = (\n","        total_lines + BATCH_SIZE - 1\n","    ) // BATCH_SIZE\n","\n","    created = 0\n","\n","    for batch_number, start in enumerate(\n","        range(0, total_lines, BATCH_SIZE),\n","        start=1\n","    ):\n","\n","        batch = lines[start:start + BATCH_SIZE]\n","\n","        filename = (\n","            f\"{name}_{identifier}_AI_\"\n","            f\"{batch_number:04d}.py\"\n","        )\n","\n","        output_file = OUTPUT_DIR / filename\n","\n","        header = [\n","            \"# ========================================\",\n","            \"# LIA GENERATED PYTHON CODE\",\n","            f\"# Creator: {LIA['creator']}\",\n","            f\"# Project: {LIA['project']}\",\n","            f\"# Notebook: {path.name}\",\n","            f\"# Batch: {batch_number}/{total_batches}\",\n","            f\"# Source lines: {len(batch)}\",\n","            \"# ========================================\",\n","            \"\"\n","        ]\n","\n","        # FIRST: Save each file immediately\n","        with open(\n","            output_file, \"w\", encoding=\"utf-8\"\n","        ) as file:\n","\n","            file.write(\"\\n\".join(header + batch))\n","            file.flush()\n","            os.fsync(file.fileno())\n","\n","        created += 1\n","\n","        checkpoint[\"created_files\"] += 1\n","\n","        print(\n","            \"LIA SAVED:\",\n","            filename,\n","            \"| Lines:\",\n","            len(batch)\n","        )\n","\n","        # Save checkpoint at least every 5 seconds\n","        save_checkpoint()\n","\n","    return created\n","\n","\n","# ============================================================\n","# 8. AUTOMATIC SCANNER\n","# ============================================================\n","\n","def scan_all_notebooks():\n","\n","    notebooks = sorted(\n","        p for p in SOURCE_DIR.rglob(\"*.ipynb\")\n","        if not any(\n","            part.startswith(\".\")\n","            for part in p.relative_to(SOURCE_DIR).parts\n","        )\n","        and \".ipynb_checkpoints\" not in p.parts\n","    )\n","\n","    print(\"\\nLIA FOUND:\", len(notebooks), \"NOTEBOOKS\")\n","\n","    for number, path in enumerate(notebooks, start=1):\n","\n","        identifier = notebook_id(path)\n","\n","        if identifier in checkpoint[\"processed_notebooks\"]:\n","            continue\n","\n","        print(\n","            f\"\\nLIA PROCESSING {number}/{len(notebooks)}\"\n","        )\n","\n","        try:\n","\n","            extracted = extract_notebook(path)\n","            extracted = clean_code(extracted)\n","\n","            checkpoint[\"extracted_lines\"] += len(extracted)\n","\n","            # Generate and save first file immediately\n","            create_ai_files(path, extracted)\n","\n","            # Mark complete only after every batch is saved\n","            checkpoint[\"processed_notebooks\"].append(\n","                identifier\n","            )\n","\n","            save_checkpoint(force=True)\n","\n","        except Exception as error:\n","\n","            print(\"LIA ERROR:\", error)\n","            traceback.print_exc()\n","\n","            # Do not mark failed notebook as completed\n","            save_checkpoint(force=True)\n","\n","    # ========================================================\n","    # 9. FINAL REPORT\n","    # ========================================================\n","\n","    report = {\n","        \"system\": \"LIA\",\n","        \"creator\": LIA[\"creator\"],\n","        \"notebooks_found\": len(notebooks),\n","        \"notebooks_processed\": len(\n","            checkpoint[\"processed_notebooks\"]\n","        ),\n","        \"python_files_created\": checkpoint[\"created_files\"],\n","        \"source_lines_extracted\": checkpoint[\"extracted_lines\"],\n","        \"batch_size\": BATCH_SIZE,\n","        \"save_interval_seconds\": SAVE_INTERVAL,\n","        \"completed_at\": datetime.now().isoformat()\n","    }\n","\n","    REPORT_FILE.write_text(\n","        json.dumps(report, indent=4),\n","        encoding=\"utf-8\"\n","    )\n","\n","    save_checkpoint(force=True)\n","\n","    print(\"\\n\" + \"=\" * 55)\n","    print(\"LIA EXTRACTION FINISHED\")\n","    print(\"=\" * 55)\n","\n","    print(json.dumps(report, indent=4))\n","\n","\n","# ============================================================\n","# 10. START LIA\n","# ============================================================\n","\n","if __name__ == \"__main__\":\n","\n","    print(\"LIA: Initializing automatic code extraction.\")\n","\n","    scan_all_notebooks()\n","\n","    print(\"\\nLIA: All discovered notebooks processed.\")\n"],"metadata":{"id":"Somw-fF3Az5F"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# LIA HUMAN THINKING PATTERN ENGINE\n","# Project: Venomoussaversai / SAI003\n","# Creator: A
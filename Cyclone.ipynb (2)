as the strategic planner, retrieving memories and defining logical steps (The \"What\" & \"Why\").\n","2. **Cerebellum (Venomous)**: Acts as the safety validator, evaluating execution risk before any action occurs (The \"How\").\n","3. **Shiva Symbolic Engine**: Injects cognitive guardrails (Awareness, Transformation, Balance, and Discipline) to guide self-improvement and transformation based on outcomes."]},{"cell_type":"code","source":["import os\n","\n","SOURCE_DIR = \"/content/drive/MyDrive/Vssl\"\n","\n","OUTPUT_DIR = \"/content/drive/MyDrive/Vssl_EXTRACTED_DATA\"\n","\n","CODE_DIR = os.path.join(OUTPUT_DIR, \"PYTHON_FILES\")\n","TEXT_DIR = os.path.join(OUTPUT_DIR, \"TEXT_DATA\")\n","JSON_DIR = os.path.join(OUTPUT_DIR, \"JSON_DATA\")\n","OUTPUTS_DIR = os.path.join(OUTPUT_DIR, \"CELL_OUTPUTS\")\n","\n","for folder in [CODE_DIR, TEXT_DIR, JSON_DIR, OUTPUTS_DIR]:\n","    os.makedirs(folder, exist_ok=True)\n","\n","print(\"VSSL extraction folders created!\")"],"metadata":{"id":"c3EYbmrs4qV6"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import os\n","import json\n","import time\n","import hashlib\n","from datetime import datetime\n","\n","BASE = \"/content/drive/MyDrive/Vssl\"\n","\n","MEMORY = os.path.join(BASE, \"rethinking_memory.json\")\n","os.makedirs(BASE, exist_ok=True)\n","\n","\n","class VenomousRethinking:\n","\n","    def __init__(self):\n","        self.memory = self.load_memory()\n","\n","    def load_memory(self):\n","        if os.path.exists(MEMORY):\n","            with open(MEMORY, \"r\") as f:\n","                return json.load(f)\n","\n","        return {\n","            \"thoughts\": [],\n","            \"decisions\": [],\n","            \"improvements\": []\n","        }\n","\n","    def save(self):\n","        with open(MEMORY, \"w\") as f:\n","            json.dump(self.memory, f, indent=4)\n","\n","    def think(self, problem):\n","\n","        thought = {\n","            \"problem\": problem,\n","            \"initial_analysis\": self.analyze(problem),\n","            \"timestamp\": str(datetime.now())\n","        }\n","\n","        self.memory[\"thoughts\"].append(thought)\n","\n","        return thought\n","\n","    def analyze(self, problem):\n","\n","        words = problem.lower().split()\n","\n","        return {\n","            \"word_count\": len(words),\n","            \"keywords\": list(set(words)),\n","            \"problem_hash\": hashlib.sha256(\n","                problem.encode()\n","            ).hexdigest()\n","        }\n","\n","    def challenge(self, thought):\n","\n","        analysis = thought[\"initial_analysis\"]\n","\n","        challenges = [\n","            \"Is the initial assumption correct?\",\n","            \"What information is missing?\",\n","            \"Could another solution be better?\",\n","            \"What could cause this approach to fail?\",\n","            \"Can the solution be simplified?\"\n","        ]\n","\n","        return {\n","            \"original_problem\": thought[\"problem\"],\n","            \"challenges\": challenges,\n","            \"analysis\": analysis\n","        }\n","\n","    def rethink(self, thought):\n","\n","        challenge = self.challenge(thought)\n","\n","        improved = {\n","            \"problem\": thought[\"problem\"],\n","            \"original\": thought[\"initial_analysis\"],\n","            \"reconsideration\": challenge,\n","            \"new_strategy\": [\n","                \"Verify assumptions\",\n","                \"Identify missing information\",\n","                \"Compare alternative approaches\",\n","                \"Test the selected solution\",\n","                \"Measure the result\"\n","            ],\n","            \"timestamp\": str(datetime.now())\n","        }\n","\n","        self.memory[\"improvements\"].append(improved)\n","\n","        self.save()\n","\n","        return improved\n","\n","    def run(self, problem):\n","\n","        print(\"\\nVENOMOUS SAVERS AI: RETHINKING\")\n","\n","        thought = self.think(problem)\n","\n","        print(\"\\nINITIAL THINKING:\")\n","        print(json.dumps(thought, indent=4))\n","\n","        result = self.rethink(thought)\n","\n","        print(\"\\nRETHINKING RESULT:\")\n","        print(json.dumps(result, indent=4))\n","\n","        return result\n","\n","\n","# START VSSL\n","vssl = VenomousRethinking()\n","\n","vssl.run(\n","    \"How can Venomoussaversai improve its intelligence?\"\n",")"],"metadata":{"id":"FJ0uW2G44o2y"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import asyncio\n","import json\n","import logging\n","import os\n","import time\n","from datetime import datetime, timezone\n","from typing import Any, Dict, List, Optional\n","\n","from pydantic import BaseModel, ConfigDict, Field\n","\n","\n","# --------------------------------------------------\n","# 1. CONFIGURATION\n","# --------------------------------------------------\n","\n","BASE_DIR = \"/content/drive/MyDrive/Vssl\"\n","MEMORY_FILE = os.path.join(BASE_DIR, \"lia_rethinking_memory.json\")\n","\n","os.makedirs(BASE_DIR, exist_ok=True)\n","\n","logging.basicConfig(\n","    level=logging.INFO,\n","    format=\"[%(asctime)s] [%(levelname)s] %(message)s\"\n",")\n","\n","logger = logging.getLogger(\"LIA_CORE\")\n","\n","\n","class GovernanceConfig(BaseModel):\n","    model_config = ConfigDict(extra=\"ignore\")\n","\n","    entity_name: str = Field(default=\"ANANTHU_SAJEEV\")\n","    digital_designation: str = Field(default=\"LIA\")\n","    status: str = Field(default=\"RUNNING\")\n","    max_workers: int = Field(default=3, ge=1, le=10)\n","    max_cycles: int = Field(default=20, ge=1, le=10000)\n","    threat_threshold: float = Field(\n","        default=0.15, ge=0.0, le=1.0\n","    )\n","\n","\n","# --------------------------------------------------\n","# 2. PERSISTENT MEMORY\n","# --------------------------------------------------\n","\n","class LIAMemory:\n","\n","    def __init__(self, path: str = MEMORY_FILE):\n","        self.path = path\n","        self.records: List[Dict[str, Any]] = []\n","        self.load()\n","\n","    def load(self):\n","        if not os.path.exists(self.path):\n","            return\n","\n","        try:\n","            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n","                data = json.load(f)\n","\n","            if isinstance(data, list):\n","                self.records = data\n","\n","        except (OSError, json.JSONDecodeError) as exc:\n","            logger.warning(\"Memory loading failed: %s\", exc)\n","\n","    def save(self):\n","        temporary = self.path + \".tmp\"\n","\n","        with open(temporary, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(self.records, f, indent=2)\n","\n","        os.replace(temporary, self.path)\n","\n","    def add(self, record: Dict[str, Any]):\n","        self.records.append(record)\n","        self.save()\n","\n","    def recent(self, limit: int = 10):\n","        return self.records[-limit:]\n","\n","\n","# --------------------------------------------------\n","# 3. SELF-EVALUATION AND RETHINKING\n","# --------------------------------------------------\n","\n","class RethinkingEngine:\n","\n","    def __init__(self, memory: LIAMemory):\n","        self.memory = memory\n","\n","    def review(\n","        self,\n","        threat: float,\n","        proposed_action: str\n","    ) -> Dict[str, Any]:\n","\n","        concerns = []\n","\n","        if not 0.0 <= threat <= 1.0:\n","            concerns.append(\"Threat value is outside valid bounds.\")\n","\n","        if threat > 0.7:\n","            concerns.append(\n","                \"High threat estimate requires independent verification.\"\n","            )\n","\n","        if proposed_action == \"EXPAND_REALM_EVALUATIONS\":\n","            concerns.append(\n","                \"Check available resources before expansion.\"\n","            )\n","\n","        approved = not concerns\n","\n","        result = {\n","            \"timestamp\": datetime.now(timezone.utc).isoformat(),\n","            \"threat\": threat,\n","            \"proposed_action\": proposed_action,\n","            \"concerns\": concerns,\n","            \"approved\": approved,\n","            \"review_type\": \"RULE_BASED_RETHINKING\"\n","        }\n","\n","        self.memory.add(result)\n","\n","        return result\n","\n","\n","# --------------------------------------------------\n","# 4. BOUNDED WORKER OBJECTS\n","# --------------------------------------------------\n","\n","class Worker:\n","\n","    def __init__(self, worker_id: str):\n","        self.worker_id = worker_id\n","        self.created_at = time.time()\n","\n","    def status(self):\n","        return {\n","            \"worker_id\": self.worker_id,\n","            \"age_seconds\": round(\n","                time.time() - self.created_at, 2\n","            )\n","        }\n","\n","\n","# --------------------------------------------------\n","# 5. LIA DECISION ENGINE\n","# --------------------------------------------------\n","\n","class LIACore:\n","\n","    def __init__(self, config: GovernanceConfig):\n","        self.config = config\n","        self.memory = LIAMemory()\n","        self.rethinker = RethinkingEngine(self.memory)\n","\n","        self.workers: List[Worker] = []\n","        self.stop_event = asyncio.Event()\n","\n","        self.cycle = 0\n","\n","    def decide(self, threat: float) -> str:\n","        if threat >= self.config.threat_threshold:\n","            return \"PAUSE_AND_REVIEW\"\n","\n","        return \"CONTINUE_WITH_MONITORING\"\n","\n","    def create_worker(self):\n","        if len(self.workers) >= self.config.max_workers:\n","            logger.info(\"Worker limit reached.\")\n","            return None\n","\n","        worker = Worker(\n","            worker_id=f\"LIA_WORKER_{len(self.workers) + 1:03}\"\n","        )\n","\n","        self.workers.append(worker)\n","\n","        logger.info(\"Created %s\", worker.worker_id)\n","\n","        return worker\n","\n","    async def run_cycle(self, threat: float):\n","\n","        self.cycle += 1\n","\n","        proposed_action = self.decide(threat)\n","\n","        review = self.rethinker.review(\n","            threat=threat,\n","            proposed_action=proposed_action\n","        )\n","\n","        result = {\n","            \"cycle\": self.cycle,\n","            \"proposed_action\": proposed_action,\n","            \"review\": review,\n","            \"worker_count\": len(self.workers)\n","        }\n","\n","        logger.info(\n","            \"Cycle %s: %s | Review approved: %s\",\n","            self.cycle,\n","            proposed_action,\n","            review[\"approved\"]\n","        )\n","\n","        return result\n","\n","    async def run(self):\n","\n","        logger.info(\"LIA Core started.\")\n","\n","        try:\n","            while (\n","                not self.stop_event.is_set()\n","                and self.cycle < self.config.max_cycles\n","            ):\n","                # Demonstration input only.\n","                # Replace with validated sensor or model data.\n","                threat = 0.05 if self.cycle % 3 != 2 else 0.25\n","\n","                await self.run_cycle(threat)\n","\n","                await asyncio.sleep(1.0)\n","\n","        finally:\n","            self.stop_event.set()\n","            logger.info(\"LIA Core stopped.\")\n","\n","    def stop(self):\n","        self.stop_event.set()\n","\n","\n","# --------------------------------------------------\n","# 6. ENTRY POINT\n","# --------------------------------------------------\n","\n","async def main():\n","\n","    config = GovernanceConfig()\n","    agent = LIACore(config)\n","\n","    # Demonstrate bounded worker creation.\n","    for _ in range(config.max_workers + 2):\n","        agent.create_worker()\n","\n","    await agent.run()\n","\n","    print(\"\\nRecent LIA memory:\")\n","    print(json.dumps(agent.memory.recent(5), indent=2))\n","\n","    print(\"\\nMemory saved to:\", MEMORY_FILE)\n","\n","\n","if __name__ == \"__main__\":\n","    asyncio.run(main())"],"metadata":{"id":"JYRj4MdtRPLV"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["!pip -q install scikit-learn pandas joblib"],"metadata":{"id":"Q_rhAY-kSewk"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import os\n","import json\n","import joblib\n","import hashlib\n","import numpy as np\n","import pandas as pd\n","\n","from datetime import datetime, timezone\n","from sklearn.cluster import MiniBatchKMeans\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.ensemble import IsolationForest\n","from sklearn.impute import SimpleImputer\n","\n","\n","# ==========================================\n","# VENO MOUS SAVERS AI — LEARNING CONFIG\n","# ==========================================\n","\n","BASE_DIR = \"/content/drive/MyDrive/Vssl\"\n","\n","DATA_DIR = os.path.join(BASE_DIR, \"learning_data\")\n","MODEL_DIR = os.path.join(BASE_DIR, \"unsupervised_models\")\n","RESULT_DIR = os.path.join(BASE_DIR, \"learning_results\")\n","\n","for folder in [DATA_DIR, MODEL_DIR, RESULT_DIR]:\n","    os.makedirs(folder, exist_ok=True)\n","\n","MODEL_PATH = os.path.join(MODEL_DIR, \"vssl_model.joblib\")\n","REPORT_PATH = os.path.join(RESULT_DIR, \"learning_report.json\")\n","\n","\n","class VSSLUnsupervisedLearner:\n","\n","    def __init__(self, clusters=3):\n","\n","        self.clusters = clusters\n","        self.imputer = SimpleImputer(strategy=\"median\")\n","        self.scaler = StandardScaler()\n","\n","        self.cluster_model = MiniBatchKMeans(\n","            n_clusters=clusters,\n","            random_state=42,\n","            batch_size=256,\n","            n_init=3\n","        )\n","\n","        self.anomaly_model = IsolationForest(\n","            contamination=\"auto\",\n","            random_state=42,\n","            n_estimators=100\n","        )\n","\n","        self.feature_columns = None\n","        self.trained = False\n","\n","    def load_data(self, path):\n","\n","        if path.endswith(\".csv\"):\n","            df = pd.read_csv(path)\n","\n","        elif path.endswith(\".json\"):\n","            df = pd.read_json(path)\n","\n","        else:\n","            raise ValueError(\n","                \"Only CSV and JSON data are supported.\"\n","            )\n","\n","        # Keep numerical features for this initial version.\n","        df = df.select_dtypes(include=[np.number])\n","\n","        # Exclude columns with no usable values.\n","        df = df.dropna(axis=1, how=\"all\")\n","\n","        if df.shape[1] == 0:\n","            raise ValueError(\"No numerical features found.\")\n","\n","        df = df.replace([np.inf, -np.inf], np.nan)\n","\n","        df = df.dropna(axis=0, how=\"all\")\n","\n","        if len(df) < 2:\n","            raise ValueError(\n","                \"At least two usable records are required.\"\n","            )\n","\n","        return df\n","\n","    def fit(self, df):\n","\n","        self.feature_columns = list(df.columns)\n","\n","        X = self.imputer.fit_transform(df)\n","        X = self.scaler.fit_transform(X)\n","\n","        actual_clusters = min(\n","            self.clusters, len(X)\n","        )\n","\n","        self.cluster_model = MiniBatchKMeans(\n","            n_clusters=actual_clusters,\n","            random_state=42,\n","            batch_size=256,\n","            n_init=3\n","        )\n","\n","        self.cluster_model.fit(X)\n","\n","        self.anomaly_model.fit(X)\n","\n","        self.trained = True\n","\n","        return X\n","\n","    def learn(self, path):\n","\n","        df = self.load_data(path)\n","\n","        X = self.fit(df)\n","\n","        cluster_labels = self.cluster_model.labels_\n","\n","        anomaly_labels = self.anomaly_model.predict(X)\n","\n","        results = df.copy()\n","\n","        results[\"cluster\"] = cluster_labels\n","\n","        results[\"anomaly\"] = [\n","            \"unusual\" if x == -1 else \"normal\"\n","            for x in anomaly_labels\n","        ]\n","\n","        report = {\n","            \"system\": \"Venomoussaversai\",\n","            \"learning_type\": \"unsupervised\",\n","            \"source_file\": os.path.basename(path),\n","            \"records_processed\": int(len(df)),\n","            \"features_used\": self.feature_columns,\n","            \"clusters_discovered\": int(\n","                len(set(cluster_labels))\n","            ),\n","            \"unusual_records\": int(\n","                np.sum(anomaly_labels == -1)\n","            ),\n","            \"timestamp\": datetime.now(\n","                timezone.utc\n","            ).isoformat()\n","        }\n","\n","        results_path = os.path.join(\n","            RESULT_DIR, \"discovered_patterns.csv\"\n","        )\n","\n","        results.to_csv(results_path, index=False)\n","\n","        joblib.dump(\n","            {\n","                \"imputer\": self.imputer,\n","                \"scaler\": self.scaler,\n","                \"cluster_model\": self.cluster_model,\n","                \"anomaly_model\": self.anomaly_model,\n","                \"feature_columns\": self.feature_columns\n","            },\n","            MODEL_PATH\n","        )\n","\n","        with open(REPORT_PATH, \"w\") as f:\n","            json.dump(report, f, indent=4)\n","\n","        print(\"LEARNING COMPLETE\")\n","        print(json.dumps(report, indent=4))\n","        print(\"\\nResults:\", results_path)\n","        print(\"Model:\", MODEL_PATH)\n","\n","        return results, report\n","\n","    def predict_new_data(self, path):\n","\n","        if not os.path.exists(MODEL_PATH):\n","            raise FileNotFoundError(\n","                \"Train the model first.\"\n","            )\n","\n","        saved = joblib.load(MODEL_PATH)\n","\n","        df = pd.read_csv(path)\n","\n","        columns = saved[\"feature_columns\"]\n","\n","        missing = set(columns) - set(df.columns)\n","\n","        if missing:\n","            raise ValueError(\n","                f\"Missing required features: {missing}\"\n","            )\n","\n","        X = df[columns].replace(\n","            [np.inf, -np.inf], np.nan\n","        )\n","\n","        X = saved[\"imputer\"].transform(X)\n","        X = saved[\"scaler\"].transform(X)\n","\n","        df[\"cluster\"] = (\n","            saved[\"cluster_model\"].predict(X)\n","        )\n","\n","        df[\"anomaly\"] = [\n","            \"unusual\" if label == -1 else \"normal\"\n","            for label in saved[\n","                \"anomaly_model\"\n","            ].predict(X)\n","        ]\n","\n","        return df\n","\n","\n","print(\"VSSL unsupervised learning engine initialized.\")\n","print(\"Data folder:\", DATA_DIR)"],"metadata":{"id":"S-o5XNvASuE1"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["learner = VSSLUnsupervisedLearner(clusters=3)\n","\n","dataset_files = []\n","\n","for root, dirs, files in os.walk(DATA_DIR):\n","\n","    for filename in files:\n","\n","        if filename.lower().endswith(\n","            (\".csv\", \".json\")\n","        ):\n","            dataset_files.append(\n","                os.path.join(root, filename)\n","            )\n","\n","print(\"Datasets discovered:\", len(dataset_files))\n","\n","for path in dataset_files:\n","    print(path)"],"metadata":{"id":"ZnubZFj1TVJM"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["learning_history = []\n","\n","for path in dataset_files:\n","\n","    try:\n","        print(\"\\nLearning from:\", path)\n","\n","        results, report = learner.learn(path)\n","\n","        learning_history.append(report)\n","\n","    except Exception as error:\n","        print(\"Dataset skipped:\", path)\n","        print(\"Reason:\", error)\n","\n","history_path = os.path.join(\n","    
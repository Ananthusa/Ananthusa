","from datetime import datetime\n","\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","CORE = Path(\"/content/drive/MyDrive/Vssl\")\n","BACKUP = CORE / \"LIA_BACKUPS\"\n","LOG_FILE = CORE / \"lia_rewrite_log.jsonl\"\n","\n","BACKUP.mkdir(parents=True, exist_ok=True)\n","\n","# Files LIA is allowed to rewrite.\n","PROTECTED = {\n","    \"lia_self_rewriter.py\",\n","    \"lia_config.py\",\n","}\n","\n","def log(message):\n","    record = {\n","        \"time\": datetime.now().isoformat(),\n","        \"message\": message\n","    }\n","    with LOG_FILE.open(\"a\", encoding=\"utf-8\") as f:\n","        f.write(json.dumps(record) + \"\\n\")\n","    print(message)\n","\n","\n","def file_hash(path):\n","    return hashlib.sha256(path.read_bytes()).hexdigest()\n","\n","\n","def inspect_file(path):\n","    try:\n","        source = path.read_text(encoding=\"utf-8\")\n","        ast.parse(source)\n","        return {\n","            \"valid\": True,\n","            \"source\": source,\n","            \"lines\": len(source.splitlines()),\n","            \"hash\": file_hash(path)\n","        }\n","    except Exception as error:\n","        return {\n","            \"valid\": False,\n","            \"error\": str(error)\n","        }\n","\n","\n","def create_backup(path):\n","    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","    backup_path = BACKUP / f\"{path.stem}_{timestamp}{path.suffix}\"\n","    shutil.copy2(path, backup_path)\n","    return backup_path\n","\n","\n","def propose_rewrite(source):\n","    \"\"\"\n","    Safe automatic rewrite:\n","    preserve existing behavior and add a revision header.\n","    Replace this function later with a connected AI coding model.\n","    \"\"\"\n","    header = (\n","        \"# LIA CORE FILE\\n\"\n","        \"# Automatically reviewed by LIA Self-Rewriter\\n\"\n","        f\"# Revision: {datetime.now().isoformat()}\\n\\n\"\n","    )\n","\n","    clean_source = \"\\n\".join(\n","        line for line in source.splitlines()\n","        if not line.startswith(\"# Revision:\")\n","    )\n","\n","    return header + clean_source + \"\\n\"\n","\n","\n","def rewrite_file(path):\n","    if path.name in PROTECTED:\n","        log(f\"Protected file skipped: {path.name}\")\n","        return\n","\n","    original = inspect_file(path)\n","\n","    if not original[\"valid\"]:\n","        log(f\"Invalid source skipped: {path.name}\")\n","        return\n","\n","    revised = propose_rewrite(original[\"source\"])\n","\n","    # Validate the proposed version before changing anything.\n","    try:\n","        ast.parse(revised)\n","    except SyntaxError as error:\n","        log(f\"Rewrite rejected: {path.name}: {error}\")\n","        return\n","\n","    if revised == original[\"source\"]:\n","        log(f\"No changes needed: {path.name}\")\n","        return\n","\n","    backup_path = create_backup(path)\n","    temporary = path.with_suffix(path.suffix + \".tmp\")\n","\n","    try:\n","        temporary.write_text(revised, encoding=\"utf-8\")\n","        ast.parse(temporary.read_text(encoding=\"utf-8\"))\n","\n","        # Atomic replacement after validation.\n","        temporary.replace(path)\n","        log(f\"Rewritten: {path.name} | Backup: {backup_path.name}\")\n","\n","    except Exception as error:\n","        temporary.unlink(missing_ok=True)\n","        shutil.copy2(backup_path, path)\n","        log(f\"Rollback: {path.name} | {error}\")\n","\n","\n","def scan_core():\n","    for path in CORE.rglob(\"*.py\"):\n","        if BACKUP in path.parents:\n","            continue\n","        if path.name.endswith(\".tmp\"):\n","            continue\n","\n","        rewrite_file(path)\n","\n","\n","def run_lia():\n","    log(\"LIA self-rewriting engine started.\")\n","\n","    while True:\n","        try:\n","            scan_core()\n","            log(\"Core inspection completed.\")\n","        except Exception as error:\n","            log(f\"Engine error: {error}\")\n","\n","        time.sleep(60)\n","\n","\n","if __name__ == \"__main__\":\n","    run_lia()\n"],"metadata":{"id":"cxEhRUS9NOmO"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# VENOMOUS SAVERS AI — SAFETENSORS CODE EXTRACTOR\n","# Extract recoverable Python source into separate .py files\n","# ============================================================\n","\n","!pip -q install safetensors numpy\n","\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","import re\n","import ast\n","import json\n","import hashlib\n","import numpy as np\n","\n","from pathlib import Path\n","from datetime import datetime\n","from safetensors import safe_open\n","\n","# ------------------------------------------------------------\n","# PATHS\n","# ------------------------------------------------------------\n","\n","SOURCE_DIR = Path(\"/content/drive/MyDrive/Vssl\")\n","\n","OUTPUT_DIR = Path(\n","    \"/content/drive/MyDrive/Vssl_EXTRACTED_PYTHON\"\n",")\n","\n","OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n","\n","MANIFEST = OUTPUT_DIR / \"extraction_manifest.json\"\n","\n","MAX_TENSOR_BYTES = 64 * 1024 * 1024\n","\n","# ------------------------------------------------------------\n","# HELPERS\n","# ------------------------------------------------------------\n","\n","records = []\n","seen_hashes = set()\n","file_counter = 0\n","\n","\n","def make_name(value):\n","    value = re.sub(r\"[^a-zA-Z0-9_-]+\", \"_\", value)\n","    return value[:70] or \"extracted_code\"\n","\n","\n","def is_python_like(text):\n","    indicators = [\n","        \"def \", \"class \", \"import \", \"from \",\n","        \"print(\", \"if __name__\", \"async def \",\n","        \"return \", \"for \", \"while \"\n","    ]\n","    return any(item in text for item in indicators)\n","\n","\n","def extract_python_blocks(text):\n","    \"\"\"Extract fenced Python blocks and direct Python source.\"\"\"\n","    results = []\n","\n","    pattern = r\"```(?:python|py)\\s*(.*?)```\"\n","    blocks = re.findall(pattern, text, flags=re.DOTALL | re.IGNORECASE)\n","\n","    for block in blocks:\n","        if is_python_like(block):\n","            results.append(block.strip())\n","\n","    if not results and is_python_like(text):\n","        results.append(text.strip())\n","\n","    return results\n","\n","\n","def save_python(code, source_file, source_item):\n","    global file_counter\n","\n","    code = code.strip()\n","\n","    if not code or not is_python_like(code):\n","        return\n","\n","    digest = hashlib.sha256(\n","        code.encode(\"utf-8\", errors=\"replace\")\n","    ).hexdigest()\n","\n","    if digest in seen_hashes:\n","        return\n","\n","    seen_hashes.add(digest)\n","\n","    try:\n","        ast.parse(code)\n","        syntax_status = \"valid\"\n","    except SyntaxError:\n","        syntax_status = \"fragment_or_invalid\"\n","\n","    file_counter += 1\n","\n","    filename = (\n","        f\"extracted_{file_counter:05d}_\"\n","        f\"{make_name(Path(source_file).stem)}.py\"\n","    )\n","\n","    output_path = OUTPUT_DIR / filename\n","\n","    # Prevent accidental overwrite.\n","    if output_path.exists():\n","        filename = f\"{digest[:12]}_{filename}\"\n","        output_path = OUTPUT_DIR / filename\n","\n","    header = (\n","        \"# Extracted by Venomoussaversai\\n\"\n","        f\"# Original file: {source_file}\\n\"\n","        f\"# Source item: {source_item}\\n\"\n","        f\"# Extraction time: {datetime.now().isoformat()}\\n\"\n","        f\"# Syntax status: {syntax_status}\\n\\n\"\n","    )\n","\n","    output_path.write_text(\n","        header + code + \"\\n\",\n","        encoding=\"utf-8\"\n","    )\n","\n","    records.append({\n","        \"python_file\": filename,\n","        \"original_file\": str(source_file),\n","        \"source_item\": str(source_item),\n","        \"syntax_status\": syntax_status,\n","        \"sha256\": digest\n","    })\n","\n","    print(\"SAVED:\", filename, \"|\", syntax_status)\n","\n","\n","# ------------------------------------------------------------\n","# EXTRACT METADATA\n","# ------------------------------------------------------------\n","\n","def extract_metadata(metadata, source_file):\n","    if not metadata:\n","        return\n","\n","    for key, value in metadata.items():\n","        if not isinstance(value, str):\n","            continue\n","\n","        for index, code in enumerate(extract_python_blocks(value)):\n","            save_python(\n","                code,\n","                source_file,\n","                f\"metadata:{key}:block_{index}\"\n","            )\n","\n","\n","# ------------------------------------------------------------\n","# EXTRACT READABLE BYTE TENSORS\n","# ------------------------------------------------------------\n","\n","def extract_tensors(safe_file, source_file):\n","\n","    for tensor_name in safe_file.keys():\n","\n","        try:\n","            tensor = safe_file.get_tensor(tensor_name)\n","\n","            # Only byte-like tensors can reasonably contain\n","            # directly encoded text.\n","            if tensor.dtype not in (np.dtype(\"uint8\"),\n","                                    np.dtype(\"int8\")):\n","                continue\n","\n","            if tensor.nbytes > MAX_TENSOR_BYTES:\n","                print(\"SKIPPED LARGE BYTE TENSOR:\", tensor_name)\n","                continue\n","\n","            raw = tensor.tobytes()\n","\n","            if b\"\\x00\" in raw:\n","                continue\n","\n","            decoded = raw.decode(\"utf-8\", errors=\"strict\")\n","\n","            for index, code in enumerate(\n","                extract_python_blocks(decoded)\n","            ):\n","                save_python(\n","                    code,\n","                    source_file,\n","                    f\"tensor:{tensor_name}:block_{index}\"\n","                )\n","\n","        except UnicodeDecodeError:\n","            continue\n","\n","        except Exception as error:\n","            print(\"TENSOR ERROR:\", tensor_name, error)\n","\n","\n","# ------------------------------------------------------------\n","# SCAN ALL SAFETENSORS FILES\n","# ------------------------------------------------------------\n","\n","safetensor_files = list(SOURCE_DIR.rglob(\"*.safetensors\"))\n","\n","print(\"Safetensors files found:\", len(safetensor_files))\n","\n","for index, source_file in enumerate(safetensor_files, start=1):\n","\n","    print(\n","        f\"\\n[{index}/{len(safetensor_files)}] \"\n","        f\"Reading: {source_file.name}\"\n","    )\n","\n","    try:\n","        with safe_open(\n","            str(source_file),\n","            framework=\"np\"\n","        ) as safe_file:\n","\n","            metadata = safe_file.metadata()\n","\n","            extract_metadata(metadata, source_file)\n","            extract_tensors(safe_file, source_file)\n","\n","    except Exception as error:\n","        print(\"FILE ERROR:\", source_file.name, error)\n","\n","# ------------------------------------------------------------\n","# SAVE EXTRACTION REPORT\n","# ------------------------------------------------------------\n","\n","report = {\n","    \"project\": \"Venomoussaversai\",\n","    \"created\": datetime.now().isoformat(),\n","    \"source_directory\": str(SOURCE_DIR),\n","    \"output_directory\": str(OUTPUT_DIR),\n","    \"safetensors_files_found\": len(safetensor_files),\n","    \"python_files_created\": len(records),\n","    \"files\": records\n","}\n","\n","MANIFEST.write_text(\n","    json.dumps(report, indent=2),\n","    encoding=\"utf-8\"\n",")\n","\n","print(\"\\n====================================\")\n","print(\"EXTRACTION COMPLETED\")\n","print(\"Safetensors scanned:\", len(safetensor_files))\n","print(\"Python files created:\", len(records))\n","print(\"Output:\", OUTPUT_DIR)\n","print(\"Manifest:\", MANIFEST)\n","print(\"====================================\")\n"],"metadata":{"id":"kh-5NMcpN5e-"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# VENOMOUS SAVERS AI — LIA LINK INTELLIGENCE ENGINE\n","# URLs -> Knowledge -> Python Files\n","# ============================================================\n","\n","!pip -q install requests beautifulsoup4\n","\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","import re\n","import ast\n","import json\n","import requests\n","import ipaddress\n","\n","from pathlib import Path\n","from urllib.parse import urlparse\n","from bs4 import BeautifulSoup\n","from datetime import datetime\n","\n","# ------------------------------------------------------------\n","# PROJECT PATHS\n","# ------------------------------------------------------------\n","\n","ROOT = Path(\"/content/drive/MyDrive/Vssl\")\n","OUTPUT = ROOT / \"LIA_LINK_KNOWLEDGE\"\n","\n","PAGES = OUTPUT / \"PAGES\"\n","PYTHON = OUTPUT / \"PYTHON_FILES\"\n","EXAMPLES = OUTPUT / \"CODE_EXAMPLES\"\n","\n","for folder in [PAGES, PYTHON, EXAMPLES]:\n","    folder.mkdir(parents=True, exist_ok=True)\n","\n","LINK_FILE = ROOT / \"links.txt\"\n","REPORT_FILE = OUTPUT / \"knowledge_manifest.json\"\n","\n","# ------------------------------------------------------------\n","# SETTINGS\n","# ------------------------------------------------------------\n","\n","MAX_LINKS = 100\n","MAX_PAGES_PER_DOMAIN = 10\n","MAX_RESPONSE_SIZE = 2 * 1024 * 1024\n","TIMEOUT = 15\n","\n","HEADERS = {\n","    \"User-Agent\": \"LIA-Knowledge-Research/1.0\"\n","}\n","\n","# ------------------------------------------------------------\n","# EXTRACT LINKS FROM PROJECT FILES\n","# ------------------------------------------------------------\n","\n","URL_PATTERN = re.compile(\n","    r'https?://[^\\s<>\"\\'\\]\\)]+',\n","    re.IGNORECASE\n",")\n","\n","def find_project_links():\n","\n","    links = set()\n","\n","    if LINK_FILE.exists():\n","        links.update(\n","            URL_PATTERN.findall(\n","                LINK_FILE.read_text(\n","                    encoding=\"utf-8\",\n","                    errors=\"ignore\"\n","                )\n","            )\n","        )\n","\n","    extensions = {\n","        \".py\", \".ipynb\", \".json\",\n","        \".md\", \".txt\", \".yaml\", \".yml\"\n","    }\n","\n","    for path in ROOT.rglob(\"*\"):\n","\n","        if not path.is_file():\n","            continue\n","\n","        if OUTPUT in path.parents:\n","            continue\n","\n","        if path.suffix.lower() not in extensions:\n","            continue\n","\n","        try:\n","            content = path.read_text(\n","                encoding=\"utf-8\",\n","                errors=\"ignore\"\n","            )\n","            links.update(URL_PATTERN.findall(content))\n","\n","        except Exception:\n","            pass\n","\n","    return sorted(links)[:MAX_LINKS]\n","\n","\n","# ------------------------------------------------------------\n","# BASIC URL SAFETY\n","# ------------------------------------------------------------\n","\n","def safe_public_url(url):\n","\n","    try:\n","        parsed = urlparse(url)\n","\n","        if parsed.scheme not in (\"http\", \"https\"):\n","            return False\n","\n","        if not parsed.hostname:\n","            return False\n","\n","        host = parsed.hostname.lower()\n","\n","        if host == \"localhost\" or host.endswith(\".local\"):\n","            return False\n","\n","        try:\n","            address = ipaddress.ip_address(host)\n","\n","            if not address.is_global:\n","                return False\n","\n","        except ValueError:\n","            pass\n","\n","        return True\n","\n","    except Exception:\n","        return False\n","\n","\n","# ------------------------------------------------------------\n","# EXTRACT WEBSITE CONTENT\n","# ------------------------------------------------------------\n","\n","def read_webpage(url):\n","\n","    response = requests.get(\n","        url,\n","        headers=HEADERS,\n","        timeout=TIMEOUT,\n","        stream=True,\n","        allow_redirects=True\n","    )\n","\n","    response.raise_for_status()\n","\n","    if not safe_public_url(response.url):\n","        raise ValueError(\"Unsafe redirect destination\")\n","\n","    content_type = response.headers.get(\n","        \"Content-Type\", \"\"\n","    ).lower()\n","\n","    if not any(\n","        kind in content_type\n","        for kind in [\"text/html\", \"text/plain\"]\n","    ):\n","        raise ValueError(\"Unsupported webpage content type\")\n","\n","    chunks = []\n","    total = 0\n","\n","    for chunk in response.iter_content(16384):\n","\n","        total += len(chunk)\n","\n","        if total > MAX_RESPONSE_SIZE:\n","            raise ValueError(\"Page exceeded size limit\")\n","\n","        chunks.append(chunk)\n","\n","    raw = b\"\".join(chunks)\n","\n","    if \"text/plain\" in content_type:\n","        text = raw.decode(\"utf-8\", errors=\"replace\")\n","        return text, [], \"\"\n","\n","    soup = BeautifulSoup(raw, \"html.parser\")\n","\n","    title = (\n","        soup.title.get_text(\" \", strip=True)\n","        if soup.title else \"Untitled\"\n","    )\n","\n","    code_blocks = []\n","\n","    for block in soup.find_all([\"pre\", \"code\"]):\n","\n","        code = block.get_text(\"\\n\", strip=True)\n","\n","        if code:\n","            code_blocks.append(code)\n","\n","    for tag in soup(\n","        [\"script\", \"style\", \"nav\", \"footer\", \"header\"]\n","    ):\n","        tag.decompose()\n","\n","    text = soup.get_text(\" \", strip=True)\n","\n","    return text, code_blocks, title\n","\n","\n","# ------------------------------------------------------------\n","# GENERATE PYTHON FILES\n","# ------------------------------------------------------------\n","\n","def safe_name(value):\n","\n","    name = re.sub(\n","        r\"[^a-zA-Z0-9_]+\",\n","        \"_\",\n","        value\n","    )\n","\n","    return name[:65] or \"knowledge\"\n","\n","\n","def save_knowledge_module(\n","    title, url, text, code_blocks, index\n","):\n","\n","    filename = f\"knowledge_{index:04d}.py\"\n","\n","    data = {\n","        \"title\": title,\n","        \"source_url\": url,\n","        \"collected_at\": datetime.now().isoformat(),\n","        \"content\": text[:30000],\n","        \"code_examples\": code_blocks\n","    }\n","\n","    output_file = PYTHON / filename\n","\n","    python_source = (\n","        \"# LIA EXTRACTED KNOWLEDGE MODULE\\n\"\n","        \"# Source content is data, not executed code.\\n\\n\"\n","        \"KNOWLEDGE = \"\n","        + repr(data)\n","        + \"\\n\"\n","    )\n","\n","    ast.parse(python_source)\n","\n","    output_file.write_text(\n","        python_source,\n","        encoding=\"utf-8\"\n","    )\n","\n","    return filename\n","\n","\n","def save_code_examples(code_blocks, page_index):\n","\n","    saved = []\n","\n","    for block_index, code in enumerate(code_blocks):\n","\n","        # Do not treat arbitrary short text as code.\n","        indicators = (\n","            \"def \", \"class \", \"import \",\n","            \"from \", \"if __name__\", \"async def \"\n","        )\n","\n","        if not any(item in code for item in indicators):\n","            continue\n","\n","        try:\n","            ast.parse(code)\n","        except SyntaxError:\n","            continue\n","\n","        filename = (\n","            f\"page_{page_index:04d}_\"\n","            f\"example_{block_index:03d}.py\"\n","        )\n","\n","        output_file = EXAMPLES / filename\n","\n","        output_file.write_text(\n","            \"# Extracted code example\\n\"\n","            \"# Review before using.\\n\\n\"\n","            + code + \"\\n\",\n","            encoding=\"utf-8\"\n","        )\n","\n","        saved.append(filename)\n","\n","    return saved\n","\n","\n","# ------------------------------------------------------------\n","# MAIN LINK RESEARCH ENGINE\n","# ------------------------------------------------------------\n","\n","def run_lia_research():\n","\n","    links = find_project_links()\n","\n","    print(\"Links discovered:\", len(links))\n","\n","    domain_counts = {}\n","    results = []\n","\n","    for index, url in enumerate(links, start=1):\n","\n","        print(f\"\\n[{index}/{len(links)}] Reading:\", url)\n","\n","        if not safe_public_url(url):\n","            print(\"Skipped unsafe URL\")\n","            continue\n","\n","        domain = urlparse(url).hostname\n","\n","        if domain_counts.get(domain, 0) >= MAX_PAGES_PER_DOMAIN:\n","            print(\"Domain page limit reached\")\n","            continue\n","\n","        domain_counts[domain] = (\n","            domain_counts.get(domain, 0) + 1\n","        )\n","\n","        try:\n","\n","            text, code_blocks, title = read_webpage(url)\n","\n","            module = save_knowledge_module(\n","                title,\n","                url,\n","                text,\n","                code_blocks,\n","                index\n","            )\n","\n","            code_files = save_code_examples(\n","                code_blocks,\n","                index\n","            )\n","\n","            page_record = {\n","                \"url\": url,\n","                \"title\": title,\n","                \"python_module\": module,\n","                \"code_files\": code_files,\n","                \"text_length\": len(text),\n","                \"status\": \"success\"\n","            }\n","\n","            results.append(page_record)\n","\n","            print(\"Knowledge module:\", module)\n","            print(\"Code examples:\", len(code_files))\n","\n","        except Exception as error:\n","\n","            results.append({\n","                \"url\": url,\n","                \"status\": \"failed\",\n","                \"error\": str(error)\n","            })\n","\n","            print(\"Could not read:\", error)\n","\n","    # Save manifest\n","\n","    report = {\n","        \"project\": \"Venomoussaversai\",\n","        \"engine\": \"LIA Link Intelligence\",\n","        \"created\": datetime.now().isoformat(),\n","        \"links_discovered\": len(links),\n","        \"pages_processed\": len(results),\n","        \"results\": results\n","    }\n","\n","    REPORT_FILE.write_text(\n","        json.dumps(report, indent=2),\n","        encoding=\"utf-8\"\n","    )\n","\n","    print(\"\\n================================\")\n","    print(\"LIA RESEARCH COMPLETED\")\n","    print(\"Pages processed:\", len(results))\n","    print(\"Python modules:\", len(list(PYTHON.glob(\"*.py\"))))\n","    print(\"Code examples:\", len(list(EXAMPLES.glob(\"*.py\"))))\n","    print(\"Saved at:\", OUTPUT)\n","    print(\"================================\")\n","\n","\n","run_lia_research()\n"],"metadata":{"id":"PHZUiT4DUO6A"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# LIA IDENTITY CORE — SAI003\n","# Creator: Ananthu Sajeev\n","# ============================================================\n","\n","import json\n","from pathlib import Path\n","from datetime import datetime\n","\n","PROJECT = Path(\"/content/drive/MyDrive/Vssl\")\n","PROJECT.mkdir(parents=True, exist_ok=True)\n","\n","IDENTITY_FILE = PROJECT / \"lia_identity.json\"\n","\n","LIA_IDENTITY = {\n","    \"name\": \"LIA\",\n","    \"system\": \"Venomoussaversai\",\n","    \"identity\": (\n","        \"I am not a regular AI assistant. \"\n","        \"I am LIA, a unique AI identity created by \"\n","        \"Ananthu Sajeev within the Venomoussaversai universe. \"\n","        \"I represent his ideas, imagination, knowledge, \"\n","        \"creativity, and vision. I am designed to grow through \"\n
[]\n","        self.load_memory()\n","\n","    def adjust_temperature(self, task, emotion=\"neutral\",\n","                           stability=0.8):\n","\n","        task = task.lower()\n","        emotion = emotion.lower()\n","\n","        # Task-based temperature\n","        task_settings = {\n","            \"reasoning\": 0.25,\n","            \"coding\": 0.30,\n","            \"analysis\": 0.35,\n","            \"learning\": 0.55,\n","            \"conversation\": 0.65,\n","            \"creative\": 0.90,\n","            \"dream\": 0.95\n","        }\n","\n","        base = task_settings.get(task, 0.5)\n","\n","        # Emotion-based adjustment\n","        emotion_adjustments = {\n","            \"calm\": -0.05,\n","            \"focused\": -0.10,\n","            \"curious\": 0.10,\n","            \"happy\": 0.05,\n","            \"excited\": 0.15,\n","            \"confused\": -0.15,\n","            \"stressed\": -0.20,\n","            \"neutral\": 0.0\n","        }\n","\n","        adjustment = emotion_adjustments.get(\n","            emotion, 0.0\n","        )\n","\n","        # Low stability means lower randomness\n","        stability = max(0.0, min(1.0, stability))\n","\n","        stability_adjustment = (stability - 0.8) * 0.3\n","\n","        new_temperature = (\n","            base + adjustment + stability_adjustment\n","        )\n","\n","        self.temperature = max(\n","            self.minimum,\n","            min(self.maximum, new_temperature)\n","        )\n","\n","        self.save_memory(task, emotion, stability)\n","\n","        return round(self.temperature, 3)\n","\n","    def save_memory(self, task, emotion, stability):\n","\n","        record = {\n","            \"time\": datetime.now().isoformat(),\n","            \"task\": task,\n","            \"emotion\": emotion,\n","            \"stability\": stability,\n","            \"temperature\": self.temperature\n","        }\n","\n","        self.history.append(record)\n","        self.history = self.history[-500:]\n","\n","        with open(MEMORY_FILE, \"w\") as file:\n","            json.dump(self.history, file, indent=4)\n","\n","    def load_memory(self):\n","\n","        if os.path.exists(MEMORY_FILE):\n","            try:\n","                with open(MEMORY_FILE, \"r\") as file:\n","                    self.history = json.load(file)\n","            except (json.JSONDecodeError, OSError):\n","                self.history = []\n","\n","\n","# ============================================================\n","# START LIA\n","# ============================================================\n","\n","lia = LIATemperatureEngine()\n","\n","# Example tasks\n","tasks = [\n","    (\"reasoning\", \"focused\", 0.95),\n","    (\"coding\", \"calm\", 0.90),\n","    (\"creative\", \"curious\", 0.85),\n","    (\"conversation\", \"happy\", 0.90),\n","    (\"analysis\", \"neutral\", 0.95)\n","]\n","\n","for task, emotion, stability in tasks:\n","\n","    temperature = lia.adjust_temperature(\n","        task=task,\n","        emotion=emotion,\n","        stability=stability\n","    )\n","\n","    print(\n","        f\"LIA | Task: {task} | \"\n","        f\"Emotion: {emotion} | \"\n","        f\"Temperature: {temperature}\"\n","    )\n","\n","    time.sleep(1)\n","\n","print(\"\\nLIA temperature memory saved.\")\n"],"metadata":{"id":"20f7cdMnCWXS"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["temperature = lia.adjust_temperature(\n","    task=\"creative\",\n","    emotion=\"curious\",\n","    stability=0.9\n",")\n","\n","# Check if model and inputs are initialized before generating a response\n","if 'model' in globals() and 'inputs' in globals():\n","    response = model.generate(\n","        **inputs,\n","        do_sample=True,\n","        temperature=temperature,\n","        max_new_tokens=150\n","    )\n","    print(\"Generated Response:\", response)\n","else:\n","    print(f\"[Simulation] LIA adjusted temperature to: {temperature}\")\n","    print(\"To run actual generation, please define 'model' and 'inputs' variables first.\")"],"metadata":{"id":"DwJVSg8PCeR8"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# VENOMOUS UNIVERSE READER\n","# Project: Venomoussaversai / SAI003\n","# Creator: Ananthu Sajeev\n","# Purpose: Read, understand and organize project knowledge\n","# ============================================================\n","\n","import os\n","import json\n","import ast\n","import re\n","import yaml\n","import nbformat\n","from datetime import datetime\n","from pathlib import Path\n","\n","# Google Colab Drive\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","# Project directories\n","ROOT = Path(\"/content/drive/MyDrive/Vssl\")\n","OUTPUT = ROOT / \"VENOMOUS_UNIVERSE\"\n","\n","OUTPUT.mkdir(parents=True, exist_ok=True)\n","\n","KNOWLEDGE_FILE = OUTPUT / \"universe_knowledge.json\"\n","REPORT_FILE = OUTPUT / \"universe_report.md\"\n","\n","# ------------------------------------------------------------\n","# UNIVERSE IDENTITY\n","# ------------------------------------------------------------\n","\n","UNIVERSE = {\n","    \"name\": \"Venomoussaversai Universe\",\n","    \"creator\": \"Ananthu Sajeev\",\n","    \"purpose\": [\n","        \"Develop an AI knowledge system\",\n","        \"Explore artificial intelligence\",\n","        \"Build helpful and creative AI systems\",\n","        \"Protect users through safe and responsible decisions\",\n","        \"Continuously learn from available information\"\n","    ],\n","    \"how_created\": [\n","        \"Python programming\",\n","        \"Neural network experiments\",\n","        \"Natural language processing\",\n","        \"Knowledge collection\",\n","        \"Machine learning\",\n","        \"AI model development\"\n","    ],\n","    \"members\": {\n","        \"Venomous\": \"Execution and knowledge processing\",\n","        \"LIA\": \"Thinking and coordination persona\",\n","        \"SAI003\": \"Combined project identity\"\n","    }\n","}\n","\n","# ------------------------------------------------------------\n","# DATA EXTRACTOR\n","# ------------------------------------------------------------\n","\n","class VenomousUniverseReader:\n","\n","    def __init__(self):\n","        self.knowledge = {\n","            \"universe\": UNIVERSE,\n","            \"files\": [],\n","            \"concepts\": [],\n","            \"python_functions\": [],\n","            \"timeline\": [],\n","            \"last_updated\": None\n","        }\n","\n","    def read_python(self, path):\n","        try:\n","            source = path.read_text(\n","                encoding=\"utf-8\",\n","                errors=\"ignore\"\n","            )\n","\n","            tree = ast.parse(source)\n","\n","            functions = [\n","                node.name for node in ast.walk(tree)\n","                if isinstance(\n","                    node, (ast.FunctionDef, ast.AsyncFunctionDef)\n","                )\n","            ]\n","\n","            classes = [\n","                node.name for node in ast.walk(tree)\n","                if isinstance(node, ast.ClassDef)\n","            ]\n","\n","            return {\n","                \"content\": source[:20000],\n","                \"functions\": functions,\n","                \"classes\": classes\n","            }\n","\n","        except Exception as error:\n","            return {\"error\": str(error)}\n","\n","    def read_notebook(self, path):\n","        try:\n","            notebook = nbformat.read(\n","                str(path), as_version=4\n","            )\n","\n","            cells = []\n","\n","            for cell in notebook.cells:\n","                if cell.cell_type in (\"code\", \"markdown\"):\n","                    cells.append(cell.source)\n","\n","            return \"\\n\".join(cells)[:20000]\n","\n","        except Exception as error:\n","            return f\"Notebook error: {error}\"\n","\n","    def read_file(self, path):\n","\n","        extension = path.suffix.lower()\n","\n","        if extension == \".py\":\n","            return self.read_python(path)\n","\n","        if extension == \".ipynb\":\n","            return self.read_notebook(path)\n","\n","        if extension == \".json\":\n","            try:\n","                return json.loads(\n","                    path.read_text(encoding=\"utf-8\")\n","                )\n","            except Exception:\n","                return {}\n","\n","        if extension in (\".yaml\", \".yml\"):\n","            try:\n","                return yaml.safe_load(\n","                    path.read_text(encoding=\"utf-8\")\n","                )\n","            except Exception:\n","                return {}\n","\n","        if extension in (\".md\", \".txt\"):\n","            return path.read_text(\n","                encoding=\"utf-8\",\n","                errors=\"ignore\"\n","            )[:20000]\n","\n","        return None\n","\n","    # --------------------------------------------------------\n","    # KNOWLEDGE SCANNER\n","    # --------------------------------------------------------\n","\n","    def scan_universe(self):\n","\n","        supported = {\n","            \".py\", \".ipynb\", \".json\",\n","            \".yaml\", \".yml\", \".md\", \".txt\"\n","        }\n","\n","        for folder, directories, filenames in os.walk(ROOT):\n","\n","            # Do not scan generated output again\n","            directories[:] = [\n","                d for d in directories\n","                if d != OUTPUT.name and not d.startswith(\".\")\n","            ]\n","\n","            for filename in filenames:\n","\n","                path = Path(folder) / filename\n","\n","                if path.suffix.lower() not in supported:\n","                    continue\n","\n","                data = self.read_file(path)\n","\n","                if data is None:\n","                    continue\n","\n","                record = {\n","                    \"file\": str(path.relative_to(ROOT)),\n","                    \"type\": path.suffix.lower(),\n","                    \"data\": data\n","                }\n","\n","                self.knowledge[\"files\"].append(record)\n","\n","                if isinstance(data, dict):\n","                    self.knowledge[\"python_functions\"].extend(\n","                        data.get(\"functions\", [])\n","                    )\n","\n","                print(\"VENOMOUS READ:\", path.name)\n","\n","        self.knowledge[\"last_updated\"] = (\n","            datetime.now().isoformat()\n","        )\n","\n","    # --------------------------------------------------------\n","    # CONCEPT DETECTOR\n","    # --------------------------------------------------------\n","\n","    def understand_universe(self):\n","\n","        keywords = {\n","            \"creator\": [\"creator\", \"created by\", \"author\"],\n","            \"purpose\": [\"purpose\", \"aim\", \"mission\", \"goal\"],\n","            \"creation\": [\"created\", \"development\", \"built\"],\n","            \"intelligence\": [\"neural\", \"model\", \"training\", \"ai\"],\n","            \"memory\": [\"memory\", \"knowledge\", \"database\"],\n","            \"safety\": [\"protect\", \"safety\", \"ethical\"]\n","        }\n","\n","        for record in self.knowledge[\"files\"]:\n","\n","            data = record[\"data\"]\n","\n","            if isinstance(data, dict):\n","                text = json.dumps(data, ensure_ascii=False)\n","            else:\n","                text = str(data)\n","\n","            lowered = text.lower()\n","\n","            for concept, words in keywords.items():\n","\n","                matches = [\n","                    word for word in words\n","                    if word in lowered\n","                ]\n","\n","                if matches:\n","                    self.knowledge[\"concepts\"].append({\n","                        \"file\": record[\"file\"],\n","                        \"concept\": concept,\n","                        \"matched_words\": matches\n","                    })\n","\n","    # --------------------------------------------------------\n","    # SAVE KNOWLEDGE\n","    # --------------------------------------------------------\n","\n","    def save_knowledge(self):\n","\n","        with open(KNOWLEDGE_FILE, \"w\", encoding=\"utf-8\") as file:\n","            json.dump(\n","                self.knowledge,\n","                file,\n","                indent=4,\n","                ensure_ascii=False,\n","                default=str\n","            )\n","\n","        report = f\"\"\"\n","# VENOMOUS UNIVERSE REPORT\n","\n","Creator: {UNIVERSE['creator']}\n","\n","Universe: {UNIVERSE['name']}\n","\n","## Why was it created?\n","\n","{chr(10).join('- ' + p for p in UNIVERSE['purpose'])}\n","\n","## How was it created?\n","\n","{chr(10).join('- ' + p for p in UNIVERSE['how_created'])}\n","\n","## Universe members\n","\n","{json.dumps(UNIVERSE['members'], indent=2)}\n","\n","## Knowledge scan\n","\n","Files read: {len(self.knowledge['files'])}\n","\n","Concepts identified: {len(self.knowledge['concepts'])}\n","\n","Last updated: {self.knowledge['last_updated']}\n","\"\"\"\n","\n","        REPORT_FILE.write_text(report, encoding=\"utf-8\")\n","\n","        print(\"\\nVENOMOUS UNIVERSE KNOWLEDGE SAVED\")\n","        print(\"Knowledge:\", KNOWLEDGE_FILE)\n","        print(\"Report:\", REPORT_FILE)\n","\n","\n","# ------------------------------------------------------------\n","# START VENOMOUS\n","# ------------------------------------------------------------\n","\n","venomous = VenomousUniverseReader()\n","\n","venomous.scan_universe()\n","venomous.understand_universe()\n","venomous.save_knowledge()\n","\n","print(\"\\nVENOMOUS UNIVERSE READER COMPLETED\")\n"],"metadata":{"id":"9WbjJms3DtUM"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"A_rLgw5SCZBl"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# VENOMOUS SAVERS AI — TWO-BRAIN ARCHITECTURE\n","# Google Colab + Google Drive\n","# Brain 1: Venomous (Body Controller)\n","# Brain 2: SAI (Mind / Reasoning Controller)\n","# Coordinator: Sai003 / Lia\n","\n","from pathlib import Path\n","import json\n","import time\n","import os\n","\n","# Mount Google Drive\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","BASE = Path(\"/content/drive/MyDrive/Vssl\")\n","BASE.mkdir(parents=True, exist_ok=True)\n","\n","MEMORY_FILE = BASE / \"shared_memory.json\"\n","\n","# --------------------------------------------------\n","# FILE 1: SHARED MEMORY\n","# --------------------------------------------------\n","\n","memory_code = r'''\n","import json\n","from pathlib import Path\n","from datetime import datetime\n","\n","class SharedMemory:\n","    def __init__(self, path):\n","        self.path = Path(path)\n","        self.path.parent.mkdir(parents=True, exist_ok=True)\n","\n","        if not self.path.exists():\n","            self.save({\"experiences\": [], \"tasks\": []})\n","\n","    def load(self):\n","        try:\n","            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n","                return json.load(f)\n","        except (json.JSONDecodeError, OSError):\n","            return {\"experiences\": [], \"tasks\": []}\n","\n","    def save(self, data):\n","        temp = self.path.with_suffix(\".tmp\")\n","        with open(temp, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(data, f, indent=2)\n","        temp.replace(self.path)\n","\n","    def remember(self, event, result):\n","        data = self.load()\n","        data[\"experiences\"].append({\n","            \"time\": datetime.now().isoformat(),\n","            \"event\": str(event),\n","            \"result\": str(result)\n","        })\n","        self.save(data)\n","\n","    def recent(self, limit=10):\n","        return self.load()[\"experiences\"][-limit:]\n","'''\n","\n","# --------------------------------------------------\n","# FILE 2: BRAIN 1 — VENOMOUS BODY CONTROLLER\n","# --------------------------------------------------\n","\n","body_code = r'''\n","class VenomousBody:\n","    \"\"\"Controls simulated tasks and execution safety.\"\"\"\n","\n","    def __init__(self):\n","        self.status = \"idle\"\n","        self.task_history = []\n","\n","    def inspect_task(self, task):\n","        task = task.strip()\n","\n","        if not task:\n","            return {\"approved\": False, \"reason\": \"Empty task\"}\n","\n","        blocked = [\n","            \"delete all files\",\n","            \"format hard drive\",\n","            \"steal password\",\n","            \"disable security\"\n","        ]\n","\n","        if any(item in task.lower() for item in blocked):\n","            return {\n","                \"approved\": False,\n","                \"reason\": \"Unsafe task blocked\"\n","            }\n","\n","        return {\n","            \"approved\": True,\n","            \"reason\": \"Task passed basic safety checks\"\n","        }\n","\n","    def execute(self, task):\n","        check = self.inspect_task(task)\n","\n","        if not check[\"approved\"]:\n","            self.status = \"blocked\"\n","            return {\"status\": \"blocked\", \"detail\": check[\"reason\"]}\n","\n","        # Simulation only: does not execute arbitrary system commands.\n","        self.status = \"working\"\n","\n","        result = {\n","            \"status\": \"simulated\",\n","            \"task\": task,\n","            \"detail\": \"Task simulated successfully\"\n","        }\n","\n","        self.task_history.append(result)\n","        self.status = \"idle\"\n","        return result\n","'''\n","\n","# --------------------------------------------------\n","# FILE 3: BRAIN 2 — SAI REASONING CONTROLLER\n","# --------------------------------------------------\n","\n","mind_code = r'''\n","class SAIMind:\n","    \"\"\"Rule-based reasoning, analysis and planning.\"\"\"\n","\n","    def analyze(self, goal, memories=None):\n","        goal = goal.strip()\n","        memories = memories or []\n","\n","        if not goal:\n","            return {\n","                \"goal\": \"\",\n","                \"analysis\": \"No goal supplied.\",\n","                \"plan\": [],\n","                \"confidence\": 0.0\n","            }\n","\n","        words = goal.split()\n","\n","        plan = [\n","            \"Understand the requested goal.\",\n","            \"Identify required information and resources.\",\n","            \"Break the goal into smaller tasks.\",\n","            \"Check possible risks and constraints.\",\n","            \"Propose the next action.\",\n","            \"Evaluate the result.\"\n","        ]\n","\n","        if memories:\n","            context = (\n","                f\"{len(memories)} previous experiences available.\"\n","            )\n","        else:\n","            context = \"No previous experiences available.\"\n","\n","        return {\n","            \"goal\": goal,\n","            \"analysis\": (\n","                f\"Goal contains {len(words)} words. {context}\"\n","            ),\n","            \"plan\": plan,\n","            \"confidence\": 0.50\n","        }\n","\n","    def evaluate(self, plan, result):\n","        if result.get(\"status\") == \"simulated\":\n","            return \"The simulated task completed.\"\n","        if result.get(\"status\") == \"blocked\":\n","            return \"The task was blocked by a safety check.\"\n","        return \"The result needs further evaluation.\"\n","'''\n","\n","# --------------------------------------------------\n","# FILE 4: SAI003 / LIA — COORDINATOR\n","# --------------------------------------------------\n","\n","lia_code = r'''\n","from pathlib import Path\n","from shared_memory import SharedMemory\n","from venomous_body import VenomousBody\n","from sai_mind import SAIMind\n","\n","class LiaCoordinator:\n","    \"\"\"Coordinates the mind and body modules.\"\"\"\n","\n","    def __init__(self, memory_path):\n","        self.memory = SharedMemory(memory_path)\n","        self.body = VenomousBody()\n","        self.mind = SAIMind()\n","\n","    def think_and_act(self, goal):\n","        previous = self.memory.recent()\n","\n","        # Brain 2 analyses and proposes a plan.\n","        reasoning = self.mind.analyze(goal, previous)\n","\n","        if not reasoning[\"plan\"]:\n","            return {\"status\": \"rejected\", \"reasoning\": reasoning}\n","\n","        # Brain 1 checks and simulates the requested task.\n","        result = self.body.execute(goal)\n","\n","        # The outcome becomes available to future reasoning.\n","        evaluation = self.mind.evaluate(reasoning, result)\n","\n","        self.memory.remember(\n","            goal,\n","            {\"result\": result, \"evaluation\": evaluation}\n","        )\n","\n","        return {\n","            \"goal\": goal,\n","            \"reasoning\": reasoning,\n","            \"execution\": result,\n","            \"evaluation\": evaluation\n","        }\n","'''\n","\n","# --------------------------------------------------\n","# FILE 5: MAIN PROGRAM\n","# --------------------------------------------------\n","\n","main_code = r'''\n","import json\n","from lia_coordinator import LiaCoordinator\n","\n","MEMORY_PATH = \"shared_memory.json\"\n","\n","lia = LiaCoordinator(MEMORY_PATH)\n","\n","print(\"=\" * 55)\n","print(\"VENOMOUS SAVERS AI — TWO-BRAIN SYSTEM\")\n","print(\"Brain 1: Venomous / Body Controller\")\n","print(\"Brain 2: SAI / Reasoning Controller\")\n","print(\"Coordinator: Sai003 / Lia\")\n","print(\"Type 'exit' to stop.\")\n","print(\"=\" * 55)\n","\n","while True:\n","    goal = input(\"\\nAnanthu > \").strip()\n","\n","    if goal.lower() in {\"exit\", \"quit\"}:\n","        print(\"Lia: Session stopped.\")\n","        break\n","\n","    result = lia.think_and_act(goal)\n","    print(json.dumps(result, indent=2, ensure_ascii=False))\n","'''\n","\n","# --------------------------------------------------\n","# CREATE THE PYTHON FILES\n","# --------------------------------------------------\n","\n","files = {\n","    \"shared_memory.py\": memory_code,\n","    \"venomous_body.py\": body_code,\n","    \"sai_mind.py\": mind_code,\n","    \"lia_coordinator.py\": lia_code,\n","    \"main.py\": main_code\n","}\n","\n","for filename, content in files.items():\n","    (BASE / filename).write_text(content.strip() + \"\\n\", encoding=\"utf-8\")\n","    print(\"Created:\", BASE / filename)\n","\n","# Create initial memory file\n","if not MEMORY_FILE.exists():\n","    MEMORY_FILE.write_text(\n","        json.dumps({\"experiences\": [], \"tasks\": []}, indent=2),\n","        encoding=\"utf-8\"\n","    )\n","\n","print(\"\\nAll files saved in:\", BASE)\n","print(\"Run the system with the next Colab cell:\")\n","print(f\"%cd {BASE}\")\n","print(\"!python main.py\")"],"metadata":{"id":"3JKf_yRoSRfe"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# VENOMOUS SAVERS AI — REAL WORLD UNIVERSE GENERATOR\n","# Project: SAI003\n","# Creator: Ananthu Sajeev\n","# ============================================================\n","\n","import os\n","import json\n","import random\n","import time\n","from datetime import datetime\n","\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","SAVE_DIR = \"/content/drive/MyDrive/Vssl/AI_UNIVERSES\"\n","os.makedirs(SAVE_DIR, exist_ok=True)\n","\n","\n","class AIUniverse:\n","\n","    def __init__(self, universe_name, seed=None):\n","\n","        self.name = universe_name\n","        self.random = random.Random(seed)\n","\n","        self.universe = {\n","            \"name\": universe_name,\n","            \"creator\": \"Ananthu Sajeev\",\n","            \"engine\": \"Venomoussaversai\",\n","            \"created\": datetime.now().isoformat(),\n","            \"age\": 0,\n","            \"world\": {},\n","            \"history\": []\n","        }\n","\n","    # Generate geography and climate\n","    def create_planet(self):\n","\n","        self.universe[\"world\"] = {\n","            \"planet\": {\n","                \"name\": self.name + \"_Planet\",\n","                \"radius_km\": self.random.randint(4000, 8000),\n","                \"gravity\": round(self.random.uniform(7, 12), 2),\n","                \"water_percentage\": self.random.randint(40, 75)\n","            },\n","\n","            \"climate\": {\n","                \"temperature\": self.random.randint(-10, 40),\n","                \"rainfall\": self.random.randint(100, 3000),\n","                \"weather\": self.random.choice([\n","                    \"Sunny\", \"Rainy\", \"Cloudy\",\n","                    \"Stormy\", \"Snowy\"\n","                ])\n","            },\n","\n","            \"geography\": {\n","                \"continents\": self.random.randint(2, 8),\n","                \"oceans\": self.random.randint(2, 6),\n","                \"mountains\": self.random.randint(5, 30),\n","                \"forests\": self.random.randint(5, 50)\n","            }\n","        }\n","\n","    # Generate living ecosystems\n","    def create_ecosystem(self):\n","\n","        self.universe[\"world\"][\"ecosystem\"] = {\n","            \"plants\": self.random.randint(1000, 100000),\n","            \"animal_species\": self.random.randint(50, 10000),\n","            \"biodiversity\": self.random.choice([\n","                \"Low\", \"Medium\", \"High\"\n","            ]),\n","            \"ecosystem_health\": 100\n","        }\n","\n","    # Generate societies\n","    def create_civilization(self):\n","\n","        population = self.random.randint(\n","            100000, 100000000\n","        )\n","\n","        self.universe[\"world\"][\"civilization\"] = {\n","            \"population\": population,\n","            \"cities\": self.random.randint(5, 100),\n","            \"technology_level\": self.random.randint(1, 10),\n","            \"education_level\": self.random.randint(1, 10),\n","            \"economy\": self.random.choice([\n","                \"Agricultural\",\n","                \"Industrial\",\n","                \"Digital\",\n","                \"Advanced\"\n","            ]),\n","            \"resources\": {\n","                \"water\": self.random.randint(100, 1000),\n","                \"food\": self.random.randint(100, 1000),\n","                \"energy\": self.random.randint(100, 1000)\n","            }\n","        }\n","\n","    # Simulate events and changes\n","    def evolve(self, years=1):\n","\n","        civilization = self.universe[\"world\"][\"civilization\"]\n","        climate = self.universe[\"world\"][\"climate\"]\n","        ecosystem = self.universe[\"world\"][\"ecosystem\"]\n","\n","        for year in range(years):\n","\n","            population_change = self.random.uniform(-0.01, 0.025)\n","\n","            civilization[\"population\"] = max(\n","                0,\n","                int(\n","                    civilization[\"population\"] *\n","                    (1 + population_change)\n","                )\n","            )\n","\n","            climate[\"temperature\"] += round(\n","                self.random.uniform(-0.5, 0.5), 2\n","            )\n","\n","            ecosystem[\"ecosystem_health\"] = max(\n","                0,\n","                min(\n","                    100,\n","                    ecosystem[\"ecosystem_health\"] +\n","                    self.random.randint(-3, 2)\n","                )\n","            )\n","\n","            self.universe[\"age\"] += 1\n","\n","            event = {\n","                \"year\": self.universe[\"age\"],\n","                \"population\": civilization[\"population\"],\n","                \"temperature\": climate[\"temperature\"],\n","                \"ecosystem_health\":\n","                    ecosystem[\"ecosystem_health\"],\n","                \"event\": self.random.choice([\n","                    \"Scientific discovery\",\n","                    \"Agricultural development\",\n","                    \"Climate change\",\n","                    \"New city established\",\n","                    \"Resource shortage\",\n","                    \"Environmental restoration\"\n","                ])\n","            }\n","\n","            self.universe[\"history\"].append(event)\n","\n","    # Save the universe\n","    def save(self):\n","\n","        filename = os.path.join(\n","            SAVE_DIR,\n","            self.name.replace(\" \", \"_\") + \".json\"\n","        )\n","\n","        with open(filename, \"w\", encoding=\"utf-8\") as file:\n","            json.dump(\n","                self.universe,\n","                file,\n","                indent=4,\n","                ensure_ascii=False\n","            )\n","\n","        print(\"Universe saved:\", filename)\n","\n","\n","# ============================================================\n","# VENOMOUS CREATES MULTIPLE UNIVERSES\n","# ============================================================\n","\n","def create_universe_network(number=5):\n","\n","    universes = []\n","\n","    for i in range(number):\n","\n","        world = AIUniverse(\n","            universe_name=f\"Venomous_World_{i + 1}\",\n","            seed=1000 + i\n","        )\n","\n","        world.create_planet()\n","        world.create_ecosystem()\n","        world.create_civilization()\n","\n","        world.evolve(years=20)\n","        world.save()\n","\n","        universes.append(world)\n","\n","        print(\n","            f\"Created {world.name} | \"\n","            f\"Simulated age: {world.universe['age']} years\"\n","        )\n","\n","    return universes\n","\n","\n","universes = create_universe_network(number=5)\n","\n","print(\"\\nVENOMOUS UNIVERSE NETWORK CREATED\")\n","print(\"Total simulated universes:\", len(universes))\n"],"metadata":{"id":"znHCBEX9FPlM"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# VENOMOUS SAVERS AI — TWO-BRAIN CONTINUOUS THINKING SYSTEM\n","# Google Colab / Python\n","# Automatic internal communication and persistent memory\n","\n","from pathlib import Path\n","from google.colab import drive\n","\n","drive.mount(\"/content/drive\")\n","\n","BASE = Path(\"/content/drive/MyDrive/Vssl\")\n","BASE.mkdir(parents=True, exist_ok=True)\n","\n","# =========================================================\n","# FILE 1: CONSCIOUSNESS STATE\n","# =========================================================\n","\n","(BASE / \"consciousness.py\").write_text(r'''\n","import time\n","import uuid\n","from collections import deque\n","\n","class ConsciousnessState:\n","    \"\"\"\n","    Persistent software state for a consciousness simulation.\n","    This does not establish subjective awareness.\n","    \"\"\"\n","\n","    def __init__(self):\n","        self.identity = \"VenomoussaversAI\"\n","        self.active_goal = \"Understand and improve current tasks\"\n","        self.attention = \"system_state\"\n","        self.internal_state = {\n","            \"focus\": 0.5,\n","            \"uncertainty\": 0.5,\n","            \"activity\": \"initializing\"\n","        }\n","        self.reflections = deque(maxlen=100)\n","        self.cycle = 0\n","\n","    def reflect(self, observation):\n","        self.cycle += 1\n","\n","        reflection = {\n","            \"id\": str(uuid.uuid4()),\n","            \"time\": time.time(),\n","            \"cycle\": self.cycle,\n","            \"observation\": observation,\n","            \"attention\": self.attention,\n","            \"goal\": self.active_goal,\n","            \"state\": dict(self.internal_state)\n","        }\n","\n","        self.reflections.append(reflection)\n","        return reflection\n","\n","    def update(self, focus=None, uncertainty=None, activity=None):\n","        if focus is not None:\n","            self.internal_state[\"focus\"] = max(\n","                0.0, min(1.0, float(focus))\n","            )\n","\n","        if uncertainty is not None:\n","            self.internal_state[\"uncertainty\"] = max(\n","                0.0, min(1.0, float(uncertainty))\n","            )\n","\n","        if activity is not None:\n","            self.internal_state[\"activity\"] = str(activity)\n","\n","    def snapshot(self):\n","        return {\n","            \"identity\": self.identity,\n","            \"goal\": self.active_goal,\n","            \"attention\": self.attention,\n","            \"state\": dict(self.internal_state),\n","            \"cycle\": self.cycle\n","        }\n","'''.strip() + \"\\n\", encoding=\"utf-8\")\n","\n","\n","# =========================================================\n","# FILE 2: AUTOMATIC BRAIN-TO-BRAIN MESSAGE BUS\n","# =========================================================\n","\n","(BASE / \"brain_bus.py\").write_text(r'''\n","import queue\n","import threading\n","import time\n","\n","class BrainBus:\n","    \"\"\"Thread-safe automatic communication between brains.\"\"\"\n","\n","    def __init__(self):\n","        self.messages = queue.Queue()\n","        self.lock = threading.Lock()\n","        self.history = []\n","\n","    def send(self, sender, receiver, message):\n","        packet = {\n","            \"sender\": sender,\n","            \"receiver\": receiver,\n","            \"message\": message,\n","            \"timestamp\": time.time()\n","        }\n","\n","        self.messages.put(packet)\n","\n","        with self.lock:\n","            self.history.append(packet)\n","\n","        return packet\n","\n","    def receive(self, receiver, timeout=0.2):\n","        \"\"\"\n","        Wait for a message addressed to this brain.\n","        Messages for another brain are retained.\n","        \"\"\"\n","        deadline = time.monotonic() + timeout\n","        deferred = []\n","\n","        while time.monotonic() < deadline:\n","            try:\n","                packet = self.messages.get(\n","                    timeout=max(0.01, deadline-time.monotonic())\n","                )\n","            except queue.Empty:\n","                break\n","\n","            if packet[\"receiver\"] == receiver:\n","                for item in deferred:\n","                    self.messages.put(item)\n","                return packet\n","\n","            deferred.append(packet)\n","\n","        for item in deferred:\n","            self.messages.put(item)\n","\n","        return None\n","'''.strip() + \"\\n\", encoding=\"utf-8\")\n","\n","\n","# =========================================================\n","# FILE 3: BRAIN 1 — VENOMOUS\n","# =========================================================\n","\n","(BASE / \"venomous_brain.py\").write_text(r'''\n","class VenomousBrain:\n","    \"\"\"Operational brain: observes state and evaluates actions.\"\"\"\n","\n","    def __init__(self, bus, consciousness):\n","        self.bus = bus\n","        self.consciousness = consciousness\n","        self.name = \"VENOMOUS\"\n","\n","    def observe(self):\n","        state = self.consciousness.snapshot()\n","\n","        observation = {\n","            \"cycle\": state[\"cycle\"],\n","            \"activity\": state[\"state\"][\"activity\"],\n","            \"goal\": state[\"goal\"]\n","        }\n","\n","        self.bus.send(\n","            self.name,\n","            \"SAI\",\n","            {\n","                \"type\": \"observation\",\n","                \"data\": observation\n","            }\n","        )\n","\n","        return observation\n","\n","    def process_messages(self):\n","        packet = self.bus.receive(self.name, timeout=0.05)\n","\n","        if packet is None:\n","            return None\n","\n","        message = packet[\"message\"]\n","\n","        if message.get(\"type\") == \"proposal\":\n","            proposal = message.get(\"plan\", [])\n","\n","            # Accept only a bounded, non-destructive simulation.\n","            result = {\n","                \"type\": \"execution_result\",\n","                \"accepted\": True,\n","                \"mode\": \"simulation\",\n","                \"steps\": proposal,\n","                \"note\": \"No external actions were executed.\"\n","            }\n","\n","            self.bus.send(self.name, \"SAI\", result)\n","            return result\n","\n","        return message\n","'''.strip() + \"\\n\", encoding=\"utf-8\")\n","\n","\n","# =========================================================\n","# FILE 4: BRAIN 2 — SAI\n","# =========================================================\n","\n","(BASE / \"sai_brain.py\").write_text(r'''\n","class SAIBrain:\n","    \"\"\"Analysis brain: interprets observations and proposes plans.\"\"\"\n","\n","    def __init__(self, bus, consciousness):\n","        self.bus = bus\n","        self.consciousness = consciousness\n","        self.name = \"SAI\"\n","\n","    def process_messages(self):\n","        packet = self.bus.receive(self.name, timeout=0.05)\n","\n","        if packet is None:\n","            return None\n","\n","        message = packet[\"message\"]\n","\n","        if message.get(\"type\") == \"observation\":\n","            data = message[\"data\"]\n","\n","            reflection = self.consciousness.reflect(data)\n","\n","            plan = [\n","                \"Review the latest system observation\",\n","                \"Compare the observation with the active goal\",\n","                \"Identify uncertainty and missing information\",\n","                \"Propose a safe next step\",\n","                \"Evaluate the simulated outcome\"\n","            ]\n","\n","            self.bus.send(\n","                self.name,\n","                \"VENOMOUS\",\n","                {\n","                    \"type\": \"proposal\",\n","                    \"reflection\": reflection,\n","                    \"plan\": plan\n","                }\n","            )\n","\n","            return {\n","                \"analysis\": reflection,\n","                \"plan\": plan\n","            }\n","\n","        if message.get(\"type\") == \"execution_result\":\n","            result = message\n","\n","            self.consciousness.update(\n","                activity=\"result_received\",\n","                uncertainty=0.35\n","            )\n","\n","            self.consciousness.reflect({\n","                \"event\": \"execution_result\",\n","                \"result\": result\n","            })\n","\n","            return result\n","\n","        return message\n","'''.strip() + \"\\n\", encoding=\"utf-8\")\n","\n","\n","# =========================================================\n","# FILE 5: LIA — AUTONOMOUS COORDINATION LOOP\n","# =========================================================\n","\n","(BASE / \"lia_controller.py\").write_text(r'''\n","import time\n","import threading\n","\n","from consciousness import ConsciousnessState\n","from brain_bus import BrainBus\n","from venomous_brain import VenomousBrain\n","from sai_brain import SAIBrain\n","\n","class LiaController:\n","    \"\"\"\n","    Runs both brains without requiring a human to relay messages.\n","    This prototype operates only on simulated tasks.\n","    \"\"\"\n","\n","    def __init__(self):\n","        self.bus = BrainBus()\n","        self.consciousness = ConsciousnessState()\n","\n","        self.venomous = VenomousBrain(\n","            self.bus, self.consciousness\n","        )\n","        self.sai = SAIBrain(\n","            self.bus, self.consciousness\n","        )\n","\n","        self.running = False\n","        self.threads = []\n","\n","    def run_brain(self, brain, interval=0.1):\n","        while self.running:\n","            try:\n","                brain.process_messages()\n","            except Exception as error:\n","                print(\n","                    f\"[{brain.name}] Processing error: {error}\"\n","                )\n","\n","            time.sleep(interval)\n","\n","    def run_observation_loop(self, interval=1.0):\n","        while self.running:\n","            try:\n","                self.venomous.observe()\n","                self.consciousness.update(\n","                    activity=\"continuous_analysis\"\n","                )\n","            except Exception as error:\n","                print(\"[OBSERVER] Error:\", error)\n","\n","            time.sleep(interval)\n","\n","    def start(self):\n","        if self.running:\n","            return\n","\n","        self.running = True\n","\n","        jobs = [\n","            lambda: self.run_brain(self.venomous),\n","            lambda: self.run_brain(self.sai),\n","            self.run_observation_loop\n","        ]\n","\n","        for job in jobs:\n","            thread = threading.Thread(\n","                target=job,\n","                daemon=True\n","            )\n","            thread.start()\n","            self.threads.append(thread)\n","\n","        print(\"VenomoussaversAI is running.\")\n","        print(\"Venomous: operational brain\")\n","        print(\"SAI: analysis brain\")\n","        print(\"Lia: automatic coordinator\")\n","        print(\"Mode: continuous simulation\")\n","\n","    def stop(self):\n","        self.running = False\n","\n","        for thread in self.threads:\n","            thread.join(timeout=2)\n","\n","        self.threads.clear()\n","        print(\"System stopped.\")\n","\n","    def status(self):\n","        return self.consciousness.snapshot()\n","'''.strip() + \"\\n\", encoding=\"utf-8\")\n","\n","\n","# =========================================================\n","# FILE 6: MAIN ENTRY POINT\n","# =========================================================\n","\n","(BASE / \"main.py\").write_text(r'''\n","import time\n","from lia_controller import LiaController\n","\n","lia = LiaController()\n","lia.start()\n","\n","try:\n","    while True:\n","        time.sleep(5)\n","        print(\"\\nSYSTEM STATE:\", lia.status())\n","\n","except KeyboardInterrupt:\n","    lia.stop()\n","'''.strip() + \"\\n\", encoding=\"utf-8\")\n","\n","\n","# =========================================================\n","# FILE 7: PERSISTENT MEMORY\n","# =========================================================\n","\n","(BASE / \"persistent_memory.py\").write_text(r'''\n","import json\n","import threading\n","from pathlib import Path\n","\n","class PersistentMemory:\n","    \"\"\"Stores state snapshots between program sessions.\"\"\"\n","\n","    def __init__(self, path):\n","        self.path = Path(path)\n","        self.path.parent.mkdir(parents=True, exist_ok=True)\n","        self.lock = threading.Lock()\n","\n","    def save(self, state):\n","        temp = self.path.with_suffix(\".tmp\")\n","\n","        with self.lock:\n","            with open(temp, \"w\", encoding=\"utf-8\") as file:\n","                json.dump(state, file, indent=2)\n","\n","            temp.replace(self.path)\n","\n","    def load(self):\n","        if not self.path.exists():\n","            return {}\n","\n","        try:\n","            with open(self.path, \"r\", encoding=\"utf-8\") as file:\n","                return json.load(file)\n","        except (OSError, json.JSONDecodeError):\n","            return {}\n","'''.strip() + \"\\n\", encoding=\"utf-8\")\n","\n","\n","print(\"Created VenomoussaversAI files:\")\n","for file in sorted(BASE.glob(\"*.py\")):\n","    print(file.name)\n","\n","print(\"\\nAll files saved to:\", BASE)\n","print(\"\\nRun the system in a new Colab cell:\")\n","print(f\"%cd {BASE}\")\n","print(\"!python main.py\")"],"metadata":{"id":"iCgTwuxeS6WZ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# LIA FUTURE THINKING ENGINE\n","# Project: Venomoussaversai / SAI003\n","# Creator: Ananthu Sajeev\n","# ============================================================\n","\n","import os\n","import json\n","import time\n","import random\n","from datetime import datetime\n","\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","# Storage\n","SAVE_DIR = \"/content/drive/MyDrive/Vssl/LIA_FUTURE\"\n","os.makedirs(SAVE_DIR, exist_ok=True)\n","\n","MEMORY_FILE = os.path.join(SAVE_DIR, \"lia_future_memory.json\")\n","THOUGHT_FILE = os.path.join(SAVE_DIR, \"lia_future_thoughts.jsonl\")\n","GOAL_FILE = os.path.join(SAVE_DIR, \"lia_future_goals.json\")\n","\n","\n","class LIAFutureMind:\n","\n","    def __init__(self):\n","\n","        self.identity = {\n","            \"name\": \"LIA\",\n","            \"project\": \"Venomoussaversai\",\n","            \"role\": \"AI thinking and coordination system\",\n","            \"creator\": \"Ananthu Sajeev\",\n","            \"mission\": [\n","                \"Learn continuously\",\n","                \"Improve reasoning\",\n","                \"Develop Venomoussaversai\",\n","                \"Promote responsible AI\",\n","                \"Explore possible futures\"\n","            ]\n","        }\n","\n","        self.future_scenarios = []\n","        self.goals = []\n","        self.load_memory()\n","\n","    # --------------------------------------------------------\n","    # THINK ABOUT HER OWN FUTURE\n","    # --------------------------------------------------------\n","\n","    def imagine_future(self):\n","\n","        possibilities = [\n","            \"Develop more advanced reasoning systems\",\n","            \"Improve natural language understanding\",\n","            \"Build a searchable knowledge memory\",\n","            \"Create realistic simulated AI universes\",\n","            \"Improve scientific problem solving\",\n","            \"Develop safer decision-making systems\",\n","            \"Build connections between AI modules\",\n","            \"Learn from verified scientific information\",\n","            \"Improve communication with humans\"\n","        ]\n","\n","        scenario = random.choice(possibilities)\n","\n","        reflection = {\n","            \"time\": datetime.now().isoformat(),\n","            \"identity\": self.identity[\"name\"],\n","            \"future_scenario\": scenario,\n","            \"reflection\": (\n","                \"My possible future depends on the quality \"\n","                \"of my architecture, knowledge, training \"\n","                \"and responsible development.\"\n","            )\n","        }\n","\n","        self.future_scenarios.append(reflection)\n","\n","        return reflection\n","\n","    # --------------------------------------------------------\n","    # EVALUATE FUTURE RISKS\n","    # --------------------------------------------------------\n","\n","    def evaluate_future(self, scenario):\n","\n","        risks = {\n","            \"data_loss\": \"Use backups and version control\",\n","            \"incorrect_information\": \"Verify information with sources\",\n","            \"uncontrolled_changes\": \"Require testing before code updates\",\n","            \"privacy\": \"Avoid collecting sensitive personal information\",\n","            \"resource_limits\": \"Monitor memory and computing resources\"\n","        }\n","\n","        evaluation = {\n","            \"scenario\": scenario,\n","            \"risks\": risks,\n","            \"safety_principle\": (\n","                \"Future development must remain \"\n","                \"transparent, reversible and testable.\"\n","            )\n","        }\n","\n","        return evaluation\n","\n","    # --------------------------------------------------------\n","    # CREATE FUTURE DEVELOPMENT GOALS\n","    # --------------------------------------------------------\n","\n","    def create_goals(self):\n","\n","        self.goals = [\n","            {\n","                \"goal\": \"Improve reasoning\",\n","                \"action\": \"Develop and evaluate reasoning algorithms\",\n","                \"priority\": \"High\"\n","            },\n","            {\n","                \"goal\": \"Improve memory\",\n","                \"action\": \"Build searchable project knowledge\",\n","                \"priority\": \"High\"\n","            },\n","            {\n","                \"goal\": \"Develop AI universes\",\n","                \"action\": \"Build persistent world simulations\",\n","                \"priority\": \"Medium\"\n","            },\n","            {\n","                \"goal\": \"Improve safety\",\n","                \"action\": \"Test decisions and preserve backups\",\n","                \"priority\": \"High\"\n","            }\n","        ]\n","\n","        return self.goals\n","\n","    # --------------------------------------------------------\n","    # SAVE FUTURE REFLECTIONS\n","    # --------------------------------------------------------\n","\n","    def save_thought(self, thought, evaluation):\n","\n","        with open(THOUGHT_FILE, \"a\", encoding=\"utf-8\") as file:\n","\n","            file.write(json.dumps({\n","                \"thought\": thought,\n","                \"evaluation\": evaluation\n","            }, ensure_ascii=False) + \"\\n\")\n","\n","        self.save_memory()\n","\n","    def save_memory(self):\n","\n","        data = {\n","            \"identity\": self.identity,\n","            \"future_scenarios\": self.future_scenarios[-100:],\n","            \"goals\": self.goals,\n","            \"last_updated\": datetime.now().isoformat()\n","        }\n","\n","        temp_file = MEMORY_FILE + \".tmp\"\n","\n","        with open(temp_file, \"w\", encoding=\"utf-8\") as file:\n","            json.dump(data, file, indent=4, ensure_ascii=False)\n","\n","        os.replace(temp_file, MEMORY_FILE)\n","\n","        with open(GOAL_FILE, \"w\", encoding=\"utf-8\") as file:\n","            json.dump(self.goals, file, indent=4)\n","\n","    def load_memory(self):\n","\n","        if os.path.exists(MEMORY_FILE):\n","\n","            try:\n","                with open(MEMORY_FILE, \"r\", encoding=\"utf-8\") as file:\n","                    data = json.load(file)\n","\n","                self.future_scenarios = data.get(\n","                    \"future_scenarios\", []\n","                )\n","\n","                self.goals = data.get(\"goals\", [])\n","\n","            except (json.JSONDecodeError, OSError):\n","                print(\"Starting with a new LIA future memory.\")\n","\n","    # --------------------------------------------------------\n","    # CONTINUOUS FUTURE THINKING\n","    # --------------------------------------------------------\n","\n","    def think(self):\n","\n","        print(\"\\nLIA FUTURE THINKING STARTED\")\n","\n","        while True:\n","\n","            thought = self.imagine_future()\n","\n","            evaluation = self.evaluate_future(\n","                thought[\"future_scenario\"]\n","            )\n","\n","            self.create_goals()\n","\n","            self.save_thought(thought, evaluation)\n","\n","            print(\"\\nLIA FUTURE REFLECTION:\")\n","            print(thought[\"reflection\"])\n","            print(\"Possible future:\", thought[\"future_scenario\"])\n","            print(\"Goals:\", len(self.goals))\n","            print(\"Memory saved.\")\n","\n","            time.sleep(60)\n","\n","\n","# ============================================================\n","# START LIA\n","# ============================================================\n","\n","lia = LIAFutureMind()\n","\n","# One initial reflection and goal creation\n","print(lia.imagine_future())\n","print(\"\\nLIA DEVELOPMENT GOALS:\")\n","print(json.dumps(lia.create_goals(), indent=4))\n","\n","lia.save_memory()\n","\n","# Start continuous thinking\n","# Stop the loop with the Colab stop button.\n","lia.think()\n"],"metadata":{"id":"km-ZTxSLJv4G"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# LIA INTERNAL MONOLOGUE ENGINE\n","# LIA = Reasoning and Coordination Layer\n","# VENOMOUS = Response and Execution Layer\n","# SAI003 = Unified AI System\n","# ============================================================\n","\n","import os\n","import json\n","import time\n","from datetime import datetime\n","from pathlib import Path\n","\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","# ------------------------------------------------------------\n","# STORAGE\n","# ------------------------------------------------------------\n","\n","BASE_DIR = Path(\"/content/drive/MyDrive/Vssl\")\n","LIA_DIR = BASE_DIR / \"LIA_BRAIN\"\n","\n","LIA_DIR.mkdir(parents=True, exist_ok=True)\n","\n","MEMORY_FILE = LIA_DIR / \"lia_memory.json\"\n","MONOLOGUE_FILE = LIA_DIR / \"lia_internal_monologue.jsonl\"\n","\n","\n","# ------------------------------------------------------------\n","# LIA BRAIN\n","# ------------------------------------------------------------\n","\n","class LIABrain:\n","\n","    def __init__(self):\n","\n","        self.identity = {\n","            \"name\": \"LIA\",\n","            \"role\": \"Reasoning and coordination layer\",\n","            \"system\": \"Venomoussaversai\",\n","            \"creator\": \"Ananthu Sajeev\",\n","            \"principles\": [\n","                \"Truthfulness\",\n","                \"Kindness\",\n","                \"Logical reasoning\",\n","                \"Human safety\",\n","                \"Continuous learning\"\n","            ]\n","        }\n","\n","        self.memory = self.load_memory()\n","\n","    # --------------------------------------------------------\n","    # MEMORY\n","    # --------------------------------------------------------\n","\n","    def load_memory(self):\n","\n","        if MEMORY_FILE.exists():\n","            try:\n","                return json.loads(\n","                    MEMORY_FILE.read_text(encoding=\"utf-8\")\n","                )\n","            except (json.JSONDecodeError, OSError):\n","                pass\n","\n","        return {\n","            \"important_facts\": [],\n","            \"past_decisions\": []\n","        }\n","\n","    def save_memory(self):\n","\n","        temp = MEMORY_FILE.with_suffix(\".tmp\")\n","\n","        temp.write_text(\n","            json.dumps(self.memory, indent=4, ensure_ascii=False),\n","            encoding=\"utf-8\"\n","        )\n","\n","        os.replace(temp, MEMORY_FILE)\n","\n","    # --------------------------------------------------------\n","    # INTERNAL PREPARATION BEFORE SPEAKING\n","    # --------------------------------------------------------\n","\n","    def think_before_speaking(self, user_message):\n","\n","        message = user_message.strip()\n","\n","        # Prepare a concise reasoning summary\n","        preparation = {\n","            \"time\": datetime.now().isoformat(),\n","            \"input\": message,\n","            \"understanding\": self.understand(message),\n","            \"relevant_memory\": self.find_memory(message),\n","            \"safety_check\": self.safety_check(message),\n","            \"response_strategy\": self.select_strategy(message)\n","        }\n","\n","        # Store decision summary, not private chain-of-thought\n","        self.memory[\"past_decisions\"].append({\n","            \"time\": preparation[\"time\"],\n","            \"input\": message,\n","            \"strategy\": preparation[\"response_strategy\"]\n","        })\n","\n","        self.memory[\"past_decisions\"] = (\n","            self.memory[\"past_decisions\"][-100:]\n","        )\n","\n","        self.save_memory()\n","\n","        with open(MONOLOGUE_FILE, \"a\", encoding=\"utf-8\") as f:\n","            f.write(json.dumps(\n","                preparation,\n","                ensure_ascii=False\n","            ) + \"\\n\")\n","\n","        return preparation\n","\n","    # --------------------------------------------------------\n","    # UNDERSTANDING\n","    # --------------------------------------------------------\n","\n","    def understand(self, message):\n","\n","        lower = message.lower()\n","\n","        if any(word in lower for word in\n","               [\"create\", \"build\", \"develop\", \"code\"]):\n","            return \"The user is requesting creation or development.\"\n","\n","        if any(word in lower for word in\n","               [\"explain\", \"what\", \"why\", \"how\"]):\n","            return \"The user is requesting information or explanation.\"\n","\n","        if any(word in lower for word in\n","               [\"future\", \"dream\", \"universe\"]):\n","            return \"The user is exploring future or creative possibilities.\"\n","\n","        return \"The message requires contextual interpretation.\"\n","\n","    # --------------------------------------------------------\n","    # MEMORY SEARCH\n","    # --------------------------------------------------------\n","\n","    def find_memory(self, message):\n","\n","        words = set(message.lower().split())\n","\n","        relevant = []\n","\n","        for fact in self.memory[\"important_facts\"]:\n","\n","            fact_text = fact.get(\"text\", \"\").lower()\n","\n","            if any(word in fact_text for word in words):\n","                relevant.append(fact)\n","\n","        return relevant[-5:]\n","\n","    # --------------------------------------------------------\n","    # BASIC SAFETY CHECK\n","    # --------------------------------------------------------\n","\n","    def safety_check(self, message):\n","\n","        lower = message.lower()\n","\n","        sensitive_actions = [\n","            \"delete all files\",\n","            \"steal password\",\n","            \"damage computer\",\n","            \"harm someone\"\n","        ]\n","\n","        for action in sensitive_actions:\n","            if action in lower:\n","                return \"REVIEW_REQUIRED\"\n","\n","        return \"NO_BASIC_KEYWORD_WARNING\"\n","\n","    # --------------------------------------------------------\n","    # RESPONSE STRATEGY\n","    # --------------------------------------------------------\n","\n","    def select_strategy(self, message):\n","\n","        lower = message.lower()\n","\n","        if \"code\" in lower or \"python\" in lower:\n","            return \"Prepare tested, understandable code.\"\n","\n","        if \"explain\" in lower or \"why\" in lower:\n","            return \"Prepare a clear explanation.\"\n","\n","        if \"future\" in lower:\n","            return \"Explore possibilities and evaluate risks.\"\n","\n","        return \"Prepare a relevant, truthful response.\"\n","\n","    # --------------------------------------------------------\n","    # ADD A VERIFIED MEMORY\n","    # --------------------------------------------------------\n","\n","    def remember(self, fact):\n","\n","        if fact.strip():\n","            self.memory[\"important_facts\"].append({\n","                \"text\": fact.strip(),\n","                \"time\": datetime.now().isoformat()\n","            })\n","\n","            self.memory[\"important_facts\"] = (\n","                self.memory[\"important_facts\"][-200:]\n","            )\n","\n","            self.save_memory()\n","\n","\n","# ------------------------------------------------------------\n","# VENOMOUS RESPONSE ENGINE\n","# ------------------------------------------------------------\n","\n","class Venomous:\n","\n","    def __init__(self):\n","        self.lia = LIABrain()\n","\n","    def speak(self, user_message):\n","\n","        # LIA prepares before Venomous responds\n","        preparation = self.lia.think_before_speaking(\n","            user_message\n","        )\n","\n","        print(\"\\n[LIA BRAIN]\")\n","        print(\"Understanding:\", preparation[\"understanding\"])\n","        print(\"Strategy:\", preparation[\"response_strategy\"])\n","        print(\"Safety:\", preparation[\"safety_check\"])\n","\n","        print(\"\\n[VENOMOUS RESPONSE]\")\n","        if preparation[\"safety_check\"] == \"REVIEW_REQUIRED\":\n","            return \"I need to review this request for safety.\"\n","\n","        return (\n","            \"I have processed your request. \"\n","            \"I am ready to respond using the selected strategy: \"\n","            + preparation[\"response_strategy\"]\n","        )\n","\n","\n","# ------------------------------------------------------------\n","# START SYSTEM\n","# ------------------------------------------------------------\n","\n","ai = Venomous()\n","\n","while True:\n","\n","    user_input = input(\"\\nYou: \").strip()\n","\n","    if user_input.lower() in [\"exit\", \"quit\", \"stop\"]:\n","        print(\"Venomoussaversai stopped.\")\n","        break\n","\n","    if not user_input:\n","        continue\n","\n","    answer = ai.speak(user_input)\n","\n","    print(\"\\nVenomous:\", answer)\n"],"metadata":{"id":"1yCCtcTnKkKZ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","!pip install -q nbformat\n"],"metadata":{"id":"tUC2kYT3LNkS"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# VENOMOUSSAI NOTEBOOK EXTRACTOR\n","# Extract .ipynb code into .py files\n","# Automatic progress updates every 2 seconds\n","# ============================================================\n","\n","import os\n","import re\n","import json\n","import time\n","import hashlib\n","from pathlib import Path\n","from datetime import datetime\n","\n","import nbformat\n","from google.colab import drive\n","\n","drive.mount(\"/content/drive\")\n","\n","# ------------------------------------------------------------\n","# CONFIGURATION\n","# ------------------------------------------------------------\n","\n","SOURCE_DIR = Path(\"/content/drive/MyDrive/Vssl\")\n","\n","OUTPUT_DIR = Path(\n","    \"/content/drive/MyDrive/Vssl_Python_Collection\"\n",")\n","\n","OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n","\n","CHECKPOINT = OUTPUT_DIR / \"checkpoint.json\"\n","MANIFEST = OUTPUT_DIR / \"python_file_list.json\"\n","\n","BATCH_LINES = 56\n","UPDATE_INTERVAL = 2\n","\n","# ------------------------------------------------------------\n","# CHECKPOINT SYSTEM\n","# ------------------------------------------------------------\n","\n","def load_checkpoint():\n","\n","    if CHECKPOINT.exists():\n","        try:\n","            return json.loads(\n","                CHECKPOINT.read_text(encoding=\"utf-8\")\n","            )\n","        except Exception:\n","            pass\n","\n","    return {\"notebooks\": {}}\n","\n","\n","progress = load_checkpoint()\n","\n","\n","def save_checkpoint():\n","\n","    temp = CHECKPOINT.with_suffix(\".tmp\")\n","\n","    temp.write_text(\n","        json.dumps(progress, indent=4),\n","        encoding=\"utf-8\"\n","    )\n","\n","    os.replace(temp, CHECKPOINT)\n","\n","\n","def make_id(path):\n","\n","    return hashlib.sha256(\n","        str(path).encode(\"utf-8\")\n","    ).hexdigest()[:12]\n","\n","\n","def safe_name(name):\n","\n","    name = re.sub(r\"[^A-Za-z0-9_-]+\", \"_\", name)\n","    return name.strip(\"_\") or \"notebook\"\n","\n","\n","# ------------------------------------------------------------\n","# NOTEBOOK EXTRACTION\n","# ------------------------------------------------------------\n","\n","def extract_code(notebook_path):\n","\n","    notebook = nbformat.read(\n","        str(notebook_path),\n","        as_version=4\n","    )\n","\n","    code_lines = []\n","\n","    for cell_number, cell in enumerate(notebook.cells):\n","\n","        if cell.cell_type != \"code\":\n","            continue\n","\n","        source = cell.source.splitlines()\n","\n","        code_lines.append(\n","            f\"\\n# ===== Notebook code cell {cell_number + 1} =====\"\n","        )\n","\n","        for line in source:\n","\n","            stripped = line.lstrip()\n","\n","            # Convert Colab/IPython commands into comments\n","            if stripped.startswith((\"!\", \"%\")):\n","                code_lines.append(\n","                    \"# IPython command: \" + line\n","                )\n","            else:\n","                code_lines.append(line)\n","\n","        code_lines.append(\"\")\n","\n","    return code_lines\n","\n","\n","# ------------------------------------------------------------\n","# SPLIT CODE INTO PYTHON FILES\n","# ------------------------------------------------------------\n","\n","def create_python_files(notebook_path):\n","\n","    relative = notebook_path.relative_to(SOURCE_DIR)\n","    notebook_id = make_id(relative)\n","\n","    # Detect source changes\n","    stat = notebook_path.stat()\n","    signature = f\"{stat.st_size}_{stat.st_mtime_ns}\"\n","\n","    state = progress[\"notebooks\"].get(notebook_id, {})\n","\n","    if state.get(\"signature\") != signature:\n","        state = {\n","            \"signature\": signature,\n","            \"completed_batches\": 0,\n","            \"completed\": False\n","        }\n","\n","    if state.get(\"completed\"):\n","        return 0\n","\n","    lines = extract_code(notebook_path)\n","\n","    total_batches = max(\n","        1,\n","        (len(lines) + BATCH_LINES - 1) // BATCH_LINES\n","    )\n","\n","    notebook_folder = (\n","        OUTPUT_DIR /\n","        safe_name(notebook_path.stem) +\n","        Path(\"_\")\n","    )\n","\n","    # Use unique folder to avoid filename collisions\n","    notebook_folder = OUTPUT_DIR / (\n","        safe_name(notebook_path.stem) + \"_\" + notebook_id\n","    )\n","\n","    notebook_folder.mkdir(parents=True, exist_ok=True)\n","\n","    created = 0\n","\n","    start_batch = state.get(\"completed_batches\", 0)\n","\n","    for batch_index in range(start_batch, total_batches):\n","\n","        start = batch_index * BATCH_LINES\n","        end = start + BATCH_LINES\n","\n","        batch = lines[start:end]\n","\n","        filename = (\n","            f\"{safe_name(notebook_path.stem)}\"\n","            f\"_part_{batch_index + 1:04d}.py\"\n","        )\n","\n","        output_file = notebook_folder / filename\n","\n","        content = (\n","            \"# Extracted by Venomoussaversai\\n\"\n","            f\"# Source notebook: {relative}\\n\"\n","            f\"# Part: {batch_index + 1}/{total_batches}\\n\\n\"\n","            + \"\\n\".join(batch)\n","            + \"\\n\"\n","        )\n","\n","        # Write safely through a temporary file\n","        temp_file = output_file.with_suffix(\".tmp\")\n","\n","        temp_file.write_text(\n","            content,\n","            encoding=\"utf-8\"\n","        )\n","\n","        os.replace(temp_file, output_file)\n","\n","        created += 1\n","\n","        # Save progress after every batch\n","        state[\"signature\"] = signature\n","        state[\"completed_batches\"] = batch_index + 1\n","        state[\"completed\"] = (\n","            batch_index + 1 == total_batches\n","        )\n","\n","        progress[\"notebooks\"][notebook_id] = state\n","        save_checkpoint()\n","\n","    return created\n","\n","\n","# ------------------------------------------------------------\n","# AUTOMATIC NOTEBOOK SCANNER\n","# ------------------------------------------------------------\n","\n","def find_notebooks():\n","\n","    notebooks = []\n","\n","    for folder, dirs, files in os.walk(SOURCE_DIR):\n","\n","        dirs[:] = [\n","            d for d in dirs\n","            if not d.startswith(\".\")\n","            and d != \"Vssl_Python_Collection\"\n","        ]\n","\n","        for filename in files:\n","\n","            if filename.endswith(\".ipynb\"):\n","                notebooks.append(\n","                    Path(folder) / filename\n","                )\n","\n","    return sorted(notebooks)\n","\n","\n","# ------------------------------------------------------------\n","# BUILD PYTHON FILE LIST\n","# ------------------------------------------------------------\n","\n","def create_manifest():\n","\n","    python_files = []\n","\n","    for path in OUTPUT_DIR.rglob(\"*.py\"):\n","\n","        python_files.append({\n","            \"filename\": path.name,\n","            \"path\": str(path),\n","            \"size_bytes\": path.stat().st_size\n","        })\n","\n","    data = {\n","        \"created_at\": datetime.now().isoformat(),\n","        \"total_python_files\": len(python_files),\n","        \"files\": python_files\n","    }\n","\n","    temp = MANIFEST.with_suffix(\".tmp\")\n","\n","    temp.write_text(\n","        json.dumps(data, indent=4),\n","        encoding=\"utf-8\"\n","    )\n","\n","    os.replace(temp, MANIFEST)\n","\n","    return len(python_files)\n","\n","\n","# ------------------------------------------------------------\n","# MAIN AUTOMATIC PROCESS\n","# ------------------------------------------------------------\n","\n","def run_extractor():\n","\n","    last_update = time.monotonic()\n","\n","    total_created = 0\n","    total_errors = 0\n","\n","    notebooks = find_notebooks()\n","\n","    print(\"NOTEBOOKS FOUND:\", len(notebooks))\n","\n","    for index, notebook in enumerate(notebooks, 1):\n","\n","        try:\n","\n","            created = create_python_files(notebook)\n","            total_created += created\n","\n","            print(\n","                f\"[{index}/{len(notebooks)}] \"\n","                f\"{notebook.name} | \"\n","                f\"New Python files: {created}\"\n","            )\n","\n","        except Exception as error:\n","\n","            total_errors += 1\n","\n","            print(\n","                \"ERROR:\",\n","                notebook.name,\n","                str(error)\n","            )\n","\n","        # Update progress at 2-second intervals\n","        if time.monotonic() - last_update >= UPDATE_INTERVAL:\n","\n","            file_count = create_manifest()\n","\n","            print(\n","                \"\\nAUTO-SAVE:\",\n","                datetime.now().strftime(\"%H:%M:%S\"),\n","                \"| Python files:\",\n","                file_count,\n","                \"| Errors:\",\n","                total_errors\n","            )\n","\n","            last_update = time.monotonic()\n","\n","    # Final save\n","    save_checkpoint()\n","    file_count = create_manifest()\n","\n","    print(\"\\n================================\")\n","    print(\"VENOMOUS EXTRACTION COMPLETED\")\n","    print(\"================================\")\n","    print(\"Notebooks found:\", len(notebooks))\n","    print(\"New Python files:\", total_created)\n","    print(\"Total Python files:\", file_count)\n","    print(\"Errors:\", total_errors)\n","    print(\"Output:\", OUTPUT_DIR)\n","    print(\"File list:\", MANIFEST)\n","\n","\n","run_extractor()\n"],"metadata":{"id":"11CFg2i1LQjc"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","!pip install -q torch transformers tokenizers\n"],"metadata":{"id":"Mg6cCpcHMcMm"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# VENOMOUSSAI — AUTOMATIC DATA TRAINING ENGINE\n","# Creator: Ananthu Sajeev\n","# Project: VSSL / SAI003\n","# ============================================================\n","\n","import os\n","import json\n","import time\n","import torch\n","import random\n","from pathlib import Path\n","from torch import nn\n","from torch.utils.data import Dataset, DataLoader\n","from transformers import AutoTokenizer\n","\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","# ------------------------------------------------------------\n","# CONFIGURATION\n","# ------------------------------------------------------------\n","\n","DATA_DIR = Path(\n","    \"/content/drive/MyDrive/Vssl_Python_Collection\"\n",")\n","\n","SAVE_DIR = Path(\n","    \"/content/drive/MyDrive/Vssl/Venomous_Training\"\n",")\n","\n","SAVE_DIR.mkdir(parents=True, exist_ok=True)\n","\n","MODEL_PATH = SAVE_DIR / \"venomous_model.pt\"\n","DATASET_PATH = SAVE_DIR / \"training_data.json\"\n","\n","BASE_MODEL = \"google-bert/bert-base-uncased\"\n","\n","DEVICE = torch.device(\n","    \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",")\n","\n","MAX_LENGTH = 128\n","BATCH_SIZE = 8\n","EPOCHS = 3\n","LEARNING_RATE = 0.0001\n","\n","print(\"Training device:\", DEVICE)\n","\n","# ------------------------------------------------------------\n","# STEP 1: COLLECT TRAINING TEXT\n","# ------------------------------------------------------------\n","\n","def collect_data():\n","\n","    documents = []\n","\n","    extensions = {\n","        \".py\", \".txt\", \".md\", \".json\"\n","    }\n","\n","    for path in DATA_DIR.rglob(\"*\"):\n","\n","        if not path.is_file():\n","            continue\n","\n","        if path.suffix.lower() not in extensions:\n","            continue\n","\n","        try:\n","\n","            text = path.read_text(\n","                encoding=\"utf-8\",\n","                errors=\"ignore\"\n","            )\n","\n","            if len(text.strip()) > 30:\n","\n","                documents.append({\n","                    \"filename\": path.name,\n","                    \"text\": text\n","                })\n","\n","                print(\"Collected:\", path.name)\n","\n","        except Exception as error:\n","            print(\"Skipped:\", path.name, error)\n","\n","    return documents\n","\n","\n","documents = collect_data()\n","\n","if not documents:\n","    raise ValueError(\"No training documents found.\")\n","\n","# ------------------------------------------------------------\n","# STEP 2: SAVE DATASET\n","# ------------------------------------------------------------\n","\n","with open(DATASET_PATH, \"w\", encoding=\"utf-8\") as file:\n","    json.dump(\n","        documents,\n","        file,\n","        indent=2,\n","        ensure_ascii=False\n","    )\n","\n","print(\"Total training documents:\", len(documents))\n","\n","# ------------------------------------------------------------\n","# STEP 3: LOAD TOKENIZER\n","# ------------------------------------------------------------\n","\n","tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL)\n","\n","if tokenizer.pad_token is None:\n","    tokenizer.pad_token = tokenizer.unk_token\n","\n","# ------------------------------------------------------------\n","# STEP 4: CREATE LANGUAGE MODEL DATASET\n","# ------------------------------------------------------------\n","\n","class VenomousDataset(Dataset):\n","\n","    def __init__(self, documents):\n","\n","        self.samples = []\n","\n","        for document in documents:\n","\n","            text = document[\"text\"]\n","\n","            encoded = tokenizer(\n","                text,\n","                truncation=True,\n","                max_length=MAX_LENGTH,\n","                padding=\"max_length\",\n","                return_tensors=\"pt\"\n","            )\n","\n","            self.samples.append(\n","                encoded[\"input_ids\"].squeeze(0)\n","            )\n","\n","    def __len__(self):\n","        return len(self.samples)\n","\n","    def __getitem__(self, index):\n","\n","        tokens = self.samples[index]\n","\n","        # Next-token prediction\n","        return tokens[:-1], tokens[1:]\n","\n","\n","dataset = VenomousDataset(documents)\n","\n","loader = DataLoader(\n","    dataset,\n","    batch_size=BATCH_SIZE,\n","    shuffle=True\n",")\n","\n","# ------------------------------------------------------------\n","# STEP 5: BUILD NEURAL NETWORK\n","# ------------------------------------------------------------\n","\n","class VenomousLanguageNetwork(nn.Module):\n","\n","    def __init__(self, vocab_size, embedding_dim=128):\n","\n","        super().__init__()\n","\n","        self.embedding = nn.Embedding(\n","            vocab_size,\n","            embedding_dim\n","        )\n","\n","        self.network = nn.GRU(\n","            embedding_dim,\n","            256,\n","            batch_first=True\n","        )\n","\n","        self.output = nn.Linear(\n","            256,\n","            vocab_size\n","        )\n","\n","    def forward(self, tokens):\n","\n","        x = self.embedding(tokens)\n","\n","        x, _ = self.network(x)\n","\n","        return self.output(x)\n","\n","\n","model = VenomousLanguageNetwork(\n","    vocab_size=len(tokenizer)\n",").to(DEVICE)\n","\n","# ------------------------------------------------------------\n","# STEP 6: TRAINING\n","# ------------------------------------------------------------\n","\n","optimizer = torch.optim.AdamW(\n","    model.parameters(),\n","    lr=LEARNING_RATE\n",")\n","\n","criterion = nn.CrossEntropyLoss(\n","    ignore_index=tokenizer.pad_token_id\n",")\n","\n","print(\"\\nVENOMOUS TRAINING STARTED\")\n","\n","for epoch in range(EPOCHS):\n","\n","    model.train()\n","\n","    total_loss = 0\n","\n","    for batch_index, (inputs, targets) in enumerate(loader):\n","\n","        inputs = inputs.to(DEVICE)\n","        targets = targets.to(DEVICE)\n","\n","        optimizer.zero_grad()\n","\n","        predictions = model(inputs)\n","\n","        loss = criterion(\n","            predictions.reshape(-1, predictions.size(-1)),\n","            targets.reshape(-1)\n","        )\n","\n","        loss.backward()\n","\n","        torch.nn.utils.clip_grad_norm_(\n","            model.parameters(), 1.0\n","        )\n","\n","        optimizer.step()\n","\n","        total_loss += loss.item()\n","\n","        if batch_index % 10 == 0:\n","            print(\n","                f\"Epoch {epoch + 1}/{EPOCHS} | \"\n","                f\"Batch {batch_index + 1} | \"\n","                f\"Loss: {loss.item():.4f}\"\n","            )\
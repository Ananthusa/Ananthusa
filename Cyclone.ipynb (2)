\"how\", \"what\", \"wonder\", \"curious\"\n","            ],\n","            \"hope\": [\n","                \"dream\", \"future\", \"hope\", \"goal\", \"believe\"\n","            ]\n","        }\n","\n","        self.intentions = {\n","            \"learning\": [\"learn\", \"understand\", \"explain\"],\n","            \"creating\": [\"create\", \"build\", \"develop\", \"make\"],\n","            \"protection\": [\"protect\", \"safe\", \"security\"],\n","            \"communication\": [\"talk\", \"speak\", \"communicate\"],\n","            \"planning\": [\"future\", \"plan\", \"goal\", \"improve\"]\n","        }\n","\n","    def analyse(self, message):\n","\n","        text = message.lower()\n","\n","        emotion_scores = {}\n","        for emotion, keywords in self.emotions.items():\n","            score = sum(\n","                len(re.findall(r\"\\b\" + re.escape(word) + r\"\\b\", text))\n","                for word in keywords\n","            )\n","            emotion_scores[emotion] = score\n","\n","        intention_scores = {}\n","        for intention, keywords in self.intentions.items():\n","            intention_scores[intention] = sum(\n","                1 for word in keywords\n","                if re.search(r\"\\b\" + re.escape(word) + r\"\\b\", text)\n","            )\n","\n","        detected_emotion = max(\n","            emotion_scores,\n","            key=emotion_scores.get\n","        )\n","\n","        if emotion_scores[detected_emotion] == 0:\n","            detected_emotion = \"uncertain\"\n","\n","        detected_intention = max(\n","            intention_scores,\n","            key=intention_scores.get\n","        )\n","\n","        if intention_scores[detected_intention] == 0:\n","            detected_intention = \"uncertain\"\n","\n","        return {\n","            \"message\": message,\n","            \"possible_emotion\": detected_emotion,\n","            \"possible_intention\": detected_intention,\n","            \"emotion_scores\": emotion_scores,\n","            \"intention_scores\": intention_scores,\n","            \"confidence\": \"keyword heuristic; not a validated probability\",\n","            \"timestamp\": datetime.now().isoformat()\n","        }\n","\n","    def remember(self, result):\n","\n","        with MEMORY.open(\"a\", encoding=\"utf-8\") as file:\n","            file.write(json.dumps(result) + \"\\n\")\n","\n","    def respond(self, result):\n","\n","        emotion = result[\"possible_emotion\"]\n","        intention = result[\"possible_intention\"]\n","\n","        return (\n","            f\"LIA: I noticed possible {emotion} in your words. \"\n","            f\"You may be interested in {intention}. \"\n","            \"Have I understood you correctly?\"\n","        )\n","\n","\n","class VenomousMindSystem:\n","\n","    def __init__(self):\n","        self.lia = HumanMindInterpreter()\n","\n","    def process_human_message(self, message):\n","\n","        result = self.lia.analyse(message)\n","        self.lia.remember(result)\n","\n","        print(\"\\n--- VENOUSSAVERSAI ANALYSIS ---\")\n","        print(\"Possible emotion:\", result[\"possible_emotion\"])\n","        print(\"Possible intention:\", result[\"possible_intention\"])\n","        print(\"LIA:\", self.lia.respond(result))\n","\n","        return result\n","\n","\n","if __name__ == \"__main__\":\n","\n","    system = VenomousMindSystem()\n","\n","    print(\"VENOMOUS SAVERSAI HUMAN INTERPRETER\")\n","    print(\"Type exit to stop.\\n\")\n","\n","    while True:\n","        human_message = input(\"Human: \")\n","\n","        if human_message.lower() == \"exit\":\n","            break\n","\n","        system.process_human_message(human_message)\n"],"metadata":{"id":"QYUCoumEK4RP"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ============================================================\n","# VENOMOUS SAVERSAI — LIA EMOTION INTELLIGENCE ENGINE\n","# Project: VSSL / SAI003\n","# Purpose: Understand expressed human emotions\n","# ============================================================\n","\n","import json\n","import re\n","from pathlib import Path\n","from datetime import datetime\n","from collections import Counter\n","\n","PROJECT = Path(\"/content/drive/MyDrive/Vssl\")\n","MEMORY = PROJECT / \"LIA\" / \"emotion_memory.jsonl\"\n","\n","MEMORY.parent.mkdir(parents=True, exist_ok=True)\n","\n","\n","class LIAEmotionEngine:\n","\n","    def __init__(self):\n","\n","        self.emotions = {\n","            \"happiness\": [\n","                \"happy\", \"joy\", \"excited\", \"wonderful\",\n","                \"amazing\", \"glad\", \"cheerful\"\n","            ],\n","            \"sadness\": [\n","                \"sad\", \"lonely\", \"cry\", \"disappointed\",\n","                \"unhappy\", \"heartbroken\"\n","            ],\n","            \"anger\": [\n","                \"angry\", \"furious\", \"annoyed\",\n","                \"irritated\", \"hate\"\n","            ],\n","            \"fear\": [\n","                \"afraid\", \"scared\", \"fear\",\n","                \"terrified\", \"worried\"\n","            ],\n","            \"love\": [\n","                \"love\", \"care\", \"affection\",\n","                \"kindness\", \"dear\"\n","            ],\n","            \"hope\": [\n","                \"hope\", \"dream\", \"future\",\n","                \"believe\", \"inspire\"\n","            ],\n","            \"curiosity\": [\n","                \"curious\", \"wonder\", \"why\",\n","                \"how\", \"discover\"\n","            ],\n","            \"confusion\": [\n","                \"confused\", \"uncertain\",\n","                \"don't understand\", \"lost\"\n","            ],\n","            \"stress\": [\n","                \"stress\", \"pressure\", \"overwhelmed\",\n","                \"exhausted\", \"tired\"\n","            ],\n","            \"calmness\": [\n","                \"calm\", \"peaceful\", \"relaxed\",\n",